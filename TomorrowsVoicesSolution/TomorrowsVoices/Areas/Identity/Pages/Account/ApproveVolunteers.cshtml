@page
@model ApproveVolunteersModel
@{
    ViewData["Title"] = "Manage Volunteers";
}


@if (TempData["Rejected"] != null)
{
    <div class="alert alert-success">
        This User has been rejected
    </div>
}
@if (TempData["RejectedBulk"] != null)
{
    <div class="alert alert-success">
        The User(s) has been rejected
    </div>
}
@if (TempData["ApprovedBulk"] != null)
{
    <div class="alert alert-success">
        The User(s) has been approved
    </div>
}
<div class="d-flex align-items-center justify-content-between mb-2 g-2 mt-2">
    <div class="d-flex mt-0">
        <h1 class="mb-0">Manage Volunteers</h1>
    </div>
</div>
<p>Review and manage volunteer applications.</p>

<ul class="nav nav-tabs" id="volunteerTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">
            Pending <span class="badge bg-secondary">@Model.PendingVolunteers.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="approved-tab" data-bs-toggle="tab" data-bs-target="#approved" type="button" role="tab">
            Approved <span class="badge bg-success">@Model.ApprovedVolunteers.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="rejected-tab" data-bs-toggle="tab" data-bs-target="#rejected" type="button" role="tab">
            Rejected <span class="badge bg-danger">@Model.RejectedVolunteers.Count</span>
        </button>
    </li>
</ul>

<div class="tab-content" id="volunteerTabsContent">
    <!-- Pending Volunteers Tab -->
    <div class="tab-pane fade show active" id="pending" role="tabpanel" aria-labelledby="pending-tab">
        <form method="post" id="bulkActionForm">
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="selectAll">
                        <label class="form-check-label" for="selectAll">
                            Select All
                        </label>
                    </div>
                    <div>
                        <button type="submit" asp-page-handler="ApproveSelected" class="btn btn-success btn-sm me-2">
                            <i class="bi bi-check-circle"></i> Approve Selected
                        </button>
                        <button type="submit" asp-page-handler="RejectSelected" class="btn btn-danger btn-sm">
                            <i class="bi bi-x-circle"></i> Reject Selected
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th style="width: 40px;"></th>
                                    <th>Name</th>
                                    <th>Email</th>
                                
                       
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.PendingVolunteers.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" class="form-check-input volunteer-checkbox"
                                                   name="SelectedVolunteers" value="@Model.PendingVolunteers[i].ID" />
                                        </td>
                                        <td>@Model.PendingVolunteers[i].FullName</td>
                                        <td>@Model.PendingVolunteers[i].Email</td>
                                 
                                
                                    </tr>
                                }
                                @if (Model.PendingVolunteers.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center">No pending volunteers</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- Approved Volunteers Tab -->
    <div class="tab-pane fade" id="approved" role="tabpanel" aria-labelledby="approved-tab">
        <form method="post">
        <div class="card mt-3">
            <div class="card-header">
                <h5 class="mb-0">Approved Volunteers</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                             
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var volunteer in Model.ApprovedVolunteers)
                            {
                                <tr>
                                    <td>@volunteer.FullName</td>
                                    <td>@volunteer.Email</td>
                              
                                    <td>
                                        <button type="submit" asp-page-handler="RevokeApproval"
                                                asp-route-volunteerId="@volunteer.ID"
                                                class="btn btn-warning btn-sm">
                                            <i class="bi bi-arrow-counterclockwise"></i> Revoke
                                        </button>
                                    </td>
                                </tr>
                            }
                            @if (Model.ApprovedVolunteers.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center">No approved volunteers</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        </form>
    </div>

    <!-- Rejected Volunteers Tab -->
    <div class="tab-pane fade" id="rejected" role="tabpanel" aria-labelledby="rejected-tab">
        <form method="post">
            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0">Rejected Volunteers</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var volunteer in Model.RejectedVolunteers)
                                {
                                    <tr>
                                        <td>@volunteer.FullName</td>
                                        <td>@volunteer.Email</td>
                                        <td>
                                            <button type="submit" asp-page-handler="Reconsider"
                                                    asp-route-volunteerId="@volunteer.ID"
                                                    class="btn btn-primary btn-sm">
                                                <i class="bi bi-arrow-repeat"></i> Reconsider
                                            </button>
                                        </td>
                                    </tr>
                                }
                                @if (Model.RejectedVolunteers.Count == 0)
                                {
                                    <tr>
                                        <td colspan="3" class="text-center">No rejected volunteers</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Select all checkbox functionality
        document.getElementById('selectAll').addEventListener('change', function(e) {
            const checkboxes = document.querySelectorAll('.volunteer-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = e.target.checked;
            });
        });

        // Ensure at least one volunteer is selected for bulk actions
        document.getElementById('bulkActionForm').addEventListener('submit', function(e) {
            const checkedBoxes = document.querySelectorAll('.volunteer-checkbox:checked');
            if (checkedBoxes.length === 0) {
                e.preventDefault();
                alert('Please select at least one volunteer to perform this action.');
            }
        });

        // Initialize Bootstrap tabs
        var tabEl = document.querySelector('button[data-bs-toggle="tab"]');
        if (tabEl) {
            tabEl.addEventListener('shown.bs.tab', function (event) {
                event.target // newly activated tab
                event.relatedTarget // previous active tab
            });
        }
    </script>
}

@if (TempData["ApprovedSuccess"] != null)
{
    <div class="alert alert-success">
        This user has been approved
    </div>
}

