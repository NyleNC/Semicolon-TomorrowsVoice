@page
@{
    ViewData["Title"] = "Logged Out";
}

<style>
    /* Reuse all your existing login page styles */
    .background-animation {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        overflow: hidden;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    }

    .floating-element {
        position: absolute;
        opacity: 0.15;
        animation: float 20s infinite linear;
        filter: blur(1px);
    }

        .floating-element.choir {
            background-color: #6D28E3;
            border-radius: 50%;
        }

        .floating-element.event {
            background-color: #1D4ED8;
            border-radius: 10px;
        }

        .floating-element.volunteer {
            background-color: #B45309;
            border-radius: 5px;
        }

    @@keyframes float {
        0% {
            transform: translate(0, 0) rotate(0deg);
        }

        25% {
            transform: translate(50px, 50px) rotate(90deg);
        }

        50% {
            transform: translate(0, 100px) rotate(180deg);
        }

        75% {
            transform: translate(-50px, 50px) rotate(270deg);
        }

        100% {
            transform: translate(0, 0) rotate(360deg);
        }
    }

    .card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.15);
        border-radius: 15px;
    }

    .card-body {
        padding: 2rem;
    }

    .btn-primary {
        background: rgba(109, 40, 227, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        color: white;
    }

        .btn-primary:hover {
            background: rgba(109, 40, 227, 0.9);
            color: white;
        }
</style>

<div class="background-animation">
    <!-- Choir elements -->
    <div class="floating-element choir" style="width: 80px; height: 80px; left: 20%; top: 30%; animation-delay: 0s;"></div>
    <div class="floating-element choir" style="width: 60px; height: 60px; left: 70%; top: 50%; animation-delay: -10s;"></div>

    <!-- Event elements -->
    <div class="floating-element event" style="width: 120px; height: 60px; left: 10%; top: 60%; animation-delay: -2s;"></div>
    <div class="floating-element event" style="width: 90px; height: 45px; left: 60%; top: 20%; animation-delay: -7s;"></div>
    <div class="floating-element event" style="width: 100px; height: 50px; left: 40%; top: 70%; animation-delay: -12s;"></div>

    <!-- Volunteer elements -->
    <div class="floating-element volunteer" style="width: 70px; height: 35px; left: 30%; top: 10%; animation-delay: -3s;"></div>
    <div class="floating-element volunteer" style="width: 50px; height: 25px; left: 80%; top: 40%; animation-delay: -8s;"></div>
    <div class="floating-element volunteer" style="width: 60px; height: 30px; left: 50%; top: 80%; animation-delay: -15s;"></div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm mt-5">
                <div class="card-body text-center">
                    <h1 class="card-title mb-4">Logged Out</h1>

                    <div class="mb-4">
                        <i class="fas fa-sign-out-alt text-primary" style="font-size: 3.5rem;"></i>
                    </div>

                    <p class="mb-4">You have been successfully logged out.</p>

                    <div class="d-flex justify-content-center mb-3">
                        <a asp-area="Identity" asp-page="/Account/Login" class="w-75 btn btn-primary">Log In Again</a>
                    </div>

                   
                </div>
            </div>
        </div>
    </div>
</div>