@page
@model RegisterDirectorConfirmationModel
@{
    ViewData["Title"] = "Director Registration Confirmation";
}

<h1>@ViewData["Title"]</h1>
@{
    if (@Model.DisplayConfirmAccountLink)
    {
        <p>Director account has been created
            <a id="confirm-link" href="@Model.EmailConfirmationUrl">Click here to confirm your account</a>
        </p>
    }
    else
    {
        <p>
            Please check your email to confirm your account.
        </p>
    }
}


<a asp-page="./RegisterDirector" class="btn btn-primary">Register Another Director</a>