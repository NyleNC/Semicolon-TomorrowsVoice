@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
    <!-- User Menu Dropdown -->
    <div class="dropdown user-menu">
        @if (SignInManager.IsSignedIn(User))
        {
            <!-- Display user info and dropdown when signed in -->
            <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle"></i>
                <span class="d-none d-sm-inline mx-1">Hello @User.Identity?.Name!</span>
            </a>
            <form id="logout-form" method="post" asp-area="Identity" asp-page="/Account/Logout" asp-page-handler="Logout"></form>
            <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="dropdownUser1">

                <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Profile</a></li>
                <li><hr class="dropdown-divider"></li>
                <form id="logout-form" method="post" asp-area="Identity" asp-page="/Account/Logout" asp-page-handler="Logout">
                    <button type="submit" class="dropdown-item">Logout</button>
                </form>
                @if (User.IsInRole("Admin"))
                {
                    <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/RegisterDirector"><span class="ms-1">Register a Director?</span></a></li>
                }
            </ul>

        }
        else
        {
            <!-- Display login and register options when not signed in -->
            <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle"></i>
                <span class="d-none d-sm-inline mx-1">Account</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="dropdownUser1">
                <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Register"><span class="ms-1">Register</span></a></li>
                <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Login"><span class="ms-1">Login</span></a></li>
            </ul>
        }
    </div>
    }
</ul>
