@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TomorrowsVoices</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/TomorrowsVoices.styles.css" asp-append-version="true" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css" rel="stylesheet">
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.1/css/bootstrap-select.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.1/js/bootstrap-select.min.js"></script>
    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <!-- Font Family Reference -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <!-- Links for Pop Up Modal-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    @*    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> *@

    <!--FullCalendar scripts for Calendar-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@5.10.1/main.min.css" />
    @*     <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.10.1/main.min.js"></script> *@

    <!-- Animate.css library -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />


    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://unpkg.com/boxicons@2.1.4/dist/boxicons.js"></script>
    @*     select 2 *@
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    @functions {
        string IsActive(string controller, string action)
        {
            var routeData = ViewContext.RouteData;
            var routeController = routeData.Values["controller"]?.ToString();
            var routeAction = routeData.Values["action"]?.ToString();

            return (routeController == controller && routeAction == action) ? "active" : "";
        }
        string IsSubMenuActive(params string[] controllers)
        {
            var routeData = ViewContext.RouteData;
            var routeController = routeData.Values["controller"]?.ToString();

            return controllers.Contains(routeController) ? "show" : "";
        }
    }
</head>
<body>

    <div class="container-fluid p-0">

        <!-- Horizontal Navbar -->
        <nav class="navbar navbar-expand-lg px-3">

            <div class="container-fluid px-3 m-0 d-flex justify-content-between align-items-center">

                <!-- Tomorrow's Voices Logo -->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/Images/TV-Logo.png" alt="Tomorrow's Voices Logo" class="header-logo">
                </a>

                <!-- Mobile Menu Button (Floated to the Right) -->
                <button class="toggle-btn" id="btnMobile" data-bs-toggle="modal" data-bs-target="#menuModal"
                        style="filter: invert(1) brightness(2); margin-top: 12px;">
                    <i class="bi bi-grid"></i>
                </button>
                <partial name="_LoginPartial" />
            </div>

        </nav>


        <div class="modal fade" id="menuModal" tabindex="-1" aria-labelledby="menuModalLabel" aria-hidden="true">

            <div class="modal-dialog modal-dialog-nav modal-sm ms-auto me-0">

                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="menuModalLabel">Navigation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body modal-body-nav">
                        <h6 class="fw-bold">Choir Administration</h6>
                        <a class="nav-link" asp-controller="Director" asp-action="Index">Director</a>
                        <a class="nav-link" asp-controller="Singer" asp-action="Index">Singer</a>
                        <a class="nav-link" asp-controller="Session" asp-action="Index">Session</a>
                        <hr>
                        <h6 class="fw-bold">Volunteer Management</h6>
                        <a class="nav-link" asp-controller="VolLocation" asp-action="Index">Location</a>
                        <a class="nav-link" asp-controller="Volunteer" asp-action="Index">Volunteer</a>
                        <a class="nav-link" asp-controller="Event" asp-action="Index">Event</a>
                        <a class="nav-link" asp-controller="Schedule" asp-action="Index">Schedule</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="row flex-nowrap">
             @if (User.Identity.IsAuthenticated)
             {
                <!-- Sidebar -->
                <div id="desktopSidebar" class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 sidebar text-black" style="border-right: 3px solid #f3f3f3; background-color: #f9f9f9">
                    <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-2 text-white min-vh-100">
                        <!-- Menu -->

                        <button class="toggle-btn" id="btn">
                            <i class="bi bi-grid"></i>
                        </button>

                        <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start" id="menu">
                            @if (User.IsInRole("Admin"))
                            {
                                <li>
                                    <a class="nav-link px-0 text-black @(IsActive("UserRole","Index"))" asp-controller="UserRole" asp-action="Index">
                                        <img src="~/Images/icons8-raise-a-hand-to-answer-48.png" alt="attendance icon" width="20px" class="ms-3"> <span class="ms-1">User Management</span>
                                    </a>

                                </li>
                            }
                            @if (User.IsInRole("Admin") || User.IsInRole("Director"))
                            {
                                <li>
                                    <a href="#submenu1" data-bs-toggle="collapse" class="nav-link px-0 align-middle" style="background-color: #e0e0e0;" aria-expanded="@(IsSubMenuActive("Director", "Singer", "Session") == "show" ? "true" : "false")">
                                        <img src="~/Images/NewChoirIcon.png" class="ms-2" alt="choir icon" width="40px"> <span class="ms-1 me-1 d-none d-sm-inline" style="color:  #1d2e79">Choir Administration</span>
                                        <i class="bi bi-chevron-down ms-1 me-2"></i>
                                    </a>
                                    <ul class="collapse nav flex-column ms-1 @(IsSubMenuActive("Director", "Singer", "Session"))" id="submenu1">

                                        <li class="w-100">
                                            <a class="nav-link px-0 text-black @(IsActive("Director","Index")) sub-menu-item" asp-controller="Director" asp-action="Index">
                                                <img src="~/Images/icons8-administrator-male-48.png" alt="director icon" width="20px" class="ms-3"> <span class="ms-1">Director</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="nav-link px-0 text-black @(IsActive("Singer","Index")) sub-menu-item" asp-controller="Singer" asp-action="Index">
                                                <img src="~/Images/icons8-group-48 (1).png" alt="singer icon" width="20px" class="ms-3"> <span class="ms-1">Singer</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="nav-link px-0 text-black @(IsActive("Session","Index")) sub-menu-item" asp-controller="Session" asp-action="Index">
                                                <img src="~/Images/icons8-raise-a-hand-to-answer-48.png" alt="attendance icon" width="20px" class="ms-3"> <span class="ms-1">Session</span>
                                            </a>
                                        </li>

                                    </ul>

                                </li>
                            }
                            @if (User.IsInRole("Admin") || User.IsInRole("Volunteer"))
                            {
                                <li>
                                    <a href="#submenu2" data-bs-toggle="collapse" class="nav-link px-0 align-middle" style="background-color: #e0e0e0;" aria-expanded="@(IsSubMenuActive("VolLocation", "Volunteer", "Event","Schedule") == "show" ? "true" : "false")">
                                        <img src="~/Images/NewVolunteerIcon.png" class="ms-2" alt="volunteer icon" width="40px">
                                        <span class="ms-1 d-none d-sm-inline" style=" color: #1d2e79">Volunteer Management</span>
                                        <i class="bi bi-chevron-down ms-1 me-2"></i>
                                    </a>
                                    <ul class="collapse nav flex-column ms-1 @(IsSubMenuActive("VolLocation", "Volunteer", "Event","Schedule"))" id="submenu2">
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <li class="w-100">
                                                <a class="nav-link px-0 text-black @(IsActive("VolLocation","Index")) sub-menu-item" asp-controller="VolLocation" asp-action="Index">
                                                    <img src="~/Images/icons8-location-48.png" alt="location icon" width="20px" class="ms-3"> <span class="ms-1">Location</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="nav-link px-0 text-black @(IsActive("Event","Index")) sub-menu-item" asp-controller="Event" asp-action="Index">
                                                    <img src="~/Images/icons8-event-48.png" alt="event icon" width="20px" class="ms-3"> <span class="ms-1">Event</span>
                                                </a>
                                            </li>
                                        }
                                        @if( User.IsInRole("Admin") || (User.IsInRole("Volunteer")))
                                        {
                                            <li>
                                                <a class="nav-link px-0 text-black @(IsActive("Volunteer","Index")) sub-menu-item" asp-controller="Volunteer" asp-action="Index">
                                                    <img src="~/Images/icons8-group-48 (1).png" alt="volunteer icon" width="20px" class="ms-3"> <span class="ms-1">Volunteer</span>
                                                </a>
                                            </li>
                                        }
                                    
                                    </ul>
                                </li>
                            }
                            </ul>
                  
                    <hr>
             

                </div>
            
            </div>
            }

            <!-- Main Content -->
            <div class="col pt-2 pb-3">
                <div class="container" style="display: block;">
                    <main role="main" class="pb-3">
                        @RenderBody()
                    </main>
                 
                </div>
            </div>
        </div>
    </div>

    <!-- Your existing scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>    
        document.addEventListener('DOMContentLoaded', function () {

            // Get current path
            let currentPath = window.location.pathname.toLowerCase();

            // Find matching link and add 'active-page' class
            document.querySelectorAll(".nav-link").forEach(link => {
                let linkPath = link.getAttribute("href")?.toLowerCase();
                if (linkPath && currentPath.includes(linkPath)) {
                    link.classList.add("active-page");
                }
            });
            const sidebar = document.querySelector('.sidebar');
            const toggleBtn = document.getElementById('btn');

            // Toggle sidebar collapse and hide/show text
            toggleBtn.addEventListener('click', function () {
                sidebar.classList.toggle('collapsed');

                // Toggle text visibility
                const spans = sidebar.querySelectorAll('.nav-link span');
                spans.forEach(span => {
                    span.style.display = sidebar.classList.contains('collapsed') ? 'none' : 'inline';
                });
            });

            // Track submenu state changes for arrow rotation
            const submenus = document.querySelectorAll('[data-bs-toggle="collapse"]');
            submenus.forEach(menu => {
                menu.addEventListener('click', function() {
                    // Update aria-expanded attribute after a short delay to catch the toggle
                    setTimeout(() => {
                        const isExpanded = this.getAttribute('aria-expanded') === 'true';
                        this.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
                    }, 50);
                });
            });
        });
    </script> 
</body>
</html>