<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TomorrowsVoices</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/TomorrowsVoices.styles.css" asp-append-version="true" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css" rel="stylesheet">
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.1/css/bootstrap-select.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.1/js/bootstrap-select.min.js"></script>
    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <!-- Font Family Reference -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    @functions {
        string IsActive(string controller, string action)
        {
            var routeData = ViewContext.RouteData;
            var routeController = routeData.Values["controller"]?.ToString();
            var routeAction = routeData.Values["action"]?.ToString();

            return (routeController == controller && routeAction == action) ? "active" : "";
        }
    }
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
 

</head>
<body>
    <header>
        @* added navigation buttons in a dropdown  *@
        <nav class="navbar navbar-expand-lg bg-dark navbar-toggleable-sm navbar-light bg-black border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><img src="~/images/tv-logo.png" alt="Tomorrow's Voices Logo" class="header-logo"></a>
                <button class="navbar-toggler" style="background-color:white; border-color: white" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon "></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav bg-black flex-grow-1">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Management Menu
                            </a>
                            <ul class="dropdown-menu text-white" aria-labelledby="navbarDropdown">
                                <li class="nav-item"><a class="dropdown-item text-white @(IsActive("Director","Index"))" asp-controller="Director" asp-action="Index">Director</a></li>
                                <li class="nav-item"><a class="dropdown-item text-white @(IsActive("Singer","Index"))" asp-controller="Singer" asp-action="Index">Singer</a></li>
                                
                                <div class="dropdown-divider"></div>
                                <li class="nav-item"><a class="dropdown-item text-white @(IsActive("Session","Index"))" asp-controller="Session" asp-action="Index">Attendance</a></li>
                            </ul>
                        </li>
                      
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white " href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                               Volunteer Menu
                            </a>
                            <ul class="dropdown-menu text-white" aria-labelledby="navbarDropdown">
                                <li class="nav-item"><a class="dropdown-item text-white @(IsActive("VolLocation","Index"))" asp-controller="VolLocation" asp-action="Index">Volunteer Location</a></li>
                                <li class="nav-item"><a class="dropdown-item text-white @(IsActive("Volunteer","Index"))" asp-controller="Volunteer" asp-action="Index">Volunteer Management</a></li>
                                <li class="nav-item"><a class="dropdown-item text-white @(IsActive("Event","Index"))" asp-controller="Event" asp-action="Index">Event Management</a></li>
                            </ul>
                        </li>
                    </ul>

                </div>
            </div>
        </nav>
    </header>
    <div class="container" style="display: block;">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top  text-muted bg-black" style="position: absolute; bottom: 0px; width: 100%; display: block">
        <div class="container py-3">
            <div class="row align-items-center">
                <!-- Logo Section -->
                <div class="col-12 col-md-3 text-center text-md-start mb-md-0" style="margin-bottom: 12px">
                    <img src="~/images/tv-logo.png" alt="Tomorrow's Voices Logo" class="footer-logo">
                </div>

                <!-- Navigation Links -->
                <div class="col-12 col-md-6 d-flex flex-wrap justify-content-center text-center" style="margin-bottom: 12px">
                    <a class="text-white mx-2 text-decoration-none" asp-area="" asp-controller="Director" asp-action="Index">Directors</a>
                    <a class="text-white mx-2 text-decoration-none" asp-area="" asp-controller="Singer" asp-action="Index">Singers</a>
                    <a class="text-white mx-2 text-decoration-none" asp-area="" asp-controller="Session" asp-action="Index">Attendance</a>
                    <a class="text-white mx-2 text-decoration-none" asp-area="" asp-controller="VolLocation" asp-action="Index">Volunteer Location</a>
                    <a class="text-white mx-2 text-decoration-none" asp-area="" asp-controller="Volunteer" asp-action="Index">Volunteers</a>
                </div>

                <!-- Optional Extra Section -->
                <div class="col-12 col-md-3 text-center text-md-end mt-md-0">
                    <small class="text-white">© 2025 Tomorrow's Voices</small>
                </div>
            </div>
        </div>
    </footer>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
