<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TomorrowsVoices</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TomorrowsVoices.styles.css" asp-append-version="true" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css" rel="stylesheet">
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.1/css/bootstrap-select.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.1/js/bootstrap-select.min.js"></script>
    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <!-- Font Family Reference -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <!-- Links for Pop Up Modal-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
 @*    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> *@

    <!--FullCalendar scripts for Calendar-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@5.10.1/main.min.css" />
@*     <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.10.1/main.min.js"></script> *@


    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://unpkg.com/boxicons@2.1.4/dist/boxicons.js"></script>
    @functions {
        string IsActive(string controller, string action)
        {
            var routeData = ViewContext.RouteData;
            var routeController = routeData.Values["controller"]?.ToString();
            var routeAction = routeData.Values["action"]?.ToString();

            return (routeController == controller && routeAction == action) ? "active" : "";
        }
        string IsSubMenuActive(params string[] controllers)
        {
            var routeData = ViewContext.RouteData;
            var routeController = routeData.Values["controller"]?.ToString();

            return controllers.Contains(routeController) ? "show" : "";
        }
    }
</head>
<body>
    <div class="container-fluid p-0">
        <!-- Horizontal Navbar -->
        <nav class="navbar navbar-expand-lg px-3">
            <div class="container-fluid px-3 m-0">
                <!-- Tomorrow's Voices Logo -->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/Images/TV-Logo.png" alt="Tomorrow's Voices Logo" class="header-logo">
                </a>

                <!-- Optional: Add other navbar items here -->
            </div>
        </nav>

        <div class="row flex-nowrap">
            <!-- Sidebar -->

            <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 sidebar text-black" style="border-right: 3px solid #f3f3f3; background-color: #f9f9f9">

                <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-2 text-white min-vh-100"> 
                    <!-- Menu -->          
                    <button class="toggle-btn" id="btn">
                        <i class="bi bi-grid"></i>
                    </button>
                    <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start" id="menu">
                        <li>
                            <a href="#submenu1" data-bs-toggle="collapse" class="nav-link px-0 align-middle" >
                                <img src="~/Images/choirmainicon.png" alt="choir icon" width="30px"> <span class="ms-1 d-none d-sm-inline" style="color:  #6d27e7">Choir Administration</span>
                            </a>
                            <ul class="collapse nav flex-column ms-1 @(IsSubMenuActive("Director", "Singer", "Session"))" id="submenu1">
                                <li class="w-100">
                                    <a class="nav-link px-0 text-black @(IsActive("Director","Index"))" asp-controller="Director" asp-action="Index">
                                        <img src="~/Images/icons8-administrator-male-48.png" alt="director icon" width="30px"> <span class="ms-1">Director</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="nav-link px-0 text-black @(IsActive("Singer","Index")) " asp-controller="Singer" asp-action="Index">
                                        <img src="~/Images/icons8-group-48 (1).png" alt="singer icon" width="30px"> <span class="ms-1">Singer</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="nav-link px-0 text-black @(IsActive("Session","Index"))" asp-controller="Session" asp-action="Index">
                                        <img src="~/Images/icons8-raise-a-hand-to-answer-48.png" alt="attendance icon" width="30px"> <span class="ms-1">Attendance</span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li>
                            <a href="#submenu2" data-bs-toggle="collapse" class="nav-link px-0 align-middle">
                                <img src="~/Images/volunteerIcon.png" alt="volunteer icon" width="30px">  <span class="ms-1 d-none d-sm-inline" style=" color: #6d27e7">Volunteer Management</span>
                            </a>
                            <ul class="collapse nav flex-column ms-1 @(IsSubMenuActive("VolLocation", "Volunteer", "Event"))" id="submenu2">
                                <li class="w-100">
                                    <a class="nav-link px-0 text-black @(IsActive("VolLocation","Index"))" asp-controller="VolLocation" asp-action="Index">
                                        <img src="~/Images/icons8-location-48.png" alt="location icon" width="30px"> <span class="ms-1">Location</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="nav-link px-0 text-black @(IsActive("Volunteer","Index"))" asp-controller="Volunteer" asp-action="Index">
                                        <img src="~/Images/icons8-group-48 (1).png" alt="volunteer icon" width="30px"> <span class="ms-1">Volunteer</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="nav-link px-0 text-black @(IsActive("Event","Index"))" asp-controller="Event" asp-action="Index">
                                        <img src="~/Images/icons8-event-48.png" alt="event icon" width="30px"> <span class="ms-1">Event</span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                    <hr>
                    <!-- Optional: User Menu -->
                    <!-- <div class="dropdown pb-4 user-menu">
                        <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i>
                            <span class="d-none d-sm-inline mx-1">User</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="dropdownUser1">
                            <li><a class="dropdown-item" href="#">Settings</a></li>
                            <li><a class="dropdown-item" href="#">Profile</a></li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li><a class="dropdown-item" href="#">Sign out</a></li>
                        </ul>
                    </div> -->
                </div>
            
            </div>

            <!-- Main Content -->
            <div class="col pt-2 pb-3">
                <div class="container" style="display: block;">
                    <main role="main" class="pb-3">
                        @RenderBody()
                    </main>
                 
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.querySelector('.sidebar');
            const toggleBtn = document.getElementById('btn');

            // Toggle sidebar collapse and hide/show text
            toggleBtn.addEventListener('click', function () {
                sidebar.classList.toggle('collapsed');

                // Toggle text visibility
                const spans = sidebar.querySelectorAll('.nav-link span');
                spans.forEach(span => {
                    span.style.display = sidebar.classList.contains('collapsed') ? 'none' : 'inline';
                });
            });
        });
    </script>
</body>
</html>