@model TomorrowsVoices.Models.Schedule

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Schedule</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Volunteer)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Volunteer.FullName)
        </dd>
        <dt class="col-sm-2">
            Shift Schedule Start
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ShiftStart)
        </dd>
        <dt class="col-sm-2">
            Shift Schedule End
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ShiftEnd)
        </dd>
        <dt class = "col-sm-2">
          Actual Start
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ActualStartTime)
        </dd>
        <dt class = "col-sm-2">
            Actual End
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ActualEndTime)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Event)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Event.Name)
        </dd>
       
     
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.ID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
