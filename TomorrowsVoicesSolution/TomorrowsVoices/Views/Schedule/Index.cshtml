@model TomorrowsVoices.ViewModels.ScheduleViewModel


@{
    ViewData["Title"] = "Volunteer Schedule";
}

<h2>Volunteer Schedule Attendance</h2>



<!-- Create Button -->
<div class="container mb-3">
    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#createScheduleModal">
        Create New Schedule
    </button>
</div>

<div class="nav-container mb-3">
    <!-- Tabs -->
    <ul class="nav nav-tabs" id="scheduleTabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" id="morning-tab" data-toggle="tab" href="#morning" role="tab" aria-controls="morning" aria-selected="true">Morning Shift</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="afternoon-tab" data-toggle="tab" href="#afternoon" role="tab" aria-controls="afternoon" aria-selected="false">Afternoon Shift</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="evening-tab" data-toggle="tab" href="#evening" role="tab" aria-controls="evening" aria-selected="false">Evening Shift</a>
        </li>
    </ul>
</div>


<!-- Tab Content -->


        <div class="tab-content" id="scheduleTabsContent">
            <!-- Morning Shift Tab -->
            <div class="tab-pane fade show active" id="morning" role="tabpanel" aria-labelledby="morning-tab">
                <table class="table">

                    <thead>
                        <tr>
                    @foreach (var schedule in Model.MorningShifts.GroupBy(s => new
                    {
                     
                        StartTime = s.ShiftStart,
                        EndTime = s.ShiftEnd
                    }))
                            {
                                <th>
                                
                                    @schedule.Key.StartTime.ToString("hh\\:mm") - @schedule.Key.EndTime.ToString("hh\\:mm")
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            @foreach (var schedule in Model.MorningShifts.GroupBy(s => new
                            {
                               
                                StartTime = s.ShiftStart,
                                EndTime = s.ShiftEnd
                            }))
                            {
                                <td>
                                    @foreach (var volunteer in schedule)
                                    {
                                        <div>@volunteer.Volunteer?.FullName</div>
                                    }
                                </td>
                        <td>
                            @foreach (var volunteer in schedule)
                            {
                                <div>
                                    <a asp-action="Edit" asp-controller="Schedule" asp-route-id="@volunteer.ID" class="btn btn-primary btn-sm">Edit</a>
                                    <a asp-action="Details" asp-controller="Schedule" asp-route-id="@volunteer.ID" class="btn btn-info btn-sm">Details</a>
                                </div>
                            }
                        </td>

                            }

                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Afternoon Shift Tab -->
            <div class="tab-pane fade" id="afternoon" role="tabpanel" aria-labelledby="afternoon-tab">
                <table class="table">
                    <thead>
                        <tr>
                            @foreach (var schedule in Model.AfternoonShifts.GroupBy(s => new
                            {
                               
                                StartTime = s.ShiftStart,
                                EndTime = s.ShiftEnd
                            }))
                            {
                                <th>
                                   
                                    @schedule.Key.StartTime.ToString("hh\\:mm") - @schedule.Key.EndTime.ToString("hh\\:mm")
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            @foreach (var schedule in Model.AfternoonShifts.GroupBy(s => new
                            {

                        StartTime = s.ShiftStart,
                        EndTime = s.ShiftEnd
                            }))
                            {
                                <td>
                                    @foreach (var volunteer in schedule)
                                    {
                                        <div>@volunteer.Volunteer?.FullName</div>
                                    }
                                </td>
                    

                        <td>
                            @foreach (var volunteer in schedule)
                            {
                                <div>
                                    <a asp-action="Edit" asp-controller="Schedule" asp-route-id="@volunteer.ID" class="btn btn-primary btn-sm">Edit</a>
                                    <a asp-action="Details" asp-controller="Schedule" asp-route-id="@volunteer.ID" class="btn btn-info btn-sm">Details</a>
                                </div>
                            }

                        </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Evening Shift Tab -->
            <div class="tab-pane fade" id="evening" role="tabpanel" aria-labelledby="evening-tab">
                <table class="table">
                    <thead>
                        <tr>
                            @foreach (var schedule in Model.EveningShifts.GroupBy(s => new
                            {

                        StartTime = s.ShiftStart,
                        EndTime = s.ShiftEnd
                            }))
                            {
                                <th>
                                 
                                    @schedule.Key.StartTime.ToString("hh\\:mm") - @schedule.Key.EndTime.ToString("hh\\:mm")
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            @foreach (var schedule in Model.EveningShifts.GroupBy(s => new
                            {

                        StartTime = s.ShiftStart,
                        EndTime = s.ShiftEnd
                            }))
                            {
                                <td>
                                    @foreach (var volunteer in schedule)
                                    {
                                        <div>@volunteer.Volunteer?.FullName</div>
                                    }
                                </td>
                        <td>
                            @foreach (var volunteer in schedule)
                            {
                                <div>
                                    <a asp-action="Edit" asp-controller="Schedule" asp-route-id="@volunteer.ID" class="btn btn-primary btn-sm">Edit</a>
                                    <a asp-action="Details" asp-controller="Schedule" asp-route-id="@volunteer.ID" class="btn btn-info btn-sm">Details</a>
                                </div>
                            }
                        </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
       


<!-- Create Schedule Modal -->
<div class="modal fade" id="createScheduleModal" tabindex="-1" role="dialog" aria-labelledby="createScheduleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createScheduleModalLabel">Create New Schedules</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Form for Creating Multiple Schedules -->
                <form asp-action="CreateMultiple" method="post" id="createScheduleForm">
                    <div id="scheduleRows">
                        <!-- Initial Schedule Row -->
                        <div class="schedule-row border p-3 mb-3">
                            <div class="form-group">
                                <label>Shift Start</label>
                                <input type="time" class="form-control" name="Schedules[0].ShiftStart" required>
                            </div>
                            <div class="form-group">
                                <label>Shift End</label>
                                <input type="time" class="form-control" name="Schedules[0].ShiftEnd" required>
                            </div>
                            <div class="form-group">
                                <label>Event</label>
                                <select class="form-control" name="Schedules[0].eventID" required>
                                    <option value="">Select an Event</option>
                                    @foreach (var eventItem in ViewBag.Events)
                                    {
                                        <option value="@eventItem.ID">@eventItem.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Volunteer</label>
                                <select class="form-control" name="Schedules[0].volunteerID" required>
                                    <option value="">Select a Volunteer</option>
                                    @foreach (var volunteer in ViewBag.Volunteers)
                                    {
                                        <option value="@volunteer.ID">@volunteer.FullName</option>
                                    }
                                </select>
                            </div>
                            <button type="button" class="btn btn-danger btn-sm remove-schedule">Remove</button>
                        </div>
                    </div>
                    <button type="button" id="addSchedule" class="btn btn-secondary btn-sm">Add Another Schedule</button>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="submit" form="createScheduleForm" class="btn btn-primary">Create Schedules</button>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap and jQuery -->
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

@section Scripts {
    <script>
        $(document).ready(function () {
            let rowCount = 1; // Start from 1 because the first row is already present

            // Add a new schedule row
            $('#addSchedule').on('click', function () {
                const newRow = `
                    <div class="schedule-row border p-3 mb-3">
                        <div class="form-group">
                            <label>Shift Start</label>
                            <input type="datetime-local" class="form-control" name="Schedules[${rowCount}].ShiftStart" required>
                        </div>
                        <div class="form-group">
                            <label>Shift End</label>
                            <input type="datetime-local" class="form-control" name="Schedules[${rowCount}].ShiftEnd" required>
                        </div>
                        <div class="form-group">
                            <label>Event</label>
                            <select class="form-control" name="Schedules[${rowCount}].eventID" required>
                                <option value="">Select an Event</option>
        @foreach (var eventItem in ViewBag.Events)
        {
                                        <option value="@eventItem.ID">@eventItem.Name</option>
        }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Volunteer</label>
                            <select class="form-control" name="Schedules[${rowCount}].volunteerID" required>
                                <option value="">Select a Volunteer</option>
        @foreach (var volunteer in ViewBag.Volunteers)
        {
                                        <option value="@volunteer.ID">@volunteer.FullName</option>
        }
                            </select>
                        </div>
                        <button type="button" class="btn btn-danger btn-sm remove-schedule">Remove</button>
                    </div>
                `;
                $('#scheduleRows').append(newRow);
                rowCount++;
            });

            // Remove a schedule row
            $(document).on('click', '.remove-schedule', function () {
                $(this).closest('.schedule-row').remove();
                rowCount--; // Decrement row count
            });

            // Submit the form via AJAX
            $('#createScheduleForm').on('submit', function (e) {
                e.preventDefault(); // Prevent the default form submission

                $.ajax({
                    url: '@Url.Action("CreateMultiple", "Schedule")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            $('#createScheduleModal').modal('hide'); // Close the modal
                            location.reload(); // Refresh the page to show the new schedules
                        } else {
                            alert('Error: ' + response.message); // Show error message
                        }
                    },
                    error: function (xhr, status, error) {
                        // Log the full error response
                        console.log(xhr.responseText);
                        alert('An error occurred: ' + xhr.responseText);
                    }
                });
            });
        });
    </script>
}