@{
    ViewData["Title"] = "Calendar View";
    bool isArchived = ViewData["IsArchived"] as bool? ?? false;
}

<div class="d-flex align-items-center justify-content-between mb-2 g-2 mt-2">
    <!-- Sessions Heading -->
    <div class="d-flex mt-0">

        <h1 class="mb-0">Sessions</h1>

    </div>
    <div>
        <a href="@Url.Action("AttendanceReportExport", "Session")" class="btn btn-white me-2"><img src="~/Images/dark-export-icon.png" alt="export-icon" style="height: 24px; width: auto; margin-right: 10px" />Export</a>
        <a asp-action="Create" class="btn btn-primary float-end"><img src="~/Images/create-icon.png" alt="add-attendance-icon" style="height: 24px; width: auto; margin-right: 8px" />Add New</a>
    </div>
</div>
<p>View your Session Attendance records.</p>
@* Container for all tabs *@
<div class="nav-container mb-3">
    <a class="nav-tab @(ViewData["ActiveTab"]?.ToString() == "active" ? "active" : "")"
       asp-action="Index" asp-route-archived="false">
        Active
        @if (ViewData["numberofActive"] != null && (int)ViewData["numberofActive"] == 0)
        {
            <span class="nav-tab-count  @(ViewData["ActiveTab"]?.ToString() == "active" ? "active" : "")">0</span>
        }
        else
        {
            <span class="nav-tab-count  @(ViewData["ActiveTab"]?.ToString() == "active" ? "active" : "")">@ViewData["numberofActive"]</span>
        }
    </a>
    <a class="nav-tab @(ViewData["ActiveTab"]?.ToString() == "archived" ? "active" : "")"
       asp-action="Index" asp-route-archived="true">
        Archive
        @if (ViewData["numberofArchive"] != null && (int)ViewData["numberofArchive"] == 0)
        {
            <span class="nav-tab-count  @(ViewData["ActiveTab"]?.ToString() == "archived" ? "active" : "")">0</span>
        }
        else
        {
            <span class="nav-tab-count  @(ViewData["ActiveTab"]?.ToString() == "archived" ? "active" : "")">@ViewData["numberofArchive"]</span>
        }
    </a>
</div>

<div class="d-flex align-items-center justify-content-end mb-2 g-2 mt-2">
    <!-- Date Picker and Button -->
    <div class="mb-3 me-2">
        <input type="date" id="datePicker" class="form-control" style="width: auto; display: inline-block;">
        <button id="goToDateButton" class="btn btn-primary">Go to Date</button>
    </div>
    <!-- Table View Button -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-primary"><img src="~/Images/table-view.png" alt="table-view-icon" style="height: 24px; width: auto; margin-right: 10px;" />Table View</a>
    </div>
</div>

<!-- FullCalendar Container -->
<div id="calendar"></div>

<!-- Session Details Modal -->
<div class="modal fade" id="sessionDetailsModal" tabindex="-1" aria-labelledby="sessionDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="sessionDetailsModalLabel">Session Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p><strong>Date:</strong> <span id="sessionDate"></span></p>
                <p><strong>Notes:</strong> <span id="sessionNotes"></span></p>
                <p><strong>Location:</strong> <span id="sessionLocation"></span></p>
                <p><strong>Is Archived:</strong> <span id="sessionIsArchived"></span></p>
            </div>
            <div class="modal-footer">
                <!-- Go to Details Button -->
                <a id="goToDetailsButton" class="btn btn-primary" href="#">Go to Details</a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Include FullCalendar CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@5.10.1/main.min.css" />

<!-- Include FullCalendar JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.10.1/main.min.js"></script>

<!-- Calendar Initialization Script -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('calendar');
        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            events: '/Session/GetCalendarSessions', // Update the endpoint to fetch sessions
            dateClick: function (info) {
                alert('Date clicked: ' + info.dateStr);
            },
            eventClick: function (info) {
                // Fetch session details from the server
                fetch(`/Session/GetSessionDetails/${info.event.id}`)
                    .then(response => response.json())
                    .then(data => {
                        // Populate the modal with session details
                        document.getElementById('sessionDate').textContent = data.date;
                        document.getElementById('sessionNotes').textContent = data.notes;
                        document.getElementById('sessionLocation').textContent = data.location;
                        document.getElementById('sessionIsArchived').textContent = data.isArchived ? 'Yes' : 'No';

                        // Set the URL for the "Go to Details" button
                        var detailsUrl = `/Session/Details/${info.event.id}`; // Update the URL to match your routing
                        document.getElementById('goToDetailsButton').setAttribute('href', detailsUrl);

                        // Show the modal
                        var modal = new bootstrap.Modal(document.getElementById('sessionDetailsModal'));
                        modal.show();
                    })
                    .catch(error => {
                        console.error('Error fetching session details:', error);
                        alert('An error occurred while fetching session details.');
                    });
            }
        });
        calendar.render();

        // Add event listener to the "Go to Date" button
        document.getElementById('goToDateButton').addEventListener('click', function () {
            var dateStr = document.getElementById('datePicker').value;
            if (dateStr) {
                var date = new Date(dateStr + 'T00:00:00'); // Ensure the date is parsed correctly
                calendar.gotoDate(date);
            } else {
                alert('Please select a date.');
            }
        });
    });
</script>