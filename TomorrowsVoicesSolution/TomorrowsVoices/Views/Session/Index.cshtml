@model IEnumerable<TomorrowsVoices.Models.Session>

@{
    ViewData["Title"] = "Index";
}

<h1>Sessions Attendance</h1>

<p>
    <a asp-action="Create" class="btn btn-primary"><img src="~/Images/add-attendance.png" alt="add-attendance-icon" style="height: 24px; width: auto; margin-right: 10px" />Create New Attendance</a>
   
</p>
<p>
    <a href="@Url.Action("AttendanceReportExport", "Session")" class="btn btn-success"><img src="~/Images/export-csv.png" alt="export-csv-icon" style="height: 24px; width: auto; margin-right: 10px" />Export to Excel</a>
</p>
<form asp-action="Index" method="get">
    <table class="table table-striped table-hover table-custom">
        <thead class="table-dark">
            <tr>
				<th>
                        <button style="font-weight: 700" type="button" name="actionButton" value="City" class="btn btn-toolbar text-white no-pointer-events">City</button>
				</th>
				<th>
                        <button style="font-weight: 700" type="button" name="actionButton" value="Date" class="btn btn-toolbar text-white no-pointer-events">Date</button>
                </th>
                <th>
                        <button style="font-weight: 700" type="button" name="actionButton" value="Attendance" class="btn btn-toolbar text-white no-pointer-events">Attendance</button>
                </th>
                <th>
                    <button style="font-weight: 700" type="button" name="actionButton" value="Director" class="btn btn-toolbar text-white no-pointer-events">Director</button>
                </th>
                <th>
                   <button style="font-weight: 700" type="button" name="actionButton" value="Actions" class="btn btn-toolbar text-white no-pointer-events">Actions</button>
                </th>
            </tr>
        </thead>
        <tbody style="overflow: visible">
            @foreach (var item in Model)
            {
                <tr>
					<td>
						@Html.DisplayFor(modelItem => item.Location.City)
					</td>
					<td>
                        @Html.DisplayFor(modelItem => item.Date)
                    </td>
                    <td>
                        @{
                            int presentSingers = item.Attendance.Count(a => a.Status);
                            int registeredSingers = item.Attendance.Count();
                        }
                        @presentSingers / @registeredSingers
                    </td>
                   
                    <td>
                        @Html.DisplayFor(modelItem => item.Location.Director.DirectorFullName)
                    </td>
                    <td>
                        <div class="d-none d-lg-inline">
                            <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning"><img src="~/Images/edit-value.png" alt="edit-icon" style="height: 24px; width: auto; margin-right: 10px" />Edit</a> |
                            <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info"><img src="~/Images/details.png" alt="details-icon" style="height: 24px; width: auto; margin-right: 10px" />Details</a> |
                            <a asp-action="Delete" asp-route-id="@item.ID" style="color:black ;background-color:#fb606f" class="btn btn-sm btn-danger"><img src="~/Images/archive.png" alt="archive-icon" style="height: 24px; width: auto; margin-right: 10px" />Delete</a>
                        </div>
                        <div class="d-lg-none">
                                <div class="btn-group">
                                <button class="btn btn-sm dropdown-toggle" style="background-color: #6423e7; color: white" data-bs-toggle="dropdown">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.ID">
                                                <img src="~/Images/edit-value.png" alt="edit-icon" style="height: 18px; width: auto; margin-right: 5px" /> Edit
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-action="Details" asp-route-id="@item.ID">
                                                <img src="~/Images/details.png" alt="details-icon" style="height: 18px; width: auto; margin-right: 5px" /> Details
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-action="Delete" asp-route-id="@item.ID">
                                                <img src="~/Images/archive.png" alt="archive-icon" style="height: 18px; width: auto; margin-right: 5px" /> Delete
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                        </div>

                    
                    
                    </td>
                </tr>

            }
        </tbody>
    </table>
    <partial name="_PagingNavBar" />

</form>

<script type="text/javascript">
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
    })
</script>