@model IEnumerable<TomorrowsVoices.Models.Session>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

@{
    ViewData["Title"] = "Index";
    bool isArchived = ViewData["IsArchived"] as bool? ?? false;
}

<div class="d-flex align-items-center justify-content-between mb-2 g-2 mt-2">
    <!-- Sessions Heading -->
    <div class="d-flex mt-0">

        <h1 class="mb-0">Sessions</h1>

    </div>
    <div> 
        <a href="@Url.Action("AttendanceReportExport", "Session")" class="btn btn-white me-2"><img src="~/Images/dark-export-icon.png" alt="export-icon" style="height: 24px; width: auto; margin-right: 10px" />Export</a>
        <a asp-action="Create" class="btn btn-primary float-end"><img src="~/Images/create-icon.png" alt="add-attendance-icon" style="height: 24px; width: auto; margin-right: 8px" />Add New</a>
    </div>
</div>
<p>View your Session Attendance records.</p>
@* Container for all tabs *@
<div class="nav-container mb-3">
    <a class="nav-tab @(ViewData["ActiveTab"]?.ToString() == "active" ? "active" : "")"
           asp-action="Index" asp-route-archived="false">Active
            @if (ViewData["numberofActive"] != null && (int)ViewData["numberofActive"] == 0)    
            {
            <span class="nav-tab-count  @(ViewData["ActiveTab"]?.ToString() == "active" ? "active" : "")">0</span>
            }
            else
            {
            <span class="nav-tab-count  @(ViewData["ActiveTab"]?.ToString() == "active" ? "active" : "")">@ViewData["numberofActive"]</span>
            }
        </a>
    <a class="nav-tab @(ViewData["ActiveTab"]?.ToString() == "archived" ? "active" : "")"
           asp-action="Index" asp-route-archived="true">
            Archive
            @if (ViewData["numberofArchive"] != null && (int)ViewData["numberofArchive"] == 0)
            {
            <span class="nav-tab-count  @(ViewData["ActiveTab"]?.ToString() == "archived" ? "active" : "")">0</span>
            }
            else
            {
            <span class="nav-tab-count  @(ViewData["ActiveTab"]?.ToString() == "archived" ? "active" : "")">@ViewData["numberofArchive"]</span>
            }
        </a>
</div>


<form asp-action="Index" method="get">
         <input type="hidden" name="sortDirection" value="@ViewData["sortDirection"]" />
        <input type="hidden" name="sortField" value="@ViewData["sortField"]" />
    <input type="hidden" name="archived" value="@(ViewData["ActiveTab"]?.ToString() == "archived" ? "true" : "false")" />
        <div class="row">
            <div class="col-12">
                <div class="float-end">
               
                <a asp-action="Calendar" class="btn btn-primary mb-3"><img src="~/Images/calendar-icon.png" alt="calendar-icon" style="height: 24px; width: auto; margin-right: 10px"/>Calendar View</a>
                <button class="btn btn-white mb-3 ms-1 @ViewData["Filtering"]" type="button" data-bs-toggle="collapse" id="filterToggle"
                        data-bs-target="#collapseFilter" aria-expanded="false" aria-controls="collapseFilter">
                    <img src="~/Images/dark-filter-icon.png" alt="filter-search-icon" style="height: 24px; width: auto; margin-right: 10px" />
                    Filter (@ViewData["numberFilters"])
                </button>
                <!-- Conditionally render the "Clear" button -->
                @if (ViewData["numberFilters"] != null && (int)ViewData["numberFilters"] > 0)
                {
                    <a asp-action="Index" class="mb-3 btn text-white" style="background-color: indianred; padding: 11px; border-radius: 10px">
                        <img src="~/Images/clear-icon.png" alt="Clear filters icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
                        Clear
                    </a>
                }
                </div>

            </div>
        </div>
        <div class="collapse mb-3 @ViewData["ShowFilter"]" id="collapseFilter">
            <div class="card card-body">
                <div class="container">
                    <div class="row">
                    <div class="col-lg-2 col-4">

                        <label class="control-label">Filter by City:</label>
                        @Html.DropDownList("SearchCity", (IEnumerable<SelectListItem>)ViewData["Cities"], new { @class = "form-control" })
                    </div>
                    <div class="col-lg-3 col-8">
                        <label class="control-label">Search Director Name:</label>
                        @Html.TextBox("SearchString", null, new { @class = "form-control" })
                    </div>

                    <div class="col-lg-2 col-6">
                        <label class="control-label">From Date:</label>
                        <input class="form-control" type="date" id="StartDate" name="StartDate"
                               value="@ViewData["StartDate"]" aria-describedby="EndDate" aria-invalid="false">
                    </div>
                    <div class="col-lg-2 col-6">
                        <label class="control-label">To Date:</label>
                        <input class="form-control" type="date" id="StartDate" name="EndDate"
                               value="@ViewData["EndDate"]" aria-describedby="EndDate" aria-invalid="false">
                    </div>



                    <div class="col-lg-3 col-12">
                        <label class="control-label">Present Singers</label>
                        <div class="d-flex align-items-center gap-1">
                            <label class="control-label d-inline-block">Min:</label>
                            <input class="form-control" style="width: 64px; padding-left: 10px; padding-right: 6px; " type="number" id="minPresentSinger" name="minPresentSinger"
                                   value="@ViewData["minPresentSinger"]" aria-describedby="minPresentSinger" aria-invalid="false">

                            <label class="control-label d-inline-block">Max:</label>
                            <input class="form-control" style="width: 64px; padding-left: 10px; padding-right: 6px; " type="number" id="maxPresentSinger" name="maxPresentSinger"
                                   value="@ViewData["maxPresentSinger"]" aria-describedby="maxPresentSinger" aria-invalid="false">
                        </div>

                    </div>
                    </div>
				    

               
              <div class="form-group col-md-2 align-self-start mt-3">
                    <input type="submit" name="actionButton" value="Filter"
                           class="btn text-white" style="background-color: #6423e7" />

                </div>
                </div>
                
            </div>
        </div>
    <div style="border: 3px solid #F1F1F1; border-radius: 12px; overflow: hidden; margin: 0; padding: 0">
        <table class="table table-custom p-0 m-0">
            <thead >
                <tr>
                    <th>
                        <button type="button" class="btn btn-toolbard-inline" onclick="handleSort(event, 'City')">
                            City
                            @if (ViewData["sortField"]?.ToString() == "City")
                            {
                                if (ViewData["sortDirection"]?.ToString() == "asc")
                                {
                                    <div style="position: relative; display: inline-block;">
                                        <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #ababab;"></i>
                                        <i class="fa-solid fa-sort-up fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                    </div>

                                }
                                else
                                {
                                    <div style="position: relative; display: inline-block;">
                                        <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #737373;"></i>
                                        <i class="fa-solid fa-sort-down fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                    </div>

                                }
                            }
                            else
                            {
                                <i class="fas fa-sort fa-sm d-inline" style="color: #ababab; margin-left: 2.7px"></i>
                            }
                        </button>
                    </th>
                    <th>
                        <button type="button" class="btn btn-toolbar d-inline" onclick="handleSort(event, 'Date')">
                            Date
                            @if (ViewData["sortField"]?.ToString() == "Date")
                            {
                                if (ViewData["sortDirection"]?.ToString() == "asc")
                                {
                                    <div style="position: relative; display: inline-block;">
                                        <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #ababab;"></i>
                                        <i class="fa-solid fa-sort-up fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                    </div>

                                }
                                else
                                {
                                    <div style="position: relative; display: inline-block;">
                                        <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #737373;"></i>
                                        <i class="fa-solid fa-sort-down fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                    </div>

                                }
                            }
                            else
                            {
                                <i class="fas fa-sort fa-sm d-inline" style="color: #ababab; margin-left: 2.7px"></i>
                            }
                        </button>
                    </th>
                    <th>
                        <button type="button" class="btn btn-toolbar d-inline" onclick="handleSort(event, 'Attendance')">
                            Attendance
                            @if (ViewData["sortField"]?.ToString() == "Attendance")
                            {
                                if (ViewData["sortDirection"]?.ToString() == "asc")
                                {
                                    <div style="position: relative; display: inline-block;">
                                        <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #ababab;"></i>
                                        <i class="fa-solid fa-sort-up fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                    </div>

                                }
                                else
                                {
                                    <div style="position: relative; display: inline-block;">
                                        <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #ababab;"></i>
                                        <i class="fa-solid fa-sort-down fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                    </div>

                                }
                            }
                            else
                            {
                                <i class="fas fa-sort fa-sm d-inline" style="color: #ababab; margin-left: 2.7px"></i>
                            }
                        </button>
                    </th>
                    <th>
                        <button type="button" class="btn btn-toolbar d-inline" onclick="handleSort(event, 'Director')">
                            Director
                            @if (ViewData["sortField"]?.ToString() == "Director")
                            {
                                if (ViewData["sortDirection"]?.ToString() == "asc")
                                {
                                    <div style="position: relative; display: inline-block;">
                                        <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #ababab;"></i>
                                        <i class="fa-solid fa-sort-up fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #333;"></i>
                                    </div>

                                }
                                else
                                {
                                    <div style="position: relative; display: inline-block;">
                                        <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color:#ababab;"></i>
                                        <i class="fa-solid fa-sort-down fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                    </div>

                                }
                            }
                            else
                            {
                                <i class="fas fa-sort fa-sm d-inline" style="color: #ababab; margin-left: 2.7px"></i>
                            }
                        </button>
                    </th>
                    <th>
                        <button style="cursor: default;" type="button" name="actionButton" value="Actions" class="btn btn-toolbar no-pointer-events">Actions</button>
                    </th>
                </tr>
            </thead>
</form>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Location.City)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Date)
                        </td>
                        <td>
                            @{
                                int presentSingers = item.Attendance.Count(a => a.Status);
                                int availableSingersInCity = ViewData["AvailableSingers_" + item.Location.ID] as int? ?? 0;
                            }
                            @presentSingers / @availableSingersInCity
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Location.Director.DirectorFullName)
                        </td>
                        <td>
                            <!-- Desktop View (Buttons) -->
                            <div class="d-none d-lg-inline">
                                @if (item.IsArchived)
                                {
                              
                                }
                                else
                                {
                                    <div class="d-inline-flex align-items-center m-0 p-0">

                                    <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning">
                                        <img src="~/Images/icons8-edit-48 (1).png" alt="edit-icon" style="height: 24px; width: auto; margin-right: 10px" />Edit 
                                    </a> 
                                    <div style="margin-left: 3px"> | </div>
                                    </div>
                                }

                                <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info">
                                    <img src="~/Images/icons8-document-48.png" alt="details-icon" style="height: 24px; width: auto; margin-right: 10px" />Details
                                </a> |
                                <div class="btn-group">
                                    @if (!item.IsArchived)
                                    {
                                        <form asp-action="Archive" method="post" onsubmit="return confirm('Are you sure you want to archive this item?');" class="d-inline">
                                            <input type="hidden" name="id" value="@item.ID" />
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <img src="~/Images/icons8-box-48.png" alt="Archive-icon" style="height: 24px; width: auto; margin-right: 10px;" />
                                                Archive
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                            <form asp-action="Unarchive" method="post" onsubmit="return confirm('Are you sure you want to restore this item?');" class="d-inline">
                                <input type="hidden" name="id" value="@item.ID" />
                                <button type="submit" class="btn btn-sm btn-restore">
                                    <img src="~/Images/unarchive-value.png" alt="Unarchive-icon" style="height: 24px; width: auto; margin-right: 10px;" />
                                    Restore
                                </button>
                            </form>
                                    }
                                </div>
                            </div>

                            <!-- Mobile View (Dropdown) -->
                            <div class="d-lg-none">
                                <div class="btn-group">
                                    <button class="btn btn-sm dropdown-toggle" style="background-color: #6423e7; color: white" data-bs-toggle="dropdown">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.ID" style=" color: white">
                                                <img src="~/Images/edit-value.png" alt="edit-icon" style="height: 18px; width: auto; margin-right: 5px" /> Edit
                                            </a>
                                        </li>
                                        
                                        <li>
                                            <a class="dropdown-item" asp-action="Details" asp-route-id="@item.ID" style=" color: white">
                                                <img src="~/Images/details.png" alt="details-icon" style="height: 18px; width: auto; margin-right: 5px" /> Details
                                            </a>
                                        </li>
                                        <li>
                                            @if (!item.IsArchived)
                                            {
                                                <form asp-action="Archive" method="post" onsubmit="return confirm('Are you sure you want to archive this item?');">
                                                    <input type="hidden" name="id" value="@item.ID" />
                                                    <button type="submit" class="dropdown-item" style=" color: white">
                                                        <img src="~/Images/Archive.png" alt="Archive-icon" style="height: 18px; width: auto; margin-right: 5px" /> Archive
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Unarchive" method="post" onsubmit="return confirm('Are you sure you want to restore this item?');">
                                                    <input type="hidden" name="id" value="@item.ID" />
                                                    <button type="submit" class="dropdown-item" style=" color: white">
                                                        <img src="~/Images/Archive.png" alt="Archive-icon" style="height: 18px; width: auto; margin-right: 5px" /> Restore
                                                    </button>
                                                </form>
                                            }
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </td>
                    </tr>

                }
            </tbody>
        </table>
        <partial name="_PagingNavBar" />
        </div>



 


<script type="text/javascript">
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
    })
    function handleSort(event, field) {
        event.preventDefault();
        const form = event.target.closest('form');
        const sortField = form.querySelector('input[name="sortField"]');
        const sortDirection = form.querySelector('input[name="sortDirection"]');

        if (sortField.value === field) {
            sortDirection.value = sortDirection.value === "asc" ? "desc" : "asc";
        } else {
            sortField.value = field;
            sortDirection.value = "asc";
        }
        form.submit();
    }

</script>
@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: '@TempData["SuccessMessage"]',
                confirmButtonText: 'OK'
            });
        });
    </script>
}

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const tabs = document.querySelectorAll('.nav-tab');
      

        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
               
                tabs.forEach(t => t.classList.remove('active'));

             
                tab.classList.add('active');

         
            });
        });
    });
</script>