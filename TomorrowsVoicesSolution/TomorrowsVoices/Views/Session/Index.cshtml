@model IEnumerable<TomorrowsVoices.Models.Session>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

@{
    ViewData["Title"] = "Index";
    bool isArchived = ViewData["IsArchived"] as bool? ?? false;
}

<div class="d-flex align-items-center mb-3">
    <!-- Sessions Heading -->
    <h1 class="mb-0 me-3">Sessions Attendance | </h1>

    <!-- Buttons for Table and Calendar Views -->
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-primary btn-events-toggle">Table View</a>
        <a asp-action="Calendar" class="btn btn-primary btn-events-toggle">Calendar View</a>
    </div>
</div>

@* Archived tabs *@
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(ViewData["ActiveTab"]?.ToString() == "active" ? "active" : "")"
           asp-action="Index" asp-route-archived="false">Active</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(ViewData["ActiveTab"]?.ToString() == "archived" ? "active" : "")"
           asp-action="Index" asp-route-archived="true">
            Archived
            @if (ViewData["numberofArchive"] != null && (int)ViewData["numberofArchive"] == 0)
            {
                <span>(0)</span>
            }
            else
            {
                <span>(@ViewData["numberofArchive"])</span>
            }
        </a>
    </li>
</ul>
@if (ViewData["ActiveTab"]?.ToString() != "archived"){
<p>
    <a asp-action="Create" class="btn btn-primary"><img src="~/Images/add-attendance.png" alt="add-attendance-icon" style="height: 24px; width: auto; margin-right: 10px" />Create New Attendance</a>
   
    </p>
    <p>
        <a href="@Url.Action("AttendanceReportExport", "Session")" class="btn btn-success"><img src="~/Images/export-csv.png" alt="export-csv-icon" style="height: 24px; width: auto; margin-right: 10px" />Export to Excel</a>
    </p>
}

<form asp-action="Index" method="get">
         <input type="hidden" name="sortDirection" value="@ViewData["sortDirection"]" />
        <input type="hidden" name="sortField" value="@ViewData["sortField"]" />
    <input type="hidden" name="archived" value="@(ViewData["ActiveTab"]?.ToString() == "archived" ? "true" : "false")" />
        <div class="row">
            <div class="col-10">
                <button class="btn mb-3 @ViewData["Filtering"]" type="button" data-bs-toggle="collapse" id="filterToggle"
                        data-bs-target="#collapseFilter" aria-expanded="false" aria-controls="collapseFilter" style="background-color: #6423e7; color: white">
                    <img src="~/Images/filter-search.png" alt="filter-search-icon" style="height: 24px; width: auto; margin-right: 10px" />
                    Filter/Search (@ViewData["numberFilters"])
                </button>

                <!-- Conditionally render the "Clear" button -->
                @if (ViewData["numberFilters"] != null && (int)ViewData["numberFilters"] > 0)
                {
                    <a asp-action="Index" class="mb-3 btn btn-danger text-white">
                        <img src="~/Images/clear-icon.png" alt="Clear filters icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
                        Clear
                    </a>
                }
            </div>
        </div>
        <div class="collapse mb-3 @ViewData["ShowFilter"]" id="collapseFilter">
            <div class="card card-body" style="background-color:lightgray">
                <div class="row">
				    <div class="col-md-3">
					    <div class="form-group">
						    <label class="control-label">Filter by City:</label>
						    @Html.DropDownList("SearchCity", (IEnumerable<SelectListItem>)ViewData["Cities"], new { @class = "form-control" })
					    </div>
				</div>   
                <div class="form-group col-md-3">
					<label class="control-label">Search by Director Name:</label>
					@Html.TextBox("SearchString", null, new { @class = "form-control" })
				</div>
                <div class="row d-flex align-items-center ">
                    <div class="form-group col-md-2">
                        <label class="control-label">From Date:</label>
                        <input class="form-control" type="date" id="StartDate" name="StartDate"
                               value="@ViewData["StartDate"]" aria-describedby="EndDate" aria-invalid="false">
                    </div>
                    <div class="form-group col-md-2">
                        <label class="control-label">To Date:</label>
                        <input class="form-control" type="date" id="StartDate" name="EndDate"
                               value="@ViewData["EndDate"]" aria-describedby="EndDate" aria-invalid="false">
                    </div>



                    <div class="form-group col-md-4">
                        <label class="control-label">Total Present Singers</label>
                        <div class="d-flex align-items-center gap-1">
                            <label class="control-label d-inline-block">Min:</label>
                            <input class="form-control" style="width: 64px; padding-left: 10px; padding-right: 6px; " type="number" id="minPresentSinger" name="minPresentSinger"
                                   value="@ViewData["minPresentSinger"]" aria-describedby="minPresentSinger" aria-invalid="false">

                            <label class="control-label d-inline-block">Max:</label>
                            <input class="form-control" style="width: 64px; padding-left: 10px; padding-right: 6px; " type="number" id="maxPresentSinger" name="maxPresentSinger"
                                   value="@ViewData["maxPresentSinger"]" aria-describedby="maxPresentSinger" aria-invalid="false">
                        </div>

                    </div>

                </div>
				
              
                </div>
                <div class="form-group col-md-2 align-self-start">
                    <input type="submit" name="actionButton" value="Filter"
                           class="btn text-white" style="background-color: #6423e7" />

                </div>
            </div>
        </div>
    <table class="table table-striped table-hover table-custom">
        <thead class="table-dark">
            <tr>
				<th>
                    <button style="font-weight: 700" type="button" class="btn btn-toolbar text-white d-inline" onclick="handleSort(event, 'City')">
                        City
                        @if (ViewData["sortField"]?.ToString() == "City")
                        {
                            if (ViewData["sortDirection"]?.ToString() == "asc")
                            {
                                <div style="position: relative; display: inline-block;">
                                    <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #737373;"></i>
                                    <i class="fa-solid fa-sort-up fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                </div>

                            }
                            else
                            {
                                <div style="position: relative; display: inline-block;">
                                    <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #737373;"></i>
                                    <i class="fa-solid fa-sort-down fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                </div>

                            }
                        }
                        else
                        {
                            <i class="fas fa-sort fa-sm d-inline" style="color: #fff; margin-left: 2.7px"></i>
                        }
                    </button>
				</th>
				<th>
                    <button style="font-weight: 700" type="button" class="btn btn-toolbar text-white d-inline" onclick="handleSort(event, 'Date')">
                        Date
                        @if (ViewData["sortField"]?.ToString() == "Date")
                        {
                            if (ViewData["sortDirection"]?.ToString() == "asc")
                            {
                                <div style="position: relative; display: inline-block;">
                                    <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #737373;"></i>
                                    <i class="fa-solid fa-sort-up fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                </div>

                            }
                            else
                            {
                                <div style="position: relative; display: inline-block;">
                                    <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #737373;"></i>
                                    <i class="fa-solid fa-sort-down fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                </div>
                          
                            }
                        }
                        else
                        {
                            <i class="fas fa-sort fa-sm d-inline" style="color: #fff; margin-left: 2.7px"></i>
                        }
                    </button>
                </th>
                <th>
                    <button style="font-weight: 700" type="button" class="btn btn-toolbar text-white d-inline" onclick="handleSort(event, 'Attendance')">
                        Attendance
                        @if (ViewData["sortField"]?.ToString() == "Attendance")
                        {
                            if (ViewData["sortDirection"]?.ToString() == "asc")
                            {
                                <div style="position: relative; display: inline-block;">
                                    <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #737373;"></i>
                                    <i class="fa-solid fa-sort-up fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                </div>

                            }
                            else
                            {
                                <div style="position: relative; display: inline-block;">
                                    <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #737373;"></i>
                                    <i class="fa-solid fa-sort-down fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                </div>

                            }
                        }
                        else
                        {
                            <i class="fas fa-sort fa-sm d-inline" style="color: #fff; margin-left: 2.7px"></i>
                        }
                    </button>
                </th>
                <th>
                    <button style="font-weight: 700" type="button" class="btn btn-toolbar text-white d-inline" onclick="handleSort(event, 'Director')">
                        Director
                        @if (ViewData["sortField"]?.ToString() == "Director")
                        {
                            if (ViewData["sortDirection"]?.ToString() == "asc")
                            {
                                <div style="position: relative; display: inline-block;">
                                    <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #737373;"></i>
                                    <i class="fa-solid fa-sort-up fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                </div>

                            }
                            else
                            {
                                <div style="position: relative; display: inline-block;">
                                    <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #737373;"></i>
                                    <i class="fa-solid fa-sort-down fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                </div>

                            }
                        }
                        else
                        {
                            <i class="fas fa-sort fa-sm d-inline" style="color: #fff; margin-left: 2.7px"></i>
                        }
                    </button>
                </th>
                <th>
                   <button style="font-weight: 700" type="button" name="actionButton" value="Actions" class="btn btn-toolbar text-white no-pointer-events">Actions</button>
                </th>
            </tr>
        </thead>
        <tbody style="overflow: visible">
            @foreach (var item in Model)
            {
                <tr>
					<td>
						@Html.DisplayFor(modelItem => item.Location.City)
					</td>
					<td>
                        @Html.DisplayFor(modelItem => item.Date)
                    </td>
                    <td>
                        @{
                            int presentSingers = item.Attendance.Count(a => a.Status);
                            int availableSingersInCity = ViewData["AvailableSingers_" + item.Location.ID] as int? ?? 0;
                        }
                        @presentSingers / @availableSingersInCity
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Location.Director.DirectorFullName)
                    </td>
                    <td>
                        <!-- Desktop View (Buttons) -->
                        <div class="d-none d-lg-inline">
                            <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning">
                                <img src="~/Images/edit-value.png" alt="edit-icon" style="height: 24px; width: auto; margin-right: 10px" />Edit
                            </a> |
                            <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info">
                                <img src="~/Images/details.png" alt="details-icon" style="height: 24px; width: auto; margin-right: 10px" />Details
                            </a> |
                            <div class="btn-group">
                                @if (!item.IsArchived)
                                {
                                    <form asp-action="Archive" method="post" onsubmit="return confirm('Are you sure you want to archive this item?');" class="d-inline">
                                        <input type="hidden" name="id" value="@item.ID" />
                                        <button type="submit" class="btn btn-sm btn-danger" style="color:black; background-color:#fb606f;">
                                            <img src="~/Images/Archive.png" alt="Archive-icon" style="height: 24px; width: auto; margin-right: 10px;" />
                                            Archive
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Unarchive" method="post" onsubmit="return confirm('Are you sure you want to restore this item?');" class="d-inline">
                                        <input type="hidden" name="id" value="@item.ID" />
                                        <button type="submit" class="btn btn-sm btn-danger" style="color:black; background-color:#4CAF50 ;">
                                            <img src="~/Images/unarchive.png" alt="Archive-icon" style="height: 24px; width: auto; margin-right: 10px;" />
                                            Restore
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>

                        <!-- Mobile View (Dropdown) -->
                        <div class="d-lg-none">
                            <div class="btn-group">
                                <button class="btn btn-sm dropdown-toggle" style="background-color: #6423e7; color: white" data-bs-toggle="dropdown">
                                    Actions
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.ID">
                                            <img src="~/Images/edit-value.png" alt="edit-icon" style="height: 18px; width: auto; margin-right: 5px" /> Edit
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-action="Details" asp-route-id="@item.ID">
                                            <img src="~/Images/details.png" alt="details-icon" style="height: 18px; width: auto; margin-right: 5px" /> Details
                                        </a>
                                    </li>
                                    <li>
                                        @if (!item.IsArchived)
                                        {
                                            <form asp-action="Archive" method="post" onsubmit="return confirm('Are you sure you want to archive this item?');">
                                                <input type="hidden" name="id" value="@item.ID" />
                                                <button type="submit" class="dropdown-item">
                                                    <img src="~/Images/Archive.png" alt="Archive-icon" style="height: 18px; width: auto; margin-right: 5px" /> Archive
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Unarchive" method="post" onsubmit="return confirm('Are you sure you want to unarchive this item?');">
                                                <input type="hidden" name="id" value="@item.ID" />
                                                <button type="submit" class="dropdown-item">
                                                    <img src="~/Images/Archive.png" alt="Archive-icon" style="height: 18px; width: auto; margin-right: 5px" /> Unarchive
                                                </button>
                                            </form>
                                        }
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </td>
                </tr>

            }
        </tbody>
    </table>
    <partial name="_PagingNavBar" />

</form>

<script type="text/javascript">
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
    })
    function handleSort(event, field) {
        event.preventDefault();
        const form = event.target.closest('form');
        const sortField = form.querySelector('input[name="sortField"]');
        const sortDirection = form.querySelector('input[name="sortDirection"]');

        if (sortField.value === field) {
            sortDirection.value = sortDirection.value === "asc" ? "desc" : "asc";
        } else {
            sortField.value = field;
            sortDirection.value = "asc";
        }
        form.submit();
    }

</script>
@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: '@TempData["SuccessMessage"]',
                confirmButtonText: 'OK'
            });
        });
    </script>
}