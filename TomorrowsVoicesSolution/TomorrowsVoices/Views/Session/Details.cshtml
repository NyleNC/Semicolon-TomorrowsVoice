@model TomorrowsVoices.Models.Session

@{
    ViewData["Title"] = "Details";
    var presentSingersCount = ViewBag.PresentSingersCount ?? "0/0";
    var absentSingersCount = ViewBag.AbsentSingersCount ?? "0/0";
}

<h1>Session Details</h1>

<div>
    <h4>Session</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Date)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Date)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Location)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Location.City)
        </dd>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="presentSingersCount">Present Singers:</label>
                    <input type="text" id="presentSingersCount" class="form-control" value="@presentSingersCount" readonly>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="absentSingersCount">Absent Singers:</label>
                    <input type="text" id="absentSingersCount" class="form-control" value="@absentSingersCount" readonly>
                </div>
            </div>
        </div>
        <div class="col-md-6">
          
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>
                            Attended Singers
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Attendance.Where(a => a.Status))
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Singer.FullName)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="col-md-6">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>
                            Absent Singers
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Attendance.Where(a => a.Status == false))
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Singer.FullName)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
      

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Notes)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Notes)
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.ID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
