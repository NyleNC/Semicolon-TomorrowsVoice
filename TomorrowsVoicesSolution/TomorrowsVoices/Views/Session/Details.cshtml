@model TomorrowsVoices.Models.Session

@{
    ViewData["Title"] = "Details";
    var presentSingersCount = ViewBag.PresentSingersCount ?? "0/0";
    var absentSingersCount = ViewBag.AbsentSingersCount ?? "0/0";
}


<h1>Session Details</h1>

<div>
    <h4>Session</h4>
    <hr />
    <dl class="row">

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Location.City)
            </dt>
            <dd class="col-sm-10 ">
                @Html.DisplayFor(model => model.Location.City)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Location.Director.DirectorFullName)
            </dt>
            <dd class="col-sm-10">
			    @Html.DisplayFor(model => model.Location.Director.DirectorFullName)
            </dd>
 
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Date)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Date)
        </dd>
        
       
        <div class="col-md-6 mt-4">
          
            <table class="table table-striped table-custom">
                <thead class="bg-dark text-white">
                    <tr>
                        <th class="text-white">
                                <label class=" d-inline" for="presentSingersCount" style="font-weight: 500">Present Singers:</label>
                                <input class="d-inline" type="text" id="presentSingersCount" value="@presentSingersCount" readonly>
                          
                        </th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Attendance.Where(a => a.Status))
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Singer.FullName)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="col-md-6 mt-4">
            <table class="table table-striped table-custom">
                <thead class="bg-dark text-white">
                    <tr>
                        <th class="text-white">
                            <label class=" d-inline" for="absentSingersCount" style="font-weight: 500">Absent Singers:</label>
                            <input class="d-inline" type="text" id="absentSingersCount" value="@absentSingersCount" readonly>

                        </th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Attendance.Where(a => a.Status == false))
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Singer.FullName)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
      

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Notes)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Notes)
        </dd>
    </dl>
</div>

<div class="mb-3">
    <a asp-action="Edit" asp-route-id="@Model?.ID" class="btn btn-warning">
        <img src="~/Images/edit-value.png" alt="Edit Values" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Edit
    </a>
</div>
<a asp-action="Index" class="btn btn-secondary"><img src="~/Images/previous-page-icon.png" alt="go to previous page icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Back to Singer Page</a>
