@model TomorrowsVoices.Models.Session

@{
    ViewData["Title"] = "Details";
    var presentSingersCount = ViewBag.PresentSingersCount ?? "0/0";
    var absentSingersCount = ViewBag.AbsentSingersCount ?? "0/0";
}


<h1>Session Attendance Details</h1>

<div>
    <hr />
    <dl class="row">

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Location.City)
        </dt>
        <dd class="col-sm-10 ">
            @Html.DisplayFor(model => model.Location.City)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Location.DirectorLocations.FirstOrDefault().Director.DirectorFullName)
        </dt>
        <dd class="col-sm-10">
            @if (Model.Location?.DirectorLocations != null && Model.Location.DirectorLocations.Any())
            {
                <ul class="list-unstyled">
                    @foreach (var directorLocation in Model.Location.DirectorLocations)
                    {
                        <li>@directorLocation.Director?.DirectorFullName</li>
                    }
                </ul>
            }
            else
            {
                <span>No director assigned</span>
            }
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Date)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Date)
        </dd>


        <div class="col-md-6 mt-4">

            <table class="table table-striped table-custom">
                <thead class="bg-dark text-white">
                    <tr>
                        <th class="text-white">
                            <label class=" d-inline" for="presentSingersCount" style="font-weight: 700">Present Singers</label>

                        </th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Attendance.Where(a => a.Status))
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Singer.FullName)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="col-md-6 mt-4">
            <table class="table table-striped table-custom">
                <thead class="bg-dark text-white">
                    <tr>
                        <th class="text-white">
                            <label class=" d-inline" for="absentSingersCount" style="font-weight: 700">Absent Singers</label>
                        </th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Attendance.Where(a => a.Status == false))
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Singer.FullName)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>


        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Notes)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Notes)
        </dd>
    </dl>
    <div class="mb-3">
        @if (!Model.IsArchived)
        {
            <a asp-action="Edit" asp-route-id="@Model?.ID" class="btn btn-warning">
                <img src="~/Images/edit-value.png" alt="Edit Values" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Edit
            </a>
        }
        else
        {
            <button class="btn btn-warning" disabled title="Archived Directors cannot be edited.">
                <img src="~/Images/edit-value.png" alt="Edit Values" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Edit
            </button>
        }
    </div>
    <a asp-action="Index" class="btn btn-secondary" style="margin-bottom: 226px"><img src="~/Images/previous-page-icon.png" alt="go to previous page icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Back to Attendance Page</a>

</div>

