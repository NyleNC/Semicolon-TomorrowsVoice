@model TomorrowsVoices.Models.Session
<link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
@{
    ViewData["Title"] = "Create";
    var presentSingersCount = ViewBag.PresentSingersCount ?? "0/0";
    var absentSingersCount = ViewBag.AbsentSingersCount ?? "0/0";
}

<h1>Create Attendance</h1>

<h4>Session Attendance Information</h4>
<hr />
<div class="row">
    <div class="col-md-4">
    <form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<div class="row">
				<div class="col-md-6">
					<div class="form-group">
                        <label asp-for="Location.City" class="control-label"></label>
                        <select asp-for="Location.City" class="form-control"
                                asp-items="Html.GetEnumSelectList<City>()"
                                onchange="updateDirectorName(this.value)"
                                id="LocationDropDown">
                            <option value="" selected>Select the City</option>
                        </select>
                        <span asp-validation-for="Location.City" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="DirectorName">Director in Charge</label>
                        <input type="text" id="DirectorName" class="form-control" readonly>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Date" class="control-label">Session Date</label>
                <input asp-for="Date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="presentSingersCount">Present Singers Count</label>
                        <input type="text" id="presentSingersCount" class="form-control" value="@presentSingersCount" readonly>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label for="absentSingersCount">Absent Singers Count</label>
                        <input type="text" id="absentSingersCount" class="form-control" value="@absentSingersCount" readonly>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="row">
                    <div class="form-group col-md-6">
                        <label class="control-label"> Singers Attended</label> <button type="button" id="btnRight" class="btn btn-danger btn-sm">
                            <strong>-</strong>
                        </button>
                        @Html.ListBox("selectedOptions", (MultiSelectList)ViewBag.selOpts,
                                 new { @size = 10, @class = "form-control", @style = "margin-top: 0.5rem;" })
                    </div>

                    <div class="form-group col-md-6">
                        <label class="control-label"> Choose Singers</label> <button type="button" id="btnLeft" class="btn btn-success btn-sm">
                            <strong>+</strong>
                        </button>&nbsp;&nbsp;
                        @*

                        ***** This is a good opportunity for us to have a Add Singers Shortcut****

                        <button class="btn btn-sm btn-outline-secondary" id="nowAddSinger"
                        data-bs-toggle="modal" data-bs-target="#addSingerModal"
                        type="button">
                        <strong>Add Singer</strong>
                        </button> *@
                        @Html.ListBox("availOptions", (MultiSelectList)ViewBag.availOpts,
                                 new { @size = 10, @class = "form-control", @style = "margin-top: 0.5rem;" })
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Notes" class="control-label"></label>
                <textarea asp-for="Notes" rows="5" class="form-control"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
           


            <div class="form-group">
                <input type="submit" id="btnSubmit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/multiselect.js"></script>
<script>
        function updateDirectorName(locationId) {
            fetch(`/Session/GetDirectorByLocation?locationId=${locationId}`)
                .then(response => response.json())
                .then(data => {
                    document.getElementById("DirectorName").value = data.directorName || "No director assigned";
                })
                .catch(error => console.error('Error:', error));

            document.addEventListener("DOMContentLoaded", () => {
                let locationDropdown = document.getElementById("LocationID");
                if (locationDropdown) {
                    locationDropdown.value = "";
                }
                updateDirectorName("");


            })
        }

</script>
}

