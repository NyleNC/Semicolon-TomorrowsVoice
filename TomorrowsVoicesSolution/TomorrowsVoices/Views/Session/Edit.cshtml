@model TomorrowsVoices.Models.Session
<link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />

@{
    ViewData["Title"] = "Edit";
    // var presentSingersCount = ViewBag.PresentSingersCount ?? "0/0";
    // var absentSingersCount = ViewBag.AbsentSingersCount ?? "0/0";
}

<h1>Edit Session Attendance</h1>

<hr />
<p class="mb-4" style="font-weight: 500">Fields marked <span style="color: red">*</span> are required.</p>



<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="ID" />
    <input type="hidden" name="selectedOptions" id="selectedOptionsInput" />
    <input type="hidden" name="removedOptions" id="removedOptionsInput" />
    <div class="mt-4 row">
        <div class="col-md-4">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="LocationID" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                        <select asp-for="LocationID" class="form-control city-dropdown"
                                asp-items="ViewBag.LocationID"
                                onchange="updateDirectorAndSingers(this.value)">
                            <option value="">Select a city</option>

                        </select>

                        <span asp-validation-for="LocationID" class="text-danger"></span>
                    </div>

                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="DirectorDropDown" style="font-weight: 700">Director in Charge</label>
                        <select asp-for="Location.DirectorLocations.FirstOrDefault().DirectorID" class="form-control" id="DirectorDropDown">
                            <option value="">Select a director</option>
                            @if (Model.Location?.DirectorLocations?.FirstOrDefault() != null)
                            {
                                <option value="@Model.Location.DirectorLocations.FirstOrDefault().DirectorID" selected>
                                    @Model.Location.DirectorLocations.FirstOrDefault().Director.DirectorFullName
                                </option>
                            }
                        </select>
                        <span asp-validation-for="Location.DirectorLocations.FirstOrDefault().DirectorID" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Date" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="Date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>


            <div class="form-group">
                <label asp-for="Notes" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <textarea asp-for="Notes" rows="5" class="form-control"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-7 ms-auto">
            @*     <div class="row">
            <div class="col-md">
            <div class="form-group">
            <label for="absentSingersCount" style="font-weight: 500">Absent Singers Count</label>
            <input type="text" id="absentSingersCount" class="form-control" value="@absentSingersCount" readonly>
            </div>
            </div>

            <div class="col-md">
            <div class="form-group">
            <label for="presentSingersCount" style="font-weight: 500">Present Singers Count</label>
            <input type="text" id="presentSingersCount" class="form-control" value="@presentSingersCount" readonly>
            </div>
            </div>


            </div> *@
            <div class="col-md-12">
                <div class="row">
                    <div class="form-group col-md-6">
                        <label class="control-label" style="font-weight: 700"> Choose Singers</label> 
                        <button type="button" id="btnLeft" class="btn btn-success btn-sm" title="Add selected singers to attendance">
                            <strong>+</strong>
                        </button>&nbsp;&nbsp;
                        @*

                        ***** This is a good opportunity for us to have a Add Singers Shortcut****

                        <button class="btn btn-sm btn-outline-secondary" id="nowAddSinger"
                        data-bs-toggle="modal" data-bs-target="#addSingerModal"
                        type="button">
                        <strong>Add Singer</strong>
                        </button> *@
                        @Html.ListBox("availOptions", (MultiSelectList)ViewBag.availOpts,
                                 new { @size = 10, @class = "form-control", @style = "margin-top: 0.5rem;" })
                    </div>

                    <div class="form-group col-md-6">
                        <label class="control-label" style="font-weight: 700"> Singers Attended</label> 
                        <button type="button" id="btnRight" class="btn btn-danger btn-sm" title="Remove selected singers to attendance">
                            <strong>-</strong>
                        </button>
                        @Html.ListBox("attendingOptions", (MultiSelectList)ViewBag.selOpts,
                                 new { @size = 10, @class = "form-control", @style = "margin-top: 0.5rem;" })
                    </div>


                </div>
            </div>

        </div>

        <div class="col-md-4" style="margin-bottom: 140px">
            <div class="form-group">
                <button type="submit" class="btn btn-success" title="Save changes to this Attendance">
                    <img src="~/Images/save-changes-icon.png" alt="Save changes" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
                    Save
                </button>
            </div>
            <a asp-action="Index" class="btn btn-secondary" style="margin-bottom: 100px" title="Go back to Sessions Index Page"><img src="~/Images/previous-page-icon.png" alt="go to previous page icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Back to Attendance Page</a>
        </div>

</form>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <!-- Load jQuery first -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Then load Select2 -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
    <!-- Then load our custom scripts -->
    <script>
        // Global variables to track selected and removed singers
        var selectedSingers = new Set();
        var removedSingers = new Set();

        $(document).ready(function () {
            // Initialize Select2
            $('.city-dropdown').select2({
                placeholder: "Select a city",
                allowClear: true
            });

            // Get the current location ID from the model
            var currentLocationId = '@Model.LocationID';
            var currentDirectorId = '@(Model.Location?.DirectorLocations?.FirstOrDefault()?.DirectorID)';

            // Initialize with current attending singers
            $('#attendingOptions option').each(function() {
                selectedSingers.add($(this).val());
            });

            // If there's a location selected, update the director and singers
            if (currentLocationId && currentLocationId !== '0') {
                $('#LocationID').val(currentLocationId).trigger('change');
                if (currentDirectorId) {
                    $('#DirectorDropDown').val(currentDirectorId).trigger('change');
                }
                updateDirectorAndSingers(currentLocationId);
            }

            // Handle moving singers from available to attending
            $('#btnLeft').click(function() {
                var selectedItems = $('#availOptions option:selected');
                if (selectedItems.length === 0) {
                    alert("Please select singers to add");
                    return;
                }
                selectedItems.each(function() {
                    var value = $(this).val();
                    selectedSingers.add(value);
                    removedSingers.delete(value);
                });
                selectedItems.appendTo('#attendingOptions');
                updateHiddenInputs();
            });

            // Handle moving singers from attending to available
            $('#btnRight').click(function() {
                var selectedItems = $('#attendingOptions option:selected');
                if (selectedItems.length === 0) {
                    alert("Please select singers to remove");
                    return;
                }
                selectedItems.each(function() {
                    var value = $(this).val();
                    selectedSingers.delete(value);
                    removedSingers.add(value);
                    $(this).remove(); // Remove from attending list
                });
                // Add to available list
                selectedItems.appendTo('#availOptions');
                updateHiddenInputs();
            });

            // Update hidden inputs before form submission
            function updateHiddenInputs() {
                // Remove all existing hidden inputs
                $('input[name="selectedOptions"]').remove();
                $('input[name="removedOptions"]').remove();
                
                // Add new hidden inputs for selected singers
                Array.from(selectedSingers).forEach(function(value) {
                    $('<input>').attr({
                        type: 'hidden',
                        name: 'selectedOptions',
                        value: value
                    }).appendTo('form');
                });
                
                // Add new hidden inputs for removed singers
                Array.from(removedSingers).forEach(function(value) {
                    $('<input>').attr({
                        type: 'hidden',
                        name: 'removedOptions',
                        value: value
                    }).appendTo('form');
                });
            }

            // Ensure hidden inputs are updated before form submission
            $('form').submit(function() {
                updateHiddenInputs();
            });

            // Initialize hidden inputs
            updateHiddenInputs();
        });

        function updateDirectorAndSingers(locationId) {
            if (!locationId || locationId === '0') {
                $('#DirectorDropDown').empty().append('<option value="">Select a director</option>');
                $('#availOptions').empty().append('<option disabled>Select a City first</option>');
                $('#attendingOptions').empty();
                return;
            }

            $.ajax({
                url: `/Session/GetDirectorAndSingersByLocation?locationId=${locationId}`,
                type: "GET",
                dataType: "json",
                success: function(data) {
                    // Handle directors
                    let directorDropdown = $('#DirectorDropDown');
                    let currentOptions = directorDropdown.find('option[value!=""]');

                    if (data.directors && data.directors.length > 0) {
                        data.directors.forEach(function(director) {
                            if (!directorDropdown.find(`option[value="${director.id}"]`).length) {
                                directorDropdown.append($('<option></option>').val(director.id).text(director.name));
                            }
                        });

                        let currentSelected = directorDropdown.val();
                        if (!currentSelected && '@Model.Location?.DirectorLocations?.FirstOrDefault()?.DirectorID') {
                            directorDropdown.val('@Model.Location?.DirectorLocations?.FirstOrDefault()?.DirectorID');
                        }
                    } else if (currentOptions.length === 0) {
                        directorDropdown.append('<option value="">No directors available</option>');
                    }

                    // Handle singers
                    let availableSingers = $('#availOptions');
                    let attendingSingers = $('#attendingOptions');
                    availableSingers.empty();
                    attendingSingers.empty();

                    if (data.singers && data.singers.length > 0) {
                        data.singers.forEach(function(singer) {
                            if (selectedSingers.has(singer.id.toString())) {
                                attendingSingers.append($('<option></option>').val(singer.id).text(singer.name));
                            } else {
                                availableSingers.append($('<option></option>').val(singer.id).text(singer.name));
                            }
                        });
                    } else {
                        availableSingers.append('<option disabled>No singers available for this location</option>');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error fetching director and singers:', error);
                }
            });
        }
    </script>
}

@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: '@TempData["SuccessMessage"]',
                confirmButtonText: 'OK'
            });
        });
    </script>
}