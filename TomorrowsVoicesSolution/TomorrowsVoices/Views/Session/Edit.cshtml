@model TomorrowsVoices.Models.Session
<link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Session Attendance</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ID" />
            <div class="form-group">
                <label asp-for="Date" class="control-label"></label>
                <input asp-for="Date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Location.City" class="control-label"></label>
                <select asp-for="Location.City" class="form-control city-dropdown" asp-items="Html.GetEnumSelectList<City>()"></select>
                <span asp-validation-for="Location.City" class="text-danger"></span>
            </div>
            <div class="col-md-8">
                <div class="row">
                    <div class="form-group col-md-6">
                        <label class="control-label"> Singers Attended</label> <button type="button" id="btnRight" class="btn btn-danger btn-sm">
                            <strong>-</strong>
                        </button>
                        @Html.ListBox("selectedOptions", (MultiSelectList)ViewBag.selOpts, new { @size = 10, @class = "form-control" })
                    </div>

                    <div class="form-group col-md-6">
                        <label class="control-label"> Choose Singers</label> <button type="button" id="btnLeft" class="btn btn-success btn-sm">
                            <strong>+</strong>
                        </button>
                        @Html.ListBox("availOptions", (MultiSelectList)ViewBag.availOpts, new { @size = 10, @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Notes" class="control-label"></label>
                <textarea asp-for="Notes" rows="5" class="form-control"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/multiselect.js"></script>
    <script>
            function updateDirectorName(locationId) {
                fetch(`/Session/GetDirectorByLocation?locationId=${locationId}`)
                    .then(response => response.json())
                    .then(data => {
                        document.getElementById("DirectorName").value = data.directorName || "No director assigned";
                    })
                    .catch(error => console.error('Error:', error));

                document.addEventListener("DOMContentLoaded", () => {
                    let locationDropdown = document.getElementById("LocationID");
                    if (locationDropdown) {
                        locationDropdown.value = "";
                    }
                    updateDirectorName("");


                })
            }
                $(document).ready(function () {
            $("#City").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '@Url.Action("CitySuggestions", "Director")',
                        type: "GET",
                        dataType: "json",
                        data: { term: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item, value: item };
                            }));
                        }
                    });
                },
                minLength: 1,
                messages: {
                    noResults: "No cities found",
                    results: function () { return ""; }
                },
         open: function () {

                    var autocompleteList = $(".ui-autocomplete");
                    autocompleteList.css({
                        "max-height": "200px",
                        "overflow-y": "auto",
                         "overflow-x": "hidden"
                    });
                }
            });
        });
           $(document).ready(function() {
            $('.city-dropdown').select2({
                placeholder: "Select a city",
                allowClear: true
            });
        });
    </script>
}

