<!-- Table for Singers -->
<form asp-action="Index" method="get">
    <input type="hidden" name="sortDirection" value="@ViewData["sortDirection"]" />
    <input type="hidden" name="sortField" value="@ViewData["sortField"]" />

    <div class="row">
        <div class="col-10">
            <button class="btn mb-3 @ViewData["Filtering"]" type="button" data-bs-toggle="collapse" id="filterToggle"
                    data-bs-target="#collapseFilter" aria-expanded="false" aria-controls="collapseFilter" style="background-color: mediumpurple; color: white">
                <img src="~/Images/filter-search.png" alt="filter-search-icon" style="height: 24px; width: auto; margin-right: 10px" />
                Filter/Search (@ViewData["numberFilters"])
            </button>
            <a asp-action="Index" class=" mb-3 btn btn-danger text-white"><img src="~/Images/clear-icon.png" alt="Clear filters icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Clear</a>

        </div>
    </div>
    <div class="collapse mb-3 @ViewData["ShowFilter"]" id="collapseFilter">
        <div class="card card-body" style="background-color:lightgray">
            <div class="row">
                <div class="form-group col-md-3">
                    <label class="control-label">Search by Singers Name:</label>
                    @Html.TextBox("SearchString", null, new { @class = "form-control" })
                </div>
                <div class="col-md-4">
                    <label class="control-label">Search by Location:</label>
                    <input type="text" class="form-control" name="searchLocation" placeholder="Search by Location" value="@Context.Request.Query["searchLocation"]" />
                </div>
                <div class="col-md-2">
                    <label class="control-label">Search by Availability:</label>
                    <select class="form-control" name="searchIsAvailable">
                        <option value="">Availability (All)</option>
                        <option value="true" selected="@(Context.Request.Query["searchIsAvailable"] == "true")">Available</option>
                        <option value="false" selected="@(Context.Request.Query["searchIsAvailable"] == "false")">Unavailable</option>
                    </select>
                </div>
            </div>
            <div class="form-group col-md-2 align-self-start">
                <input type="submit" name="actionButton" value="Filter"
                       class="btn btn-primary" />

            </div>
        </div>
    </div>




    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>
                    <button type="button" class="btn btn-toolbar text-white" onclick="handleSort(event, 'FullName')">
                        Singer
                        @if (ViewData["sortField"]?.ToString() == "FullName")
                        {
                            if (ViewData["sortDirection"]?.ToString() == "asc")
                            {
                                <i class="bi bi-sort-alpha-up ms-2"></i>
                            }
                            else
                            {
                                <i class="bi bi-sort-alpha-down ms-2"></i>
                            }
                        }
                    </button>
                </th>
                
                <th>
                    <button type="button" name="actionButton" value="Location" class="btn btn-toolbar text-white" onclick="handleSort(event, 'Location')">
                        Location
                        @if (ViewData["sortField"]?.ToString() == "Location")
                        {
                            if (ViewData["sortDirection"]?.ToString() == "asc")
                            {
                                <i class="bi bi-sort-alpha-up ms-2"></i>
                            }
                            else
                            {
                                <i class="bi bi-sort-alpha-down ms-2"></i>
                            }
                        }
                    </button>
                </th>

              
                <th>
                    <button type="button" name="actionButton" value="IsAvailable" class="btn btn-toolbar text-white" onclick="handleSort(event, 'IsAvailable')">
                        City
                        @if (ViewData["sortField"]?.ToString() == "IsAvailable")
                        {
                            if (ViewData["sortDirection"]?.ToString() == "asc")
                            {
                                <i class="bi bi-sort-alpha-up ms-2"></i>
                            }
                            else
                            {
                                <i class="bi bi-sort-alpha-down ms-2"></i>
                            }
                        }
                    </button>
                </th>



                <th class="d-none d-md-table-cell">
                    <button type="button" name="actionButton" value="Actions" class="btn btn-toolbar text-white">Actions</button>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                    <td>@(item.Location != null ? item.Location.City : "Not Set")</td>
                    <td>
                        <button type="button" class="toggle-btn btn @(item.IsAvailable ? "btn-success" : "btn-danger")"
                                data-id="@item.ID">
                            <i class="bi @(item.IsAvailable ? "bi-check-circle" : "bi-x-circle")"></i>
                            @(item.IsAvailable ? "Available" : "Unavailable")
                        </button>
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning"><img src="~/Images/edit-value.png" alt="edit-icon" style="height: 24px; width: auto; margin-right: 10px" />Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info"><img src="~/Images/details.png" alt="details-icon" style="height: 24px; width: auto; margin-right: 10px" />Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-danger"><img src="~/Images/archive.png" alt="archive-icon" style="height: 24px; width: auto; margin-right: 10px" />Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <partial name="_PagingNavBar" />
</form>


<!-- #JS Scripts -->

<!-- Sorting and JS Script -->
<script>
    function handleSort(event, field) {
        event.preventDefault();
        const form = event.target.closest('form');
        const sortField = form.querySelector('input[name="sortField"]');
        const sortDirection = form.querySelector('input[name="sortDirection"]');

        if (sortField.value === field) {
            // Toggle sort direction
            sortDirection.value = sortDirection.value === "asc" ? "desc" : "asc";
        } else {
            // Set new field and default to ascending order
            sortField.value = field;
            sortDirection.value = "asc";
        }

        // Submit the form
        form.submit();
    }
</script>


@* Script for IsAvailable AJAX. *@
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        // Handle button click
        $(".toggle-btn").click(function (event) {
            event.preventDefault();  // Prevent page refresh

            var button = $(this);
            var singerId = button.data("id");  // Get the singer ID from the data attribute

            // Make AJAX call to the server
            $.ajax({
                url: '@Url.Action("ToggleAvailability", "Singer")',  // URL to the controller action
                type: 'POST',
                data: { id: singerId },  // Pass the singer ID to the server
                success: function (response) {
                    if (response.success) {
                        // Toggle button text and style
                        if (response.isAvailable) {
                            button.removeClass("btn-danger").addClass("btn-success").text("Available");
                        } else {
                            button.removeClass("btn-success").addClass("btn-danger").text("Unavailable");
                        }
                    } else {
                        alert("Error: " + response.message);
                    }
                },  
                error: function () {
                    alert("An error occurred while updating availability.");
                }
            });
        });
    });
</script>


