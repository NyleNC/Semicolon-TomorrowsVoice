@model TomorrowsVoices.Models.Singer
<link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
@{
    ViewData["Title"] = "Edit";
}
<div>

</div>

<h1>Edit</h1>

<h4>Singer</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ID" />

            <div class="form-group">
                <label asp-for="FirstName" class="control-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LastName" class="control-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Location.City" class="control-label"></label>
                <select asp-for="Location.City" class="form-control city-dropdown" asp-items="Html.GetEnumSelectList<City>()"></select>
                <span asp-validation-for="Location.City" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IsAvailable" class="control-label"></label>
                <input asp-for="IsAvailable" type="checkbox" class="form-check-input" />
                <span asp-validation-for="IsAvailable" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CreatedAt" class="control-label"></label>
                <p class="form-control-plaintext">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</p>
            </div>

            <div class="form-group">
                <label asp-for="UpdatedAt" class="control-label"></label>
                <p class="form-control-plaintext">
                    @(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm:ss") : "Never Updated")
                </p>
            </div>


            <div class="form-group">
                <button type="submit" class="btn btn-success">
                <img src="~/Images/save-changes-icon.png" alt="Save changes" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
                Save
                </button>
            </div>
            <a asp-action="Index" class="btn btn-secondary"><img src="~/Images/previous-page-icon.png" alt="go to previous page icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Back to Singer Page</a>

        </form>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");

    }<script>
             $(document).ready(function () {
                 $("#City").autocomplete({
                     source: function (request, response) {
                         $.ajax({
                             url: '@Url.Action("CitySuggestions", "Director")',
                             type: "GET",
                             dataType: "json",
                             data: { term: request.term },
                             success: function (data) {
                                 response($.map(data, function (item) {
                                     return { label: item, value: item };
                                 }));
                             }
                         });
                     },
                     minLength: 1,
                     messages: {
                         noResults: "No cities found",
                         results: function () { return ""; }
                     },
              open: function () {

                         var autocompleteList = $(".ui-autocomplete");
                         autocompleteList.css({
                             "max-height": "200px",
                             "overflow-y": "auto",
                              "overflow-x": "hidden"
                         });
                     }
                 });
             });
                $(document).ready(function() {
                 $('.city-dropdown').select2({
                     placeholder: "Select a city",
                     allowClear: true
                 });
             });
    </script>
}
