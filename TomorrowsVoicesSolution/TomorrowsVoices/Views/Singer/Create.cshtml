@model TomorrowsVoices.Models.Singer
<link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
@{
    ViewData["Title"] = "Create";
}

<h1>Create Singer</h1>

<hr />
<p class="mb-4" style="font-weight: 700">Fields marked <span style="color: red">*</span> are required.</p>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="FirstName" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="FirstName" class="form-control" placeholder="Jon" id="FirstName" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="LastName" class="form-control" placeholder="Snow" id="LastName" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LocationID" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <select asp-for="LocationID" class="form-control city-dropdown" asp-items="ViewBag.CityList" id="LocationID">
                    <option value="">Select a location</option>
                </select>
                <span asp-validation-for="LocationID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmergencyContactName" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="EmergencyContactName" class="form-control" placeholder="Lyanna Stark" id="EmergencyContactName" />
                <span asp-validation-for="EmergencyContactName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmergencyContactNumber" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="EmergencyContactNumber" class="form-control" placeholder="1234567890" id="EmergencyContactNumber" />
                <span asp-validation-for="EmergencyContactNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CreatedOn" class="control-label"><strong>Created On</strong></label>
                <p class="form-control-plaintext">@Model.CreatedOn.ToString("MMM/dd/yyyy | hh:mm:ss tt")</p>
            </div>
            <div class="form-group d-flex gap-2">
                <div class="form-group">
                    <button type="submit" class="btn btn-primary" title="Create a new Singer">
                        <img src="~/Images/create-icon.png" alt="Create icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
                        Create
                    </button>
                </div>
                <div class="form-group d-inline">
                    <button type="button" id="fillPresetButton" class="btn btn-secondary" style="background-color: navy;" title="(Demo) Fill fields with preset values">Fill Preset Values</button>
                </div>
            </div>
            <a asp-action="Index" class="btn btn-secondary" title="Go back to Singers Index Page"><img src="~/Images/previous-page-icon.png" alt="go to previous page icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Back to Singer Page</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            // Initialize Select2 for the LocationID dropdown
            $('.city-dropdown').select2({
                placeholder: "Select a city",
                allowClear: true
            });

            // Fill Preset Values Button
            document.getElementById("fillPresetButton").addEventListener("click", function () {
                // Preset Values
                let defaultValues = {
                    FirstName: "Alex",
                    LastName: "Moore",
                    LocationID: "1", // Replace "1" with the actual value of the location you want to preselect
                    EmergencyContactName: "John Doe",
                    EmergencyContactNumber: "(123) 456-7890"
                };

                // Set fields only if they are empty
                if (!document.getElementById("FirstName").value) {
                    document.getElementById("FirstName").value = defaultValues.FirstName;
                }
                if (!document.getElementById("LastName").value) {
                    document.getElementById("LastName").value = defaultValues.LastName;
                }
                if (!document.getElementById("EmergencyContactName").value) {
                    document.getElementById("EmergencyContactName").value = defaultValues.EmergencyContactName;
                }
                if (!document.getElementById("EmergencyContactNumber").value) {
                    document.getElementById("EmergencyContactNumber").value = defaultValues.EmergencyContactNumber;
                }

                // Set the LocationID dropdown using Select2
                if (!$("#LocationID").val()) {
                    $("#LocationID").val(defaultValues.LocationID).trigger('change');
                }
            });



            // Phone Number Formatting
            // document.getElementById('EmergencyContactNumber').addEventListener('input', function (e) {
