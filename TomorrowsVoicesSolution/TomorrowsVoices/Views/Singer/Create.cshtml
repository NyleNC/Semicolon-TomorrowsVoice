@model TomorrowsVoices.Models.Singer
<link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Singer</h4>
<hr />
<p class="mb-4" style="font-weight: 500">Fields marked <span style="color: red">*</span> are required.</p>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="FirstName" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="FirstName" class="form-control" placeholder="Jon" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="LastName" class="form-control" placeholder="Snow" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LocationID" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <select asp-for="LocationID" class="form-control city-dropdown" asp-items="ViewBag.CityList">
                    <option value="">Select a location</option>
                </select>
                <span asp-validation-for="LocationID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmergencyContactName" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="EmergencyContactName" class="form-control" placeholder="Lyanna Stark" />
                <span asp-validation-for="EmergencyContactName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmergencyContactNumber" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="EmergencyContactNumber" class="form-control" placeholder="1234567890" id="EmergencyContactNumber" />
                <span asp-validation-for="EmergencyContactNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CreatedOn" class="control-label"><strong>Created On</strong></label>
                <p class="form-control-plaintext">@Model.CreatedOn.ToString("MMM/dd/yyyy | hh:mm:ss tt")</p>
            </div>
            <div class="form-group d-flex gap-2">
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                        <img src="~/Images/create-icon.png" alt="Create icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
                        Create
                </div>
                <div class="form-group d-inline">
                    <button type="button" id="fillPresetButton" class="btn btn-secondary" style="background-color: navy;">Fill Preset Values</button>
                </div>
            </div>
            <a asp-action="Index" class="btn btn-secondary"><img src="~/Images/previous-page-icon.png" alt="go to previous page icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Back to Singer Page</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $("#City").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '@Url.Action("CitySuggestions", "Director")',
                        type: "GET",
                        dataType: "json",
                        data: { term: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item, value: item };
                            }));
                        }
                    });
                },
                minLength: 1,
                messages: {
                    noResults: "No cities found",
                    results: function () { return ""; }
                },
                open: function () {
                    var autocompleteList = $(".ui-autocomplete");
                    autocompleteList.css({
                        "max-height": "200px",
                        "overflow-y": "auto",
                        "overflow-x": "hidden"
                    });
                }
            });
        });
        $(document).ready(function () {
            $('.city-dropdown').select2({
                placeholder: "Select a city",
                allowClear: true
            });
        });
    </script>
}

<script>
    document.getElementById("fillPresetButton").addEventListener("click", function () {
        // Preset Values
        let defaultValues = {
            FirstName: "Alex",
            LastName: "Moore",
            City: "Toronto",
            IsAvailable: true
        };

        // Set fields only if they are empty
        if (!document.getElementById("FirstName").value) {
            document.getElementById("FirstName").value = defaultValues.FirstName;
        }
        if (!document.getElementById("LastName").value) {
            document.getElementById("LastName").value = defaultValues.LastName;
        }

        // Check "IsAvailable"
        document.getElementById("IsAvailable").checked = defaultValues.IsAvailable;
    });


    });
</script>

<script>
    $(document).ready(function() {
        $('.city-dropdown').select2({
            placeholder: "Select a city",
            allowClear: true,
            dropdownParent: $('body') // This will make select2's dropdown overflow outside the container.
        }).on('select2:open', function (e) {
            const $dropdown = $(".select2-dropdown");
            const $select2 = $(this).data('select2');
            if ($select2 && $select2.options && $select2.options.options) {
                $dropdown.css('z-index', 1051);
            }
        });
    });

    // For emergency contact number format
    document.getElementById('EmergencyContactNumber').addEventListener('input', function (e) {
        let cursorPosition = e.target.selectionStart;
        let value = e.target.value.replace(/\D/g, ""); // Remove non-numeric characters

        if (value.length > 10) {
            value = value.substring(0, 10); // Limit to 10 digits
        }

        let formattedValue = "";

        if (value.length > 0) {
            formattedValue += "(" + value.substring(0, 3);
        }
        if (value.length >= 4) {
            formattedValue += ") " + value.substring(3, 6);
        }
        if (value.length >= 7) {
            formattedValue += "-" + value.substring(6, 10);
        }

        e.target.value = formattedValue;
    });

    // Remove formatting before form submission
    document.querySelector('form').addEventListener('submit', function (e) {
        let emergencyContactNumber = document.getElementById('EmergencyContactNumber');
        emergencyContactNumber.value = emergencyContactNumber.value.replace(/\D/g, ""); // Remove non-numeric characters
    });

    // Event listener for input field
    document.getElementById('EmergencyContactNumber').addEventListener('input', function (e) {
        e.target.value = formatPhoneNumber(e.target.value);
    });
</script>

