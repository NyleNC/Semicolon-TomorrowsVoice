    <!-- Upcoming Session List -->
    <script>
        $(document).ready(function () {
            loadUpcomingSessions();
        });

        function loadUpcomingSessions() {
            $.ajax({
                url: '@Url.Action("GetUpcomingSessions", "Session")',
                type: 'GET',
                success: function (data) {
                    $('#upcoming-sessions').empty(); // Clear the container

                    if (data.length > 0) {
                        // If there are sessions, render them
                        data.forEach(function (session) {
                            var sessionHtml = `
                                <div class="session-item animate__animated animate__fadeIn" data-session-id="${session.id}">
                                    <h3>${session.title}</h3>
                                    <p><strong>Date:</strong> ${session.date}</p>
                                </div>
                            `;
                            $('#upcoming-sessions').append(sessionHtml);
                        });

                        // Add click event listener to session items
                        $('.session-item').on('click', function () {
                            var sessionId = $(this).data('session-id'); // Get the session ID
                            window.location.href = '@Url.Action("Details", "Session")' + '/' + sessionId; // Redirect to Details page
                        });
                    } else {
                        // If no sessions are available, show a message
                        var noSessionsHtml = `
                            <div class="no-sessions-message">
                                <p>No Sessions Upcoming</p>
                            </div>
                        `;
                        $('#upcoming-sessions').append(noSessionsHtml);
                    }
                },
                error: function () {
                    $('#upcoming-sessions').html('<p>Error loading sessions.</p>');
                }
            });
        }
    </script>

    <!-- Upcoming Events List -->
    <script>
        $(document).ready(function () {
