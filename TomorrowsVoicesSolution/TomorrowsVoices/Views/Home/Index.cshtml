                            var eventHtml = `
                                <div class="event-item animate__animated animate__fadeIn" data-event-id="${event.id}">
                                    <h3>${event.title}</h3>
                                    <p><strong>Date:</strong> ${event.date}</p>
                                    <p><strong>Location:</strong> ${event.location}</p>
                                </div>
                            `;
                            $('#upcoming-events').append(eventHtml);
                        });

                        // Add click event listener to event items
                        $('.event-item').on('click', function () {
                            var eventId = $(this).data('event-id'); // Get the event ID
                            window.location.href = '@Url.Action("Details", "Event")' + '/' + eventId; // Redirect to Details page
                        });
                    } else {
                        // If no events are available, show a message
                        var noEventsHtml = `
