    <!-- Sessions Charts JS -->
    <!-- Doughnut Chart - Session by City -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            fetch('/Session/GetSessionsByCityData')
                .then(response => response.json())
                .then(data => {
