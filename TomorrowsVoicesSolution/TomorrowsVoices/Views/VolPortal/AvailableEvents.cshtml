@model IEnumerable<TomorrowsVoices.ViewModels.EventCardViewModel>
@{
    ViewData["Title"] = "Available Events";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<div class="volunteer-portal-header">
    <h1>Available Events</h1>
    <h2>Welcome, @ViewData["VolunteerName"]!</h2>
    <p class="welcome-message">Welcome, @ViewData["VolunteerName"]</p>
    <div class="portal-tabs">
        <a class="portal-tab active" href="@Url.Action("AvailableEvents")">Available Events</a>
        <a class="portal-tab" href="@Url.Action("MyEvents")">My Events</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        <p>There are no upcoming events available at this time.</p>
    </div>
}
else
{
    <div class="event-filters mb-4">
        <div class="form-group">
            <label for="eventFilter">Filter Events:</label>
            <select id="eventFilter" class="form-control">
                <option value="all">All Events</option>
                <option value="today">Today</option>
                <option value="week">This Week</option>
                <option value="month">This Month</option>
            </select>
        </div>
    </div>

    <div class="row event-cards">
        @foreach (var eventItem in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4 event-card-container"
                 data-event-date="@eventItem.Start.ToString("yyyyMMdd")"
                 data-registered="@eventItem.IsRegistered.ToString().ToLower()">
                <div class="card event-card h-100 @(eventItem.IsRegistered ? "registered" : "")">
                    <div class="card-header">
                        <h5 class="card-title">@eventItem.Title</h5>
                        <span class="badge @(eventItem.IsUpcoming ? "badge-primary" : eventItem.IsInProgress ? "badge-success" : "badge-secondary")">
                            @(eventItem.IsUpcoming ? "Upcoming" : eventItem.IsInProgress ? "In Progress" : "Past")
                        </span>
                        @if (eventItem.IsRegistered)
                        {
                            <span class="badge badge-success float-right">Registered</span>
                        }
                    </div>
                    <div class="card-body">
                        <div class="event-info">
                            <p><i class="fas fa-map-marker-alt"></i> @eventItem.Address</p>
                            <p><i class="fas fa-calendar-alt"></i> @eventItem.EventDate</p>
                            <p><i class="fas fa-clock"></i> @eventItem.EventTime</p>
                            <p><i class="fas fa-hourglass-half"></i> @eventItem.Duration</p>
                        </div>

                        @if (!string.IsNullOrEmpty(eventItem.Notes))
                        {
                            <div class="event-notes mt-3">
                                <p class="font-italic">@eventItem.Notes</p>
                            </div>
                        }

                        <div class="available-shifts mt-3">
                            <h6>Available Shifts:</h6>
                            @if (eventItem.Schedules.Any())
                            {
                                <ul class="shift-list">
                                    @foreach (var shift in eventItem.Schedules)
                                    {
                                        <li class="shift-item @(shift.IsRegistered ? "registered" : "")">
                                            <div class="shift-info">
                                                <span>@shift.TimeSlot</span>
                                                <span class="shift-duration">(@shift.Duration)</span>
                                            </div>
                                            <div class="shift-actions">
                                                @if (shift.IsRegistered)
                                                {
                                                    <span class="text-success">Registered</span>
                                                }
                                                else if (shift.Start > DateTime.Now)
                                                {
                                                    <form asp-action="SignUpForShift" method="post">
                                                        <input type="hidden" name="scheduleId" value="@shift.ScheduleId" />
                                                        <button type="submit" class="btn btn-sm btn-primary">Sign Up</button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Past</span>
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted">No shifts available for this event.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/js/volunteer-portal.js"></script>
    <script>
        $(document).ready(function() {
            initEventFilters();
        });
    </script>
}