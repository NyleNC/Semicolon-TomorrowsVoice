@model TomorrowsVoices.ViewModels.EventDetailsViewModel
@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h2>@Model.Title</h2>
            <p class="mb-0">@Model.Address, @Model.City</p>
        </div>
        <div class="card-body">
            <div class="event-info">
                <p><strong>Start:</strong> @Model.Start.ToString("MMM dd, yyyy h:mm tt")</p>
                <p><strong>End:</strong> @Model.End.ToString("MMM dd, yyyy h:mm tt")</p>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <p><strong>Notes:</strong> @Model.Notes</p>
                }
            </div>

            <div class="schedules mt-4">
                <h3>Schedules</h3>
                @foreach (var schedule in Model.Schedules)
                {
                    <div class="schedule-card">
                        <div class="schedule-header">
                            <h4>Shift: @schedule.Start.ToString("MMM dd, yyyy | h:mm tt") - @schedule.End.ToString("h:mm tt")</h4>
                            <span class="volunteer-count">
                                <i class="fas fa-users"></i>
                                @schedule.Volunteers.Count Volunteers
                            </span>
                            @if (User.IsInRole("Admin") || User.IsInRole("Director"))
                            {
                                <a href="@Url.Action("GenerateQRCode", new { scheduleId = schedule.ScheduleId })" 
                                   class="btn-qr-code">
                                    <i class="fas fa-qrcode"></i> Generate QR Code
                                </a>
                            }
                        </div>
                        <div class="volunteers-list">
                            @if (schedule.Volunteers.Any())
                            {
                                <div class="table-responsive rounded-3">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th class="fw-bold">Name</th>
                                                <th class="fw-bold">Contact</th>
                                                <th class="fw-bold">City</th>
                                                <th class="fw-bold">Check In/Out</th>
                                                <th class="fw-bold">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var volunteer in schedule.Volunteers)
                                            {
                                                <tr>
                                                    <td>@volunteer.FullName</td>
                                                    <td>
                                                        <a href="mailto:@volunteer.Email">@volunteer.Email</a><br />
                                                        @{
                                                            var phone = volunteer.Phone;
                                                            if (phone != null && phone.Length == 10)
                                                            {
                                                                @($"({phone.Substring(0,3)}) {phone.Substring(3,3)}-{phone.Substring(6)}")
                                                            }
                                                            else
                                                            {
                                                                @phone
                                                            }
                                                        }
                                                    </td>
                                                    <td>@volunteer.City</td>
                                                    <td>
                                                        @if (volunteer.ActualStart.HasValue)
                                                        {
                                                            <span class="badge bg-success">Checked In: @volunteer.ActualStart.Value.ToString("h:mm tt")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning">Not Checked In</span>
                                                        }
                                                        @if (volunteer.ActualEnd.HasValue)
                                                        {
                                                            <br />
                                                            <span class="badge bg-danger">Checked Out: @volunteer.ActualEnd.Value.ToString("h:mm tt")</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (User.IsInRole("Admin") || User.IsInRole("Director"))
                                                        {
                                                            <a href="@Url.Action("ManualCheckIn", new { attendanceId = volunteer.AttendanceId })"
                                                               class="btn btn-sm rounded-3" style="color: #6423e7; border-color: #6423e7">
                                                                <i class="fas fa-user-edit"></i> Manual Check-In/Out
                                                            </a>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No volunteers assigned to this shift.</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="card-footer">
            <a href="@Url.Action("AdminPortal")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Admin Portal
            </a>
        </div>
    </div>
</div>