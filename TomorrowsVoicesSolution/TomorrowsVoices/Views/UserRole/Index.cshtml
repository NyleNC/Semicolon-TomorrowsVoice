@model IEnumerable<TomorrowsVoices.ViewModels.UserVM>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
@{
    ViewBag.Title = "User Roles";
}

<h2>User Role Assignments</h2>

<div style="border: 3px solid #F1F1F1; border-radius: 12px; overflow: hidden; margin: 0; padding: 0">
<table class="table table-custom p-0 m-0">
        <thead >
            <tr >
                <th class="text-white">
            @Html.DisplayNameFor(model => model.UserName)
        </th>
                <th class="text-white">
            @Html.DisplayNameFor(model => model.UserRoles)
        </th>
        <th></th>
    </tr>
        </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.UserName)
            </td>
            <td>
                @{
                    foreach (var r in item.UserRoles)
                    {
                        @:  @r <br />
                    }
                }
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.Id })
            </td>
        </tr>
    }
        </tbody>
</table>
</div>