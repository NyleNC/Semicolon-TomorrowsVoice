@model TomorrowsVoices.ViewModels.UserVM

@{
    ViewData["Title"] = "Edit Roles";
}

<div class="d-flex align-items-center justify-content-between mb-2 g-2 mt-2">
    <div class="d-flex mt-0">
        <h1 class="mb-0">Edit User Roles</h1>
    </div>
</div>
<p>Assign roles to user: @Model.UserName</p>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            
            <div class="form-group mb-4">
                <label asp-for="UserName" class="control-label fw-bold">Username</label>
                <input asp-for="UserName" class="form-control" readonly="readonly"/>
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label fw-bold mb-3">Roles</label>
                <div class="row">
                    @{
                        int cnt = 0;
                        List<TomorrowsVoices.ViewModels.RoleVM> roles = ViewBag.Roles;
                        foreach (var role in roles)
                        {
                            if (cnt++ % 3 == 0)
                            {
                                @:</div><div class="row mt-2">
                            }
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input"
                                           name="selectedRoles"
                                           value="@role.RoleName"
                                           @(Html.Raw(role.Assigned ? "checked=\"checked\"" : "")) />
                                    <label class="form-check-label">@role.RoleName</label>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle"></i> Save Changes
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Users
                </a>
            </div>
        </form>
    </div>
</div>



