@model TomorrowsVoices.Models.VolLocation

@{
    ViewData["Title"] = "Details";
}

<h1>Location Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.City)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.City)
        </dd>
    </dl>
</div>
<div>
    <div class="mb-3">
        @if (!Model.IsArchived)
        {
            <a asp-action="Edit" asp-route-id="@Model?.ID" class="btn btn-warning">
                <img src="~/Images/edit-value.png" alt="Edit Values" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Edit
            </a>
        }
        else
        {
            <button class="btn btn-warning" disabled title="Archived Directors cannot be edited.">
                <img src="~/Images/edit-value.png" alt="Edit Values" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Edit
            </button>
        }
    </div>
    <a asp-action="Index" class="btn btn-secondary" style="margin-bottom: 100px"><img src="~/Images/previous-page-icon.png" alt="go to previous page icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Back to Locations Page</a>

</div>
