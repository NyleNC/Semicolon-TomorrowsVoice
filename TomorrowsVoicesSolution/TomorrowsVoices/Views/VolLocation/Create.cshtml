@model TomorrowsVoices.Models.VolLocation

@{
    ViewData["Title"] = "Create";
}

<h1>Create Location</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <p class="mb-4" style="font-weight: 700">Fields marked <span style="color: red">*</span> are required.</p>
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="City" class="control-label" style=" font-weight: 700">Location</label><span style="color: red">*</span>
                <input asp-for="City" class="form-control" id="City" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>

            <div class="form-group d-flex gap-2">
                <div class="form-group">
                    <button type="submit" class="btn btn-primary" title="Create a new Location">
                        <img src="~/Images/create-icon.png" alt="Create icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
                        Create
                    </button>
                </div>
                <div class="form-group">
                    <button type="button" id="fillPresetButton" class="btn btn-secondary" style="background-color: navy;" title="(Demo) Fill fields with preset values">Fill Preset Values</button>
                </div>
            </div>

            <a asp-action="Index" class="btn btn-secondary" title="Go back to Locations Index Page"><img src="~/Images/previous-page-icon.png" alt="go to previous page icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Back to Locations Page</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById("fillPresetButton").addEventListener("click", function () {
            // Preset Values
            let defaultValues = {
                City: "St. Catherines" // Example preset value for the City field
            };

            // Set fields only if they are empty
            let cityField = document.getElementById("City");
            if (!cityField.value) {
                cityField.value = defaultValues.City;
            }
        });
    </script>
}