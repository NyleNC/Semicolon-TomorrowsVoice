@model TomorrowsVoices.Models.Director
<link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Director</h4>
<hr />
<p class="mb-4 " style="font-weight: 700">Fields marked <span style="color: red">*</span> are required.</p>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">

                <label asp-for="FirstName" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="FirstName" class="form-control" placeholder="John" />

                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="LastName" class="form-control" placeholder="Doe" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LocationID" class="control-label">City</label>
                <select asp-for="LocationID" class="form-control city-dropdown" asp-items="ViewBag.CityList">
                    <option value="">-- Select City --</option>
                </select>
                <span asp-validation-for="LocationID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="Email" class="form-control" placeholder="example@tv.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group d-flex gap-2">
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                        <img src="~/Images/create-icon.png" alt="Create icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
                        Create

                    </button>
                </div>
                <div class="form-group">
                    <button type="button" id="fillPresetButton" class="btn btn-secondary" style="background-color: navy;">Fill Preset Values</button>
                </div>
            </div>
            <a asp-action="Index" class="btn btn-secondary"><img src="~/Images/previous-page-icon.png" alt="go to previous page icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Back to Director Page</a>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script>
       $(document).ready(function () {
        // Initialize the select2 dropdown with AJAX search
        $(".city-dropdown").select2({
            placeholder: "Select a city",
            allowClear: true,
            minimumInputLength: 1,  // Start searching after typing 1 character
            ajax: {
                url: '@Url.Action("CitySuggestions", "Director")',  // Your CitySuggestions action
                dataType: "json",
                delay: 250,
                data: function (params) {
                    return { term: params.term }; // Pass the search term
                },
                processResults: function (data, params) {
                    var results = $.map(data, function (item) {
                        return { id: item.id, text: item.text };
                    });

                    // If no results, add the "Add new City" option
                    if (params.term && results.length === 0) {
                        results.push({
                            id: "add_new_city",
                            text: `Add new City: "${params.term}"`,
                            newCityName: params.term
                        });
                    }

                    return { results: results };
                }
            }
        });

        // Fetch cities on page load and prepopulate dropdown
        loadCities();

        // Load all cities initially
        function loadCities() {
            $.ajax({
                url: '@Url.Action("GetInitialCities", "Director")', // Fetch all cities action
                type: "GET",
                success: function (data) {
                    var cityDropdown = $(".city-dropdown");
                    var options = [];

                    // Empty the existing options before appending new ones
                    cityDropdown.empty();

                    // Create options for all initial cities
                    $.each(data, function (index, item) {
                        options.push(new Option(item.text, item.id, false, false));
                    });

                    // Append all cities at once
                    cityDropdown.append(options).trigger("change");
                },
                error: function () {
                    alert("An error occurred while loading cities.");
                }
            });
        }

        // Handle selecting or typing a new city
        $(".city-dropdown").on("select2:select", function (e) {
            var newCityName = e.params.data.newCityName;

            // If "Add new City" was selected, add it
            if (e.params.data.id === "add_new_city" && newCityName) {
                addNewCity(newCityName);
            }
        }).on("select2:open", function () {
            var searchInput = $(".select2-search__field");
            searchInput.off("keydown").on("keydown", function (e) {
                if (e.key === "Enter") {
                    var currentValue = $(this).val();
                    if (currentValue) {
                        addNewCity(currentValue);
                    }
                }
            });
        });

        // Function to add a new city
        function addNewCity(cityName) {
            $.ajax({
                url: '@Url.Action("AddCity", "Director")',
                type: "POST",
                data: { cityName: cityName },
                success: function (response) {
                    if (response.success) {
                        alert(`${cityName} has been added to the list!`);

                        // Append the new city to the dropdown list
                        var cityDropdown = $(".city-dropdown");
                        var newOption = new Option(cityName, response.cityId, true, true);
                        cityDropdown.append(newOption).trigger("change"); // Append and trigger change event
                    } else {
                        alert("Error: " + response.message);
                    }
                },
                error: function () {
                    alert("An error occurred while adding the city.");
                }
            });
        }
    });


</script>



<script>
    document.getElementById("fillPresetButton").addEventListener("click", function () {
        // Preset Values
        let defaultValues = {
            FirstName: "John",
            LastName: "Williams",
            City: "Toronto",
            Email: "jwilliams@tv.com"
        };

        // Only set fields that are empty
        if (!document.getElementById("FirstName").value) {
            document.getElementById("FirstName").value = defaultValues.FirstName;
        }
        if (!document.getElementById("LastName").value) {
            document.getElementById("LastName").value = defaultValues.LastName;
        }
        if (!document.getElementById("Email").value) {
            document.getElementById("Email").value = defaultValues.Email;
        }
    });

</script>
