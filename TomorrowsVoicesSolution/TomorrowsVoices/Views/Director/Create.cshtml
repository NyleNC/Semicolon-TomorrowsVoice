@model TomorrowsVoices.Models.Director
<link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Director</h4>
<hr />
<p class="mb-4 " style="font-weight: 700">Fields marked <span style="color: red">*</span> are required.</p>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">

                <label asp-for="FirstName" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="FirstName" class="form-control" placeholder="John" />

                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="LastName" class="form-control" placeholder="Doe" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Location.City" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <select asp-for="Location.City" class="form-control city-dropdown" asp-items="ViewBag.CityList">
                    <option value="">Select a city</option>
                </select>
                <span asp-validation-for="Location.City" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="Email" class="form-control" placeholder="example@tv.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group d-flex gap-2">
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                        <img src="~/Images/create-icon.png" alt="Create icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
                        Create

                    </button>
                </div>
                <div class="form-group">
                    <button type="button" id="fillPresetButton" class="btn btn-secondary" style="background-color: navy;">Fill Preset Values</button>
                </div>
            </div>
            <a asp-action="Index" class="btn btn-secondary"><img src="~/Images/previous-page-icon.png" alt="go to previous page icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Back to Director Page</a>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script>
        $(document).ready(function () {
        $(".city-dropdown").select2({
            placeholder: "Select a city",
            allowClear: true,
            ajax: {
                url: '@Url.Action("CitySuggestions", "Director")',
                dataType: "json",
                delay: 250,
                data: function (params) {
                    return { term: params.term }; // pass the search term
                },
                processResults: function (data) {
                    var results = $.map(data, function (item) {
                        return { id: item.id, text: item.text }; // Use id and text as is
                    });

                    // If "Add new City" is not part of the data, add it as an option
                    if (!data.some(item => item.text === "Add new City")) {
                        results.push({
                            id: "Add new City",
                            text: "Add new City"
                        });
                    }

                    return { results: results };
                }
            },
            minimumInputLength: 1 // Minimum characters to trigger the search
        }).on("select2:select", function (e) {
            var selectedCity = e.params.data.text;

            // Check if the user selected the "Add new City" option
            if (selectedCity === "Add new City") {
                var cityName = e.params.data.id.replace("Add new City: '", "").replace("'", ""); // Get the city name entered by user
                addNewCity(cityName); // Call function to add the new city
            }
        });
    });

    function addNewCity(cityName) {
        $.ajax({
            url: '@Url.Action("AddCity", "Director")',
            type: "POST",
            data: { cityName: cityName },
            success: function (response) {
                if (response.success) {
                    alert("City added successfully!");

                    // After the city is added to the database, we can refresh the Select2 dropdown
                    // This ensures that the new city is fetched from the server and added correctly
                    $(".city-dropdown").val(cityName).trigger('change'); // Trigger change to select the new city

                } else {
                    alert("Error: " + response.message);
                }
            },
            error: function () {
                alert("An error occurred while adding the city.");
            }
        });
    }
</script>



<script>
    document.getElementById("fillPresetButton").addEventListener("click", function () {
        // Preset Values
        let defaultValues = {
            FirstName: "Exa",
            LastName: "Maple",
            City: "Barrie",
            Email: "emaple@tv.com"
        };

        // Only set fields that are empty
        if (!document.getElementById("FirstName").value) {
            document.getElementById("FirstName").value = defaultValues.FirstName;
        }
        if (!document.getElementById("LastName").value) {
            document.getElementById("LastName").value = defaultValues.LastName;
        }
        if (!document.getElementById("Email").value) {
            document.getElementById("Email").value = defaultValues.Email;
        }
    });

</script>
