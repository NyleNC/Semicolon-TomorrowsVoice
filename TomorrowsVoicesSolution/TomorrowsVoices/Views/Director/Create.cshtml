@model TomorrowsVoices.Models.Director
<link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Director</h4>
<hr />
<p class="mb-4 " style="font-weight: 500">Fields marked <span style="color: red">*</span> are required.</p>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">

                <label asp-for="FirstName" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="FirstName" class="form-control" placeholder="John" />

                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="LastName" class="form-control" placeholder="Doe" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Location.City" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <select asp-for="Location.City" class="form-control city-dropdown" asp-items="Html.GetEnumSelectList<City>()"></select>
                <span asp-validation-for="Location.City" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="Email" class="form-control" placeholder="example@tv.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
         
            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                <img src="~/Images/create-icon.png" alt="Create icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
					Create
                    
                </button>
            </div>
            <a asp-action="Index" class="btn btn-secondary"><img src="~/Images/previous-page-icon.png" alt="go to previous page icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Back to Director Page</a>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script>
    $(document).ready(function () {
        $("#City").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: '@Url.Action("CitySuggestions", "Director")',
                    type: "GET",
                    dataType: "json",
                    data: { term: request.term },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return { label: item, value: item };
                        }));
                    }
                });
            },
            minLength: 1,
            messages: {
                noResults: "No cities found",
                results: function () { return ""; }
            },
     open: function () {
               
                var autocompleteList = $(".ui-autocomplete");
                autocompleteList.css({
                    "max-height": "200px",  
                    "overflow-y": "auto", 
                     "overflow-x": "hidden"
                });
            }
        });
    });
       $(document).ready(function() {
        $('.city-dropdown').select2({
            placeholder: "Select a city",
            allowClear: true
        });
    });
</script>

<div class="form-group">
    <button type="button" id="fillPresetButton" class="btn btn-secondary">Fill Preset Values</button>
</div>

<script>
    document.getElementById("fillPresetButton").addEventListener("click", function () {
        // Preset Values
        let defaultValues = {
            FirstName: "Exa",
            LastName: "Maple",
            City: "Barrie",
            Email: "emaple@tv.com"
        };

        // Only set fields that are empty
        if (!document.getElementById("FirstName").value) {
            document.getElementById("FirstName").value = defaultValues.FirstName;
        }
        if (!document.getElementById("LastName").value) {
            document.getElementById("LastName").value = defaultValues.LastName;
        }
        if (!document.getElementById("Email").value) {
            document.getElementById("Email").value = defaultValues.Email;
        }
    });

    $(document).ready(function () {
        // Initialize Select2 for City dropdown
        $('.city-dropdown').select2({
            placeholder: "Select a city",
            allowClear: true
        });
    });
</script>