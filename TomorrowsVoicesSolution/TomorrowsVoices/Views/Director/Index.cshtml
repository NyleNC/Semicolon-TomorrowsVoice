@model IEnumerable<TomorrowsVoices.Models.Director>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

@{
    ViewData["Title"] = "Index";
    int index = 1;
}

<h1>Directors</h1>


<div class="d-flex justify-content-between align-items-start mb-3">
    <p class="mb-2">
        <a asp-action="Create" class="btn btn-primary">Add Director </a>
    </p>
    <div>
        <div class="text-danger">@Html.Raw(TempData["Feedback"])</div>

        <form asp-action="InsertFromExcel" asp-controller="Director" method="post" enctype="multipart/form-data">
    
            <div class="card-body">
                <div>
                    <div class="d-flex justify-content-end align-items-end mb-lg-5">
                        <div>
                            <label class="control-label custom-file-label">Upload Excel File:</label>

                            <input type="file" class="form-control" name="theExcel" id="theExcel" style="max-width: 300px;">
                        </div>
                        <input type="submit" value="Upload Data" class="btn btn-dark ms-2" />
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>


<form asp-action="Index" method="get">

<input type="hidden" name="sortDirection" value="@ViewData["sortDirection"]" />
<input type="hidden" name="sortField" value="@ViewData["sortField"]" />

<table class="table table-hover">
        <thead class="table-dark">
            
        <tr>
                <th class="d-none d-md-table-cell">
                    <button type="button" name="actionButton" value="#" class="btn btn-toolbar text-white"> #</button>
                </th>
                <th>

                    <button type="button" name="actionButton" value="Director" class="btn btn-toolbar text-white" onclick="handleSort(event, 'Director')">
                        Director 
                        @if (ViewData["sortField"]?.ToString() == "Director")
                        {
                            if (ViewData["sortDirection"]?.ToString() == "asc")
                            {
                                <i class="bi bi-sort-alpha-up ms-2"></i>
                            }
                            else
                            {
                                <i class="bi bi-sort-alpha-down ms-2"></i>
                            }
                        }
                    </button>
                </th>

                <th class="d-none d-md-table-cell">
                    <button type="button" value="City" class="btn btn-toolbar text-white"> City</button>
                </th>
                <th class="d-none d-md-table-cell">
                    <button type="button" name="actionButton" value="Email" class="btn btn-toolbar text-white"> Email</button>
                </th >
                <th class="d-none d-md-table-cell">
                    <button type="button" name="actionButton" value="Actions" class="btn btn-toolbar text-white"> Actions</button>
                </th>
        </tr>
 </thead>
    <tbody >
@foreach (var item in Model) {
        <tr >
            <td>
                @{@index}
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.DirectorFullName)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Location.City)
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            
            <td>
                <a asp-action="Edit" asp-route-id="@item.ID" class= "btn btn-sm btn-warning">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ID" class= "btn btn-sm btn-info">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ID" class= "btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
        index++;
}   
    </tbody>
</table>
</form>
<script>
    function handleSort(event, field) {
        event.preventDefault();  // Prevent the default button behavior (no page reload)

        // Toggle the sort direction based on the current direction
        var sortDirection = "@ViewData["sortDirection"]" === "asc" ? "desc" : "asc";

        // Set the sort field and direction values in hidden inputs
        document.querySelector("input[name='sortField']").value = field;
        document.querySelector("input[name='sortDirection']").value = sortDirection;

        // Submit the form to apply the sort without refreshing the page
        var form = event.target.closest('form');
        form.submit();  // Submits the form without reloading or scrolling
    }
</script>