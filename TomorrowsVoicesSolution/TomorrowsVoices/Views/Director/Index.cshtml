<form asp-action="Index" method="get">
    <input type="hidden" name="sortDirection" value="@ViewData["sortDirection"]" />
    <input type="hidden" name="sortField" value="@ViewData["sortField"]" />
    <div class="row">
        <div class="col-10">
            <button class="btn mb-3 @ViewData["Filtering"]" type="button" data-bs-toggle="collapse" id="filterToggle"
                    data-bs-target="#collapseFilter" aria-expanded="false" aria-controls="collapseFilter" style="background-color: #6423e7; color: white">
                <img src="~/Images/filter-search.png" alt="filter-search-icon" style="height: 24px; width: auto; margin-right: 10px" />
                Filter/Search (@ViewData["numberFilters"])
            </button>

            <!-- Conditionally render the "Clear" button -->
            @if (ViewData["numberFilters"] != null && (int)ViewData["numberFilters"] > 0)
            {
                <a asp-action="Index" class="mb-3 btn btn-danger text-white">
                    <img src="~/Images/clear-icon.png" alt="Clear filters icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
                    Clear
                </a>
            }
        </div>
    </div>
    <div class="collapse mb-3 @ViewData["ShowFilter"]" id="collapseFilter">
        <div class="card card-body" style="background-color:lightgray">
            <div class="row">
                <div class="form-group col-md-3">
                    <label class="control-label">Search by Director Name:</label>
                    @Html.TextBox("SearchString", null, new { @class = "form-control" })
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="control-label">Filter by City:</label>
                        @Html.DropDownList("SearchCity", (IEnumerable<SelectListItem>)ViewData["Cities"], new { @class = "form-control" })
                    </div>
                </div>
                <div class="form-group col-md-3">
                    <label class="control-label">Search by Email:</label>
                    @Html.TextBox("SearchEmail", null, new { @class = "form-control" })
                </div>
            </div>
            <div class="form-group col-md-2 align-self-start">
                <input type="submit" name="actionButton" value="Filter"
                       class="btn text-white" style="background-color: #6423e7" />
              
            </div>
        </div>
    </div>
    <table class="table table-striped table-hover table-custom">
        <thead class="table-dark">
            <tr>
                <th>
                        <button style="font-weight: 700" type="button" name="actionButton" value="Director" class="btn btn-toolbar text-white" onclick="handleSort(event, 'Director')">
                        Director
                        @if (ViewData["sortField"]?.ToString() == "Director")
                        {
                            if (ViewData["sortDirection"]?.ToString() == "asc")
                            {
                                <i class="bi bi-sort-alpha-up ms-2"></i>
                            }
                            else
                            {
                                <i class="bi bi-sort-alpha-down ms-2"></i>
                            }
                        }
                    </button>
                </th>
                <th>
                        <button style="font-weight: 700" type="button" name="actionButton" value="City" class="btn btn-toolbar text-white" onclick="handleSort(event, 'City')">
                        City
                        @if (ViewData["sortField"]?.ToString() == "City")
                        {
                            if (ViewData["sortDirection"]?.ToString() == "asc")
                            {
                                <i class="bi bi-sort-alpha-up ms-2"></i>
                            }
                            else
                            {
                                <i class="bi bi-sort-alpha-down ms-2"></i>
                            }
                        }
                    </button>
                </th>
                <th>
                        <button style="font-weight: 700" type="button" name="actionButton" value="Email" class="btn btn-toolbar text-white" onclick="handleSort(event, 'Email')">
                        Email
                        @if (ViewData["sortField"]?.ToString() == "Email")
                        {
                            if (ViewData["sortDirection"]?.ToString() == "asc")
                            {
                                <i class="bi bi-sort-alpha-up ms-2"></i>
                            }
                            else
                            {
                                <i class="bi bi-sort-alpha-down ms-2"></i>
                            }
                        }
                    </button>
                </th>
                <th>
                    <button style="font-weight: 700" type="button" name="actionButton" value="Actions" class="btn btn-toolbar text-white no-pointer-events">Actions</button>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @Html.DisplayFor(modelItem => item.DirectorFullName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Location.City)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Email)
                    </td>

                    <td>
                            <div class="d-none d-lg-inline">
                                <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning"><img src="~/Images/edit-value.png" alt="edit-icon" style="height: 24px; width: auto; margin-right: 10px" />Edit</a> |
                                <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info"><img src="~/Images/details.png" alt="details-icon" style="height: 24px; width: auto; margin-right: 10px" />Details</a> |
                            <a asp-action="Delete" asp-route-id="@item.ID" style="color:black; background-color:#fb606f" class="btn btn-sm btn-danger"><img src="~/Images/archive.png" alt="archive-icon" style="height: 24px; width: auto; margin-right: 10px;" />Delete</a>
                            </div>
                            <div class="d-lg-none">
                                <div class="btn-group">
                                <button class="btn btn-sm dropdown-toggle" style="background-color: #6423e7; color: white" data-bs-toggle="dropdown">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.ID">
                                                <img src="~/Images/edit-value.png" alt="edit-icon" style="height: 18px; width: auto; margin-right: 5px" /> Edit
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-action="Details" asp-route-id="@item.ID">
                                                <img src="~/Images/details.png" alt="details-icon" style="height: 18px; width: auto; margin-right: 5px" /> Details
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-action="Delete" asp-route-id="@item.ID">
                                                <img src="~/Images/archive.png" alt="archive-icon" style="height: 18px; width: auto; margin-right: 5px" /> Delete
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </td>
                </tr>
 
            }
        </tbody>
    </table>
    <partial name="_PagingNavBar" />
</form>


<script type="text/javascript">
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
    })      
    function handleSort(event, field) {
            event.preventDefault();
            const form = event.target.closest('form');
            const sortField = form.querySelector('input[name="sortField"]');
            const sortDirection = form.querySelector('input[name="sortDirection"]');

            if (sortField.value === field) {
                sortDirection.value = sortDirection.value === "asc" ? "desc" : "asc";
            } else {
                sortField.value = field;
                sortDirection.value = "asc";
            }
            form.submit();
        }

</script>
@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: '@TempData["SuccessMessage"]',
                confirmButtonText: 'OK'
            });
        });
    </script>
}