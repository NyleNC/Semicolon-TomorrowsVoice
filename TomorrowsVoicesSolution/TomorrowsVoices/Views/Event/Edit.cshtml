@using TomorrowsVoices.ViewModels
@model TomorrowsVoices.Models.Event

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Event</h1>
<hr />
<form asp-action="Edit" method="post">
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <label asp-for="Name" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="Name" class="form-control" id="eventName" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" id="eventDescription" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="VolLocationID" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <select asp-for="VolLocationID" class="form-control" asp-items="ViewBag.VolLocationID" id="eventLocation"></select>
            </div>
            <div class="form-group">
                <label asp-for="Date" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="Date" class="form-control" type="date" id="datePicker" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="StartTime" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                        <input asp-for="StartTime" class="form-control" type="time" id="eventStartTime" />
                        <span asp-validation-for="StartTime" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="EndTime" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                        <input asp-for="EndTime" class="form-control" type="time" id="eventEndTime" />
                        <span asp-validation-for="EndTime" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label asp-for="Notes" class="control-label"></label>
                <textarea asp-for="Notes" class="form-control" style="min-height: 116px; max-height: 116px;" id="eventNotes"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="container mt-5 ps-0">
        <div class="schedules-header">
            <h1 class="schedule-title" style="font-weight: 700">Schedules<span style="color: red">*</span></h1>
            <button type="button" id="add-schedule" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#createScheduleModal">
                Add Schedule
            </button>
        </div>
        <div id="schedule-container" class="row">
            <!-- Schedule cards will be generated here -->
            <div class="row">
                @if (ViewBag.ScheduleViewModel != null)
                {
                    var scheduleViewModel = ViewBag.ScheduleViewModel as ScheduleViewModel;

                    <!-- Morning Shift -->
                    <div class="col-lg-4 col-md-6 col-sm-12 p-2">
                        <div class="card" style="background-color: #e1ccfc">
                            <div class="card-body">
                                <div class="card-title" style="font-size: 17px; font-weight: 700;">
                                    Morning Shift (@scheduleViewModel.MorningShiftStartTime-@scheduleViewModel.MorningShiftEndTime)
                                </div>
                                <ul class="card-text list-unstyled" style="min-height: 130px; max-height: 130px; overflow-y: auto;">
                                    @foreach (var schedule in scheduleViewModel.MorningShifts)
                                    {
                                        <li>@schedule.Volunteer?.FullName</li>
                                        <small>
                                        (@scheduleViewModel.MorningActualStartTime - @scheduleViewModel.MorningShiftEndTime)
                                        </small>
                                        <div>
                                            <a asp-action="Edit" asp-controller="Schedule" asp-route-id="@schedule.ID" class="btn btn-primary btn-sm">Edit</a>
                                        </div>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Afternoon Shift -->
                    <div class="col-lg-4 col-md-6 col-sm-12 p-2">
                        <div class="card" style="background-color: #e1ccfc">
                            <div class="card-body">
                                <div class="card-title" style="font-size: 17px; font-weight: 700;">
                                    Afternoon Shift (@scheduleViewModel.AfternoonShiftStartTime - @scheduleViewModel.AfternoonShiftEndTime)
                                </div>
                                <ul class="card-text list-unstyled" style="min-height: 130px; max-height: 130px; overflow-y: auto;">
                                    @foreach (var schedule in scheduleViewModel.AfternoonShifts)
                                    {
                                        <li>@schedule.Volunteer?.FullName</li>
                                        <small>
                                            (@scheduleViewModel.AfternoonActualStartTime - @scheduleViewModel.AfternoonActualEndTime)
                                        </small>
                                        <div>
                                            <a asp-action="Edit" asp-controller="Schedule" asp-route-id="@schedule.ID" class="btn btn-primary btn-sm">Edit</a>
                                        </div>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Evening Shift -->
                    <div class="col-lg-4 col-md-6 col-sm-12 p-2">
                        <div class="card" style="background-color: #e1ccfc">
                            <div class="card-body">
                                <div class="card-title" style="font-size: 17px; font-weight: 700;">
                                    Evening Shift (@scheduleViewModel.EveningShiftStartTime-@scheduleViewModel.EveningShiftEndTime)
                                </div>
                                <ul class="card-text list-unstyled" style="min-height: 130px; max-height: 130px; overflow-y: auto;">
                                    @foreach (var schedule in scheduleViewModel.EveningShifts)
                                    {
                                        <li>@schedule.Volunteer?.FullName</li>
                                        <div>
                                            <a asp-action="Edit" asp-controller="Schedule" asp-route-id="@schedule.ID" class="btn btn-primary btn-sm">Edit</a>
                                        </div>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <p>No scheduled volunteers available.</p>
                }
            </div>
        </div>
    </div>


    <div id="attendance-container" style="padding-left: 0">
        <h2 class="attendance-header">Track Attendance</h2>
        <!-- Include a hidden field for all schedule IDs to ensure we track all of them -->
        <input type="hidden" name="allScheduleIds" id="allScheduleIds" value="@string.Join(",", (ViewBag.ScheduleViewModel as ScheduleViewModel).MorningShifts.Concat((ViewBag.ScheduleViewModel as ScheduleViewModel).AfternoonShifts).Concat((ViewBag.ScheduleViewModel as ScheduleViewModel).EveningShifts).Select(s => s.ID))" />

        <div class="row">
            <div class="col-lg-8 col-md-10 col-sm-12 col-12">
                <div class="accordion" id="attendanceAccordion">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Volunteer</th>
                                <th>Attendance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.ScheduleViewModel != null)
                            {
                                var scheduleViewModel = ViewBag.ScheduleViewModel as ScheduleViewModel;
                                var allShifts = scheduleViewModel.MorningShifts
                                .Concat(scheduleViewModel.AfternoonShifts)
                                .Concat(scheduleViewModel.EveningShifts);

                                foreach (var shift in allShifts)
                                {
                                    <tr>
                                        <td class="@(shift.IsPresent ? "present-row" : "absent-row")">@shift.Volunteer?.FullName</td>
                                        <td>
                                            <span class="attendance-icon" data-volunteer-id="@shift.ID" data-is-present="@shift.IsPresent.ToString().ToLower()">
                                                <span class="present-icon" style="display: @(shift.IsPresent ? "inline" : "none");">✔</span>
                                                <span class="absent-icon" style="display: @(shift.IsPresent ? "none" : "inline");">✖</span>
                                            </span>
                                            <!-- Use an actual input that will be part of the form data -->
                                            <input type="checkbox" name="presentSchedules" value="@shift.ID" @(shift.IsPresent ? "checked" : "") style="display:none;" class="presence-checkbox" id="checkbox-@shift.ID" />
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <span>No records found</span>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="container mt-4 ps-0">
        <div class="row">
            <div class="col-md-4 d-flex gap-2">

                <div class="form-group">
                    <button type="submit" class="btn btn-success">
                        <img src="~/Images/save-changes-icon.png" alt="Save changes" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
                        Save
                    </button>
                </div>

            </div>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-secondary" style="margin-bottom: 100px"><img src="~/Images/previous-page-icon.png" alt="go to previous page icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Back to Events Page</a>
</form>

<!-- Create Schedule Modal -->
<div class="modal fade" id="createScheduleModal" tabindex="-1" aria-labelledby="createScheduleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createScheduleModalLabel">Create New Schedules</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createScheduleForm" method="post" >
                    <div id="scheduleRows">
                        <!-- Initial Schedule Row -->
                        <div class="schedule-row border p-3 mb-3">
                            <div class="form-group">
                                <label>Shift Start</label>
                                <input type="time" class="form-control" name="Schedules[0].ShiftStart" required>
                            </div>
                            <div class="form-group">
                                <label>Shift End</label>
                                <input type="time" class="form-control" name="Schedules[0].ShiftEnd" required>
                            </div>
                            <div class="form-group">
                                <label>Volunteer</label>
                                <select class="form-control" name="Schedules[0].VolunteerID" required>
                                    <option value="">Select a Volunteer</option>
                                    @foreach (var volunteer in ViewBag.Volunteers)
                                    {
                                        <option value="@volunteer.ID">@volunteer.FullName</option>
                                    }
                                </select>
                            </div>
                            <button type="button" class="btn btn-danger btn-sm remove-schedule">Remove</button>
                        </div>
                    </div>
                    <button type="button" id="addSchedule" class="btn btn-secondary btn-sm">Add Another Schedule</button>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" form="createScheduleForm" class="btn btn-primary">Create Schedules</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {



    <script>
        <script>
          $(document).ready(function () {
              let rowCount = 1; // Start from 1 because the first row is already present

              // Add a new schedule row
              $('#addSchedule').on('click', function () {
                  const newRow = `
                      <div class="schedule-row border p-3 mb-3">
                          <div class="form-group">
                              <label>Shift Start</label>
                              <input  type="time" class="form-control" name="Schedules[${rowCount}].ShiftStart" required>
                          </div>
                          <div class="form-group">
                              <label>Shift End</label>
                              <input type="time"" class="form-control" name="Schedules[${rowCount}].ShiftEnd" required>
                          </div>
                          <div class="form-group">
                              <label>Event</label>
                              <select class="form-control" name="Schedules[${rowCount}].eventID" required>
                                  <option value="">Select an Event</option>
        @foreach (var eventItem in ViewBag.Events)
        {
                                                  <option value="@eventItem.ID">@eventItem.Name</option>
        }
                              </select>
                          </div>
                          <div class="form-group">
                              <label>Volunteer</label>
                              <select class="form-control" name="Schedules[${rowCount}].volunteerID" required>
                                  <option value="">Select a Volunteer</option>
        @foreach (var volunteer in ViewBag.Volunteers)
        {
                                                  <option value="@volunteer.ID">@volunteer.FullName</option>
        }
                              </select>
                          </div>
                          <button type="button" class="btn btn-danger btn-sm remove-schedule">Remove</button>
                      </div>
                  `;
                  $('#scheduleRows').append(newRow);
                  rowCount++;
              });

              // Remove a schedule row
              $(document).on('click', '.remove-schedule', function () {
                  $(this).closest('.schedule-row').remove();
                  rowCount--; // Decrement row count
              });

              // Submit the form via AJAX
              $('#createScheduleForm').on('submit', function (e) {
                  e.preventDefault(); // Prevent the default form submission

                  $.ajax({
                      url: '@Url.Action("CreateMultiple", "Event")',
                      type: 'POST',
                      data: $(this).serialize(),
                      success: function (response) {
                          if (response.success) {
                              $('#createScheduleModal').modal('hide'); // Close the modal
                              location.reload(); // Refresh the page to show the new schedules
                          } else {
                              alert('Error: ' + response.message); // Show error message
                          }
                      },
                      error: function (xhr, status, error) {
                          // Log the full error response
                          console.log(xhr.responseText);
                          alert('An error occurred: ' + xhr.responseText);
                      }
                  });
              });
          });
    </script>

    <script>
                                      document.addEventListener('DOMContentLoaded', function () {
            const attendanceIcons = document.querySelectorAll('.attendance-icon');

            attendanceIcons.forEach(icon => {
                icon.addEventListener('click', function (event) {
                    event.stopPropagation();

                    const volunteerId = this.getAttribute('data-volunteer-id');
                    let isPresent = this.getAttribute('data-is-present') === 'true';
                    const presentIcon = this.querySelector('.present-icon');
                    const absentIcon = this.querySelector('.absent-icon');

                    // Toggle attendance status
                    isPresent = !isPresent;
                    this.setAttribute('data-is-present', isPresent.toString());

                    // Update icons
                    if (isPresent) {
                        presentIcon.style.display = 'inline';
                        absentIcon.style.display = 'none';
                    } else {
                        presentIcon.style.display = 'none';
                        absentIcon.style.display = 'inline';
                    }

                    // Update the checkbox (this will be part of the form submission)
                    const checkbox = document.getElementById('checkbox-' + volunteerId);
                    if (checkbox) {
                        checkbox.checked = isPresent;
                    }

                    // Update row style
                    const volunteerRow = this.closest('tr').querySelector('td:first-child');
                    if (volunteerRow) {
                        if (isPresent) {
                            volunteerRow.classList.remove('absent-row');
                            volunteerRow.classList.add('present-row');
                        } else {
                            volunteerRow.classList.remove('present-row');
                            volunteerRow.classList.add('absent-row');
                        }
                    }

                    // Display message
                    const message = isPresent ? 'The volunteer has been marked present' : 'The volunteer has been marked absent';
                    alert(message);
                });
            });
        });
    </script>
}


<style>
    .present-row {
        background-color: lightgreen;
    }

    .absent-row {
        background-color: lightcoral;
    }

    .attendance-icon {
        font-size: 1.2em;
        cursor: pointer;
    }

    .present-icon {
        color: darkgreen;
    }

    .absent-icon {
        color: darkred;
    }
</style>