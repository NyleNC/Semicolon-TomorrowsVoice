@using TomorrowsVoices.ViewModels
@model EventCreateVM

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Event</h1>


<hr />
<form id="eventForm" asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <label asp-for="Event.Name" class="control-label"></label>
                <input asp-for="Event.Name" class="form-control" id="eventName" />
                <span asp-validation-for="Event.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Event.Location" class="control-label"></label>
                <textarea asp-for="Event.Location" class="form-control" id="eventDescription"></textarea>
                <span asp-validation-for="Event.Location" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Event.VolLocationID" class="control-label"></label>
                <select asp-for="Event.VolLocationID" class="form-control" asp-items="ViewBag.VolLocationID" required></select>
            </div>
            <div class="form-group">
                <label asp-for="Event.Start" class="control-label">Date*</label>
                <input asp-for="Event.Start" type="date" class="form-control" required />
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Event.Start" class="control-label">Start Time*</label>
                        <input asp-for="Event.Start" type="time" class="form-control" required />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Event.End" class="control-label">End Time*</label>
                        <input asp-for="Event.End" type="time" class="form-control" required />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Event.Notes" class="control-label">Notes</label>
                <textarea asp-for="Event.Notes" class="form-control"></textarea>
            </div>
        </div>
    </div>
    <h3>Schedules <button type="button" id="newScheduleBtn" class="btn btn-sm btn-primary">+</button></h3>

    <div id="scheduleTabs" class="mb-3">
        <!-- Schedule tabs will be dynamically added here -->
        @if (Model.ExistingSchedules != null && Model.ExistingSchedules.Any())
        {
            <ul class="nav nav-tabs" id="schedulesTab" role="tablist">
                @for (int i = 0; i < Model.ExistingSchedules.Count; i++)
                {
                    <li class="nav-item">
                        <a class="nav-link @(i == 0 ? "active" : "")" id="schedule-@i-tab" data-toggle="tab"
                           href="#schedule-@i" role="tab">
                            Schedule @(i + 1)       
                            <button type="button" class="btn btn-warning edit-schedule mx-2" data-schedule-index="@i">
                                <img src="http://localhost:5091/Images/icons8-edit-48 (1).png" alt="Edit Values" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: 0px; margin-right: 8px">Edit
                            </button>
                            <button type="button" class="close remove-schedule" data-schedule-index="@i">&times;</button>
                        </a>
                    </li>
                }
            </ul>
        }
    </div>

    <div id="scheduleContent" class="tab-content mb-4">
        <!-- Schedule content will be dynamically added here -->
        @if (Model.ExistingSchedules != null && Model.ExistingSchedules.Any())
        {
            @for (int i = 0; i < Model.ExistingSchedules.Count; i++)
            {
                <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="schedule-@i" role="tabpanel">
                    @Html.Hidden($"ExistingSchedules[{i}].ScheduleId", Model.ExistingSchedules[i].ScheduleID)
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Start Time</label>
                                <input type="datetime-local" class="form-control"
                                       name="ExistingSchedules[@i].ScheduledStart"
                                       value="@Model.ExistingSchedules[i].ScheduledStart.ToString("yyyy-MM-ddTHH:mm")" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>End Time</label>
                                <input type="datetime-local" class="form-control"
                                       name="ExistingSchedules[@i].ScheduledEnd"
                                       value="@Model.ExistingSchedules[i].ScheduledEnd.ToString("yyyy-MM-ddTHH:mm")" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Selected Volunteers</label>
                        <div class="selected-volunteers">
                            @foreach (var volunteerId in Model.ExistingSchedules[i].VolunteerIds)
                            {
                                var volunteer = Model.Event.VolSchedules
                                .SelectMany(s => s.VolAttendances)
                                .FirstOrDefault(a => a.VolunteerID == volunteerId)?.Volunteer;
                                if (volunteer != null)
                                {
                                    <div>@volunteer.FullName</div>
                                }
                            }
                        </div>
                        <div class="selected-volunteer-ids">
                            @foreach (var volunteerId in Model.ExistingSchedules[i].VolunteerIds)
                            {
                                <input type="hidden" name="ExistingSchedules[@i].VolunteerIds[]" value="@volunteerId" />
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Schedule Form Modal -->
    <div class="modal fade" id="scheduleModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Schedule</h5>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    @Html.Partial("_SchedulePartial", new ScheduleVM())
                </div>
            </div>
        </div>
    </div>
 <div class="form-group">
        <button type="submit" class="btn btn-success">
            <img src="~/Images/save-changes-icon.png" alt="Save changes" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
            Save
        </button>
        <a asp-action="Index" class="btn btn-secondary"><img src="~/Images/previous-page-icon.png" alt="go to previous page icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Back to Events Page</a>
    </div>
</form>


@section Scripts {
    <script>
        // Declare originalAvailOptions at a higher scope
        let originalAvailOptions;

        $(document).ready(function () {
            // Store the original options when the document loads
            originalAvailOptions = $("#availOptions").html();

            // Add new schedule button event handler
            $("#newScheduleBtn").click(function () {
                $("input[name='NewSchedule.ScheduledStart']").val('');
                $("input[name='NewSchedule.ScheduledEnd']").val('');

                $("#availOptions").html(originalAvailOptions);
                $("#selectedOptions").empty();

                // Set modal title and button text for adding
                $(".modal-title").text("Add Schedule");
                $("#addScheduleBtn").text("Add Schedule").removeData("schedule-index");

                $("#scheduleModal").modal("show");
            });

            // Move volunteers left to right (select)
            $("#btnLeft").click(function () {
                $("#availOptions option:selected").each(function () {
                    $("#selectedOptions").append($(this));
                });
            });

            // Move volunteers right to left (deselect)
            $("#btnRight").click(function () {
                $("#selectedOptions option:selected").each(function () {
                    $("#availOptions").append($(this));
                });
            });

            // Edit schedule button event handler - must use on() for dynamically created elements
                   $(document).on("click", ".edit-schedule", function(e) {
            e.preventDefault();

            const scheduleIndex = $(this).data("schedule-index");
            const scheduleTab = $(`#schedule-${scheduleIndex}`);

            // Extract current values
            const scheduleId = scheduleTab.find("input[name$='.ScheduleId']").val();
            const scheduledStart = scheduleTab.find("input[name$='.ScheduledStart']").val();
            const scheduledEnd = scheduleTab.find("input[name$='.ScheduledEnd']").val();

            // Set values in the modal
            $("input[name='NewSchedule.ScheduledStart']").val(scheduledStart);
            $("input[name='NewSchedule.ScheduledEnd']").val(scheduledEnd);

            // Clear and repopulate volunteer selections
            $("#selectedOptions").empty();
            $("#availOptions").html(originalAvailOptions);

            // Get selected volunteers from the schedule
            const selectedVolunteerIds = [];
            scheduleTab.find("input[name$='.VolunteerIds[]']").each(function() {
                selectedVolunteerIds.push($(this).val());
            });

            // Move volunteers from available to selected in the modal
            selectedVolunteerIds.forEach(id => {
                const option = $(`#availOptions option[value='${id}']`);
                if (option.length > 0) {
                    option.appendTo("#selectedOptions");
                }
            });

            // Change modal title and button text
            $(".modal-title").text("Edit Schedule");
            $("#addScheduleBtn").text("Update Schedule").data("schedule-index", scheduleIndex);

            $("#scheduleModal").modal("show");
        });

            // Remove schedule button event handler
            $(document).on("click", ".remove-schedule", function(e) {
                e.preventDefault();
                e.stopPropagation();

                const scheduleIndex = $(this).data("schedule-index");

                // Remove the tab and its content
                $(`#schedule-${scheduleIndex}-tab`).parent().remove();
                $(`#schedule-${scheduleIndex}`).remove();

                // If there are remaining tabs, activate the first one
                if ($("#schedulesTab .nav-item").length > 0) {
                    $("#schedulesTab .nav-link:first").tab("show");
                }

                // Renumber the remaining tabs
                $("#schedulesTab .nav-item").each(function(i) {
                    const link = $(this).find("a.nav-link");
                    link.text(` Schedule ${i + 1} `);
                    link.find(".edit-schedule, .remove-schedule").remove();
                    link.append(`    <button type="button" class="btn btn-warning edit-schedule mx-2" data-schedule-index="${scheduleIndex}">
                                    <img src="http://localhost:5091/Images/icons8-edit-48 (1).png" alt="Edit Values" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: 0px; margin-right: 8px">Edit
                                </button>
                                <button type="button" class="close remove-schedule" data-schedule-index="${i}">&times;</button>`);
                });
            });

            // Add schedule button event handler
            $("#addScheduleBtn").click(function () {
                const scheduledStart = $("input[name='NewSchedule.ScheduledStart']").val();
                const scheduledEnd = $("input[name='NewSchedule.ScheduledEnd']").val();
                const selectedVolunteers = $("#selectedOptions option").length > 0 ?
                                          $("#selectedOptions option") : [];

                // Validation code
                $(".schedule-form .error-message").remove();
                let isValid = true;

                if (!scheduledStart) {
                    $("input[name='NewSchedule.ScheduledStart']").after('<div class="error-message text-danger">Start time is required</div>');
                    isValid = false;
                }

                if (!scheduledEnd) {
                    $("input[name='NewSchedule.ScheduledEnd']").after('<div class="error-message text-danger">End time is required</div>');
                    isValid = false;
                }

                if (selectedVolunteers.length === 0) {
                    $("#selectedOptions").after('<div class="error-messa ge text-danger">At least one volunteer must be selected</div>');
                    isValid = false;
                }

                if (!isValid) {
                    return;
                }

                // Check if we're editing or adding
                const isEdit = $(this).text() === "Update Schedule";
                const scheduleIndex = isEdit ? $(this).data("schedule-index") : $(".nav-tabs .nav-item").length;

                // Create HTML for volunteers
                let volunteersHtml = '';
                let volunteerIdsHtml = '';

                selectedVolunteers.each(function () {
                    volunteersHtml += `<div>${$(this).text()}</div>`;
                    volunteerIdsHtml += `<input type="hidden" name="ExistingSchedules[${scheduleIndex}].VolunteerIds[]" value="${$(this).val()}" />`;
                });

                if (isEdit) {
                    // Update existing tab content
                    const scheduleId = $(`#schedule-${scheduleIndex} input[name$='.ScheduleId']`).val();

                    const tabContent = `
                        <input type="hidden" name="ExistingSchedules[${scheduleIndex}].ScheduleId" value="${scheduleId}" />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Start Time</label>
                                    <input type="datetime-local" class="form-control"
                                           name="ExistingSchedules[${scheduleIndex}].ScheduledStart"
                                           value="${scheduledStart}" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>End Time</label>
                                    <input type="datetime-local" class="form-control"
                                           name="ExistingSchedules[${scheduleIndex}].ScheduledEnd"
                                           value="${scheduledEnd}" />
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Selected Volunteers</label>
                            <div class="selected-volunteers">
                                ${volunteersHtml}
                            </div>
                            <div class="selected-volunteer-ids">
                                ${volunteerIdsHtml}
                            </div>
                        </div>
                    `;

                    $(`#schedule-${scheduleIndex}`).html(tabContent);
                } else {
                    // Code for adding a new schedule
                    const tabItem = `
                        <li class="nav-item">
                            <a class="nav-link ${scheduleIndex === 0 ? 'active' : ''}"
                               id="schedule-${scheduleIndex}-tab"
                               data-toggle="tab"
                               href="#schedule-${scheduleIndex}" role="tab">
                                Schedule ${scheduleIndex + 1}
                                 <button type="button" class="btn btn-warning edit-schedule mx-2" data-schedule-index="${scheduleIndex}">
                                    <img src="http://localhost:5091/Images/icons8-edit-48 (1).png" alt="Edit Values" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: 0px; margin-right: 8px">Edit
                                </button>
                                <button type="button" class="close remove-schedule" data-schedule-index="${scheduleIndex}">&times;</button>
                            </a>
                        </li>
                    `;

                    const tabContent = `
                        <div class="tab-pane fade ${scheduleIndex === 0 ? 'show active' : ''}"
                             id="schedule-${scheduleIndex}" role="tabpanel">
                            <input type="hidden" name="ExistingSchedules[${scheduleIndex}].ScheduleId" value="" />
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Start Time</label>
                                        <input type="datetime-local" class="form-control"
                                               name="ExistingSchedules[${scheduleIndex}].ScheduledStart"
                                               value="${scheduledStart}" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>End Time</label>
                                        <input type="datetime-local" class="form-control"
                                               name="ExistingSchedules[${scheduleIndex}].ScheduledEnd"
                                               value="${scheduledEnd}" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Selected Volunteers</label>
                                <div class="selected-volunteers">
                                    ${volunteersHtml}
                                </div>
                                <div class="selected-volunteer-ids">
                                    ${volunteerIdsHtml}
                                </div>
                            </div>
                        </div>
                    `;

                    if (scheduleIndex === 0) {
                        $("#scheduleTabs").html(`<ul class="nav nav-tabs" id="schedulesTab" role="tablist">${tabItem}</ul>`);
                    } else {
                        $("#schedulesTab").append(tabItem);
                    }

                    $("#scheduleContent").append(tabContent);
                }

                // Show the tab for the schedule we just added/edited
                $(`#schedule-${scheduleIndex}-tab`).tab("show");

                // Hide the modal
                $("#scheduleModal").modal("hide");

                // Reset the modal for next use
                $(".modal-title").text("Add Schedule");
                $("#addScheduleBtn").text("Add Schedule").removeData("schedule-index");
            });

            // Ensure tab functionality works for dynamically created tabs
            $(document).on("click", "a[data-toggle='tab']", function (e) {
                e.preventDefault();
                $(this).tab("show");
            });
        });
    </script>
}