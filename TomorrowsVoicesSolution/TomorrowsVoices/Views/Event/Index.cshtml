<!-- Sorting and JS Script -->
<script>
    function handleSort(event, field) {
        event.preventDefault();
        const form = event.target.closest('form');
        const sortField = form.querySelector('input[name="sortField"]');
        const sortDirection = form.querySelector('input[name="sortDirection"]');

        if (sortField.value === field) {
            // Toggle sort direction
            sortDirection.value = sortDirection.value === "asc" ? "desc" : "asc";
        } else {
            // Set new field and default to ascending order
            sortField.value = field;
            sortDirection.value = "asc";
        }

        // Submit the form
        form.submit();
    }
</script>

<!-- POP UP MODAL SCRIPT -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const dropArea = document.getElementById('dropArea'); // Drag-and-drop area
        const fileInput = document.getElementById('theExcel'); // File input element
        const browseLink = document.getElementById('browseLink'); // Browse link

        // Make the entire drop area clickable
        dropArea.addEventListener('click', () => {
            fileInput.click();
        });

        // Drag and drop functionality
        dropArea.addEventListener('dragover', (event) => {
            event.preventDefault();
            dropArea.classList.add('dragover'); // Add visual feedback for drag-over
        });

        dropArea.addEventListener('dragleave', () => {
            dropArea.classList.remove('dragover'); // Remove visual feedback when leaving
        });

        dropArea.addEventListener('drop', (event) => {
            event.preventDefault();
            dropArea.classList.remove('dragover'); // Remove visual feedback after drop
            fileInput.files = event.dataTransfer.files; // Assign dropped files to the input
            updateDropText(); // Update the drop area text
        });

        // Update drop area text when a file is selected
        fileInput.addEventListener('change', () => {
            updateDropText();
        });

        // Function to update the drop area text with the selected file name
        function updateDropText() {
            if (fileInput.files.length > 0) {
                dropArea.querySelector('.import-excel-drop-text').textContent = fileInput.files[0].name;
            }
        }

        // Handle form submission
        const form = document.querySelector('form'); // Select the form element
        form.addEventListener('submit', function (e) {
            e.preventDefault(); // Prevent the default form submission

            var alertDiv = document.getElementById('importAlert'); // Feedback alert div

            // Validate if a file is selected
            if (fileInput.files.length === 0) {
                fileInput.classList.add("is-invalid"); // Show invalid feedback
                alertDiv.classList.remove("d-none", "alert-success");
                alertDiv.classList.add("alert-danger");
                alertDiv.innerHTML = "Please select a valid Excel file.";
                return;
            } else {
                fileInput.classList.remove("is-invalid"); // Remove invalid feedback
            }

            // Create FormData object for AJAX submission
            var formData = new FormData(form);

            // Submit the form via AJAX
            $.ajax({
                url: form.action, // Use the form's action URL
                type: 'POST',
                data: formData,
                contentType: false, // Required for file uploads
                processData: false, // Required for file uploads
                success: function (response) {
                    if (response.success) {
                        // Show success alert in a separate pop-up window
                        alert("Upload process completed successfully!");
                        // Close the modal after successful upload
                        $('#importExcelModal').modal('hide');
                        // Optionally, reload the page or update the UI as needed
                        setTimeout(() => location.reload(), 2000); // Reload page after success
                    } else {
                        // Keep the modal open and display the error message
                        alertDiv.classList.remove("d-none", "alert-success");
                        alertDiv.classList.add("alert-danger");
                        alertDiv.innerHTML = response.message;
                    }
                },
                error: function (xhr, status, error) {
                    // Keep the modal open and display the error message
                    alertDiv.classList.remove("d-none", "alert-success");
                    alertDiv.classList.add("alert-danger");
                    alertDiv.innerHTML = "An error occurred while uploading the file: " + error;
                }
                    });
            }
        }
    });
</script>


<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Make sure DOM is fully loaded
        const filteredExportBtn = document.getElementById('filteredExportBtn');

        if (filteredExportBtn) {
            filteredExportBtn.addEventListener('click', function() {
                console.log('Export filtered button clicked'); // Debugging line

                // Get all applied filter values directly from the URL query parameters
                const searchParams = new URLSearchParams(window.location.search);

                // Check if we have any filters applied
                const hasFilters = searchParams.has('SearchString') ||
                                    searchParams.has('SearchCity') ||
                                    searchParams.has('StartDate') ||
                                    searchParams.has('EndDate') ||
                                    searchParams.has('StartTime') ||
                                    searchParams.has('EndTime');

                if (!hasFilters) {
                    // Show message modal if no filters are applied
                    const messageModal = document.getElementById('messageModal');
                    document.getElementById('messageModalBody').textContent = 'Please apply at least one filter before exporting filtered data.';

                    // Use vanilla JS to show the modal
                    if (typeof bootstrap !== 'undefined') {
                        const bsModal = new bootstrap.Modal(messageModal);
                        bsModal.show();
                    } else {
                        // Fallback for when bootstrap is not available
                        messageModal.style.display = 'block';
                        messageModal.classList.add('show');
                    }
                    return;
                }

                // Construct the URL with all the current filter parameters
                let exportUrl = '@Url.Action("FilteredEventReportExport", "Event")';

                // Use all URL parameters to ensure we're passing everything
                exportUrl += '?' + searchParams.toString();

                console.log('Export URL:', exportUrl); // Debugging line

                // Navigate to the export URL, which will trigger the file download
                window.location.href = exportUrl;
            });
        }
    });
</script>
