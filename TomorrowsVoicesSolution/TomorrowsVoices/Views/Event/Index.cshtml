@model IEnumerable<TomorrowsVoices.Models.Event>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
@{
    ViewData["Title"] = "Index";
    bool isArchived = ViewData["IsArchived"] as bool? ?? false;
}
<div class="d-flex align-items-center justify-content-between mb-2 g-2 mt-2">
    <!-- Events Heading --> 
    <div class="d-flex mt-0">
        <h1 class="mb-0">Events</h1>
    </div>
    <div>
        <a href="@Url.Action("ExportEventsToExcel", "Event")" class="btn btn-white me-2">
            <img src="~/Images/dark-export-icon.png" alt="export-icon" style="height: 24px; width: auto; margin-right: 10px" />
            Export
        </a>
        <button id="filteredExportBtn" class="btn btn-white me-2">
            <img src="~/Images/dark-export-icon.png" alt="export-icon" style="height: 24px; width: auto; margin-right: 10px" />Export Filtered
        </button>
        <a asp-action="Create" class="btn btn-primary float-end"><img src="~/Images/create-icon.png" alt="add-event-icon" style="height: 24px; width: auto; margin-right: 8px" />Add New</a>
    </div>
</div>
<p>View your Event and Attendance records.</p>

@* Container for all tabs *@
<div class="nav-container mb-3">
    <a class="nav-tab @(ViewData["ActiveTab"]?.ToString() == "active" ? "active" : "")"
       asp-action="Index" asp-route-archived="false">
        Active
        @if (ViewData["numberofActive"] != null && (int)ViewData["numberofActive"] == 0)
        {
            <span class="nav-tab-count  @(ViewData["ActiveTab"]?.ToString() == "active" ? "active" : "")">0</span>
        }
        else
        {
            <span class="nav-tab-count  @(ViewData["ActiveTab"]?.ToString() == "active" ? "active" : "")">@ViewData["numberofActive"]</span>
        }
    </a>
    <a class="nav-tab @(ViewData["ActiveTab"]?.ToString() == "archived" ? "active" : "")"
       asp-action="Index" asp-route-archived="true">
        Archive
        @if (ViewData["numberofArchive"] != null && (int)ViewData["numberofArchive"] == 0)
        {
            <span class="nav-tab-count  @(ViewData["ActiveTab"]?.ToString() == "archived" ? "active" : "")">0</span>
        }
        else
        {
            <span class="nav-tab-count  @(ViewData["ActiveTab"]?.ToString() == "archived" ? "active" : "")">@ViewData["numberofArchive"]</span>
        }
    </a>
</div>

<!-- Modal -->
<!-- Import Excel Modal -->
<div class="modal fade" id="importExcelModal" tabindex="-1" aria-labelledby="importExcelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered import-excel-modal">
        <!-- Added custom class `import-excel-modal` -->
        <div class="modal-content import-excel-modal-content">
            <!-- Added custom class `import-excel-modal-content` -->
            <div class="modal-header bg-primary text-white imprt-excl-modal-header">
                <h5 class="modal-title" id="importExcelModalLabel">Import Excel File</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body h-100 import-excel-modal-body">
                <!-- Added custom class `import-excel-modal-body` -->
                <div class="row h-100">
                    <!-- Left Partition: Upload and Text Information -->
                    <div class="col-md-6 d-flex flex-column justify-content-between">
                        <!-- Feedback Alert -->
                        <div id="importAlert" class="alert @(TempData["Feedback"] != null ? "alert-success" : "d-none") import-excel-alert">
                            <!-- Added custom class `import-excel-alert` -->
                            @Html.Raw(TempData["Feedback"])
                        </div>

                        <!-- Prompt Above the Drag-and-Drop Area -->
                        <div class="mb-3">
                            <p>
                                Make sure you're using the correct sample file. Don't have one?
                                <a href="@Url.Action("DownloadSampleExcel", "Event")" download class="import-excel-download-link">Download</a> a sample Excel file.
                            </p>
                        </div>

                        <!-- Form for Uploading Excel File -->
                        <form asp-action="InsertFromExcel" asp-controller="Event" method="post" enctype="multipart/form-data" class="h-100 d-flex flex-column justify-content-between">
                            <div class="mb-3 flex-grow-1 d-flex flex-column justify-content-center">
                                <!-- Drag-and-Drop Area -->
                                <div id="dropArea" class="drop-area import-excel-drop-area flex-grow-1 d-flex align-items-center justify-content-center">
                                    <!-- Added custom class `import-excel-drop-area` -->
                                    <span class="drop-text import-excel-drop-text">
                                        <!-- Added custom class `import-excel-drop-text` -->
                                        <a href="#" id="browseLink" class="import-excel-browse-link">Browse your files</a>, or drag and drop here. Must be a CSV, XLS, or XLSX file.
                                    </span>
                                    <input type="file" class="form-control visually-hidden" name="theExcel" id="theExcel" accept=".csv, .xls, .xlsx" required>
                                </div>
                                <div class="invalid-feedback import-excel-invalid-feedback">Please select a valid Excel file.</div>
                                <!-- Added custom class `import-excel-invalid-feedback` -->
                            </div>
                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary import-excel-submit-btn">Upload Data</button>
                                <!-- Added custom class `import-excel-submit-btn` -->
                            </div>
                        </form>
                    </div>

                    <!-- Right Partition: Picture -->
                    <div class="col-md-6 d-flex align-items-center justify-content-center">
                        <div class="image-placeholder import-excel-image-placeholder h-100 w-100">
                            <!-- Added custom class `import-excel-image-placeholder` -->
                            <img src="~/Images/modalBackDrop1.png" alt="Placeholder Image" class="img-fluid h-100 w-100" style="object-fit: contain;">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for displaying messages -->
<div class="modal fade" id="messageModal" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="messageModalLabel">Message</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="messageModalBody">
                <!-- Message will be inserted here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>



