@{
    ViewData["Title"] = "Calendar View";
    bool isArchived = ViewData["IsArchived"] as bool? ?? false;
}

<div class="d-flex align-items-center justify-content-between mb-2 g-2 mt-2">
    <!-- Sessions Heading -->
    <div class="d-flex mt-0">
        <h1 class="mb-0">Events</h1>
    </div>
    <div class="float-end">
        <a asp-action="ExportEventsToExcel" class="btn btn-white ">
            <img src="~/Images/dark-export-icon.png" alt="export-csv-icon" style="height: 24px; width: auto; margin-right: 10px" />
            Export
        </a>
        <div class="btn-group">
            <a asp-action="Create" class="btn btn-primary">
                <img src="~/Images/create-icon.png" alt="add-event-icon" style="height: 24px; width: auto; margin-right: 8px" />Add New
            </a>
            <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="visually-hidden">Toggle Dropdown</span>
            </button>
            <ul class="dropdown-menu" style="border-radius: 10px">
                <li style="margin-right: 18px">
                    <button type="button" class="dropdown-item text-white" data-bs-toggle="modal" data-bs-target="#importExcelModal">
                        <img src="~/Images/import.png" alt="import icon" style="height: 24px; width: auto; margin-right: 8px" />
                        Import Excel
                    </button>
                </li>
            </ul>
        </div>
    </div>
</div>
<p>View your Event and Attendance records.</p>

@* Container for all tabs *@
<div class="nav-container mb-3">
    <a class="nav-tab @(ViewData["ActiveTab"]?.ToString() == "active" ? "active" : "")"
       asp-action="Index" asp-route-archived="false">
        Active
        @if (ViewData["numberofActive"] != null && (int)ViewData["numberofActive"] == 0)
        {
            <span class="nav-tab-count  @(ViewData["ActiveTab"]?.ToString() == "active" ? "active" : "")">0</span>
        }
        else
        {
            <span class="nav-tab-count  @(ViewData["ActiveTab"]?.ToString() == "active" ? "active" : "")">@ViewData["numberofActive"]</span>
        }
    </a>
    <a class="nav-tab @(ViewData["ActiveTab"]?.ToString() == "archived" ? "active" : "")"
       asp-action="Index" asp-route-archived="true">
        Archive
        @if (ViewData["numberofArchive"] != null && (int)ViewData["numberofArchive"] == 0)
        {
            <span class="nav-tab-count  @(ViewData["ActiveTab"]?.ToString() == "archived" ? "active" : "")">0</span>
        }
        else
        {
            <span class="nav-tab-count  @(ViewData["ActiveTab"]?.ToString() == "archived" ? "active" : "")">@ViewData["numberofArchive"]</span>
        }
    </a>
</div>

<div class="d-flex align-items-center justify-content-end mb-2 g-2 mt-2">
    <!-- Date Picker and Button -->
    <div class="mb-3 me-2">
        <input type="date" id="datePicker" class="form-control" style="width: auto; display: inline-block;">
        <button id="goToDateButton" class="btn btn-primary">Go to Date</button>
    </div>
    <!-- Table View Button -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-primary"><img src="~/Images/table-view.png" alt="table-view-icon" style="height: 24px; width: auto; margin-right: 10px;" />Table View</a>
    </div>
</div>

<!-- FullCalendar Container -->
<div id="calendar"></div>

<!-- Event Details Modal -->
<div class="modal fade" id="eventDetailsModal" tabindex="-1" aria-labelledby="eventDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="eventDetailsModalLabel">Event Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p><strong>Title:</strong> <span id="eventTitle"></span></p>
                <p><strong>Description:</strong> <span id="eventDescription"></span></p>
                <p><strong>Date:</strong> <span id="eventDate"></span></p>
                <p><strong>Start Time:</strong> <span id="eventStartTime"></span></p>
                <p><strong>End Time:</strong> <span id="eventEndTime"></span></p>
                <p><strong>Location:</strong> <span id="eventLocation"></span></p>
            </div>
            <div class="modal-footer">
                <a id="goToDetailsButton" class="btn btn-primary" href="#">Go to Details</a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Include FullCalendar CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@5.10.1/main.min.css" />

<!-- Include FullCalendar JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.10.1/main.min.js"></script>

<!-- Calendar Initialization Script -->
<script>
        document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('calendar');
        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            events: '/Event/GetCalendarEvents', // Ensure this URL is correct
            dateClick: function (info) {
                alert('Date clicked: ' + info.dateStr);
            },
            eventClick: function (info) {
                // Fetch event details from the server
                fetch(`/Event/GetEventDetails/${info.event.id}`)
                    .then(response => response.json())
                    .then(data => {
                        // Populate the modal with event details
                        document.getElementById('eventTitle').textContent = data.name;
                        document.getElementById('eventDescription').textContent = data.description;
                        document.getElementById('eventDate').textContent = data.date;
                        document.getElementById('eventStartTime').textContent = data.startTime;
                        document.getElementById('eventEndTime').textContent = data.endTime;
                        document.getElementById('eventLocation').textContent = data.location;

                        // Set the URL for the "Go to Details" button
                        var detailsUrl = `/Event/Details/${info.event.id}`; // Update the URL to match your routing
                        document.getElementById('goToDetailsButton').setAttribute('href', detailsUrl);

                        // Show the modal
                        var modal = new bootstrap.Modal(document.getElementById('eventDetailsModal'));
                        modal.show();
                    })
                    .catch(error => {
                        console.error('Error fetching event details:', error);
                        alert('An error occurred while fetching event details.');
                    });
            }
        });
        calendar.render();

        // Add event listener to the "Go to Date" button
        document.getElementById('goToDateButton').addEventListener('click', function () {
            var dateStr = document.getElementById('datePicker').value;
            if (dateStr) {
                var date = new Date(dateStr + 'T00:00:00'); // Ensure the date is parsed correctly
                calendar.gotoDate(date);
            } else {
                alert('Please select a date.');
            }
        });
    });
</script>