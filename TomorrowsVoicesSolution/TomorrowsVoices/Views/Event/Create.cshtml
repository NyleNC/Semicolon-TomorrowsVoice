@using TomorrowsVoices.ViewModels
@model TomorrowsVoices.Models.Event

@{
    ViewData["Title"] = "Create Event";
}

<h1>Create Event</h1>
<hr />

<!-- Main Form -->
<form asp-action="Create" method="post" id="eventForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <label asp-for="Name" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="Name" class="form-control" id="eventName" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Address" class="control-label"></label>
                <textarea asp-for="Address" class="form-control" style="min-height: 116px; max-height: 116px;" id="eventDescription"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="VolLocationID" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <select asp-for="VolLocationID" class="form-control" asp-items="ViewBag.VolLocationID" id="eventLocation"></select>
            </div>
            <div class="form-group">
                <label asp-for="Date" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="Date" class="form-control" type="date" id="datePicker" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="StartTime" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                        <input asp-for="StartTime" class="form-control" type="time" id="eventStartTime" />
                        <span asp-validation-for="StartTime" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="EndTime" class="control-label" style="font-weight: 700"></label><span style="color: red">*</span>
                        <input asp-for="EndTime" class="form-control" type="time" id="eventEndTime" />
                        <span asp-validation-for="EndTime" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label asp-for="Notes" class="control-label"></label>
                <textarea asp-for="Notes" class="form-control" style="min-height: 116px; max-height: 116px;" id="eventNotes"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>
    </div>

    <h3>Schedules</h3>
    <div id="schedules-container">
        <!-- Schedule rows will be dynamically added here -->
    </div>
    <button type="button" id="add-schedule" class="btn btn-secondary">Add Schedule</button>

    <div class="form-group mt-4">
        <button type="submit" class="btn btn-primary">Create</button>
    </div>
</form>

<!-- Create Schedule Modal -->
<div class="modal fade" id="createScheduleModal" tabindex="-1" role="dialog" aria-labelledby="createScheduleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createScheduleModalLabel">Create New Schedules</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Form for Creating Multiple Schedules -->
                <form asp-action="CreateMultiple" method="post" id="createScheduleForm">
                    <div id="scheduleRows">
                        <!-- Initial Schedule Row -->
                        <div class="schedule-row border p-3 mb-3">
                            <div class="form-group">
                                <label>Shift Schedule Start</label>
                                <input type="time" class="form-control" name="Schedules[0].ShiftTime" required>
                            </div>
                            <div class="form-group">
                                <label>Shift Schedule End Time </label>
                                <input type="time" class="form-control" name="Schedules[0].ShiftEnd" required>
                            </div>
                     
                    
                            <div class="form-group">
                                <label>Volunteer</label>
                                <select class="form-control" name="Schedules[0].volunteerID" required>
                          
                                    @foreach (var volunteer in ViewBag.Volunteers)
                                    {
                                        <option value="@volunteer.ID">@volunteer.FullName</option>
                                    }
                                </select>
                            </div>
                            <button type="button" class="btn btn-danger btn-sm remove-schedule">Remove</button>
                        </div>
                    </div>
                    <button type="button" id="addSchedule" class="btn btn-secondary btn-sm">Add Another Schedule</button>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="submit" form="createScheduleForm" class="btn btn-primary">Create Schedules</button>
            </div>
        </div>
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary">Back to Events Page</a>

@section Scripts {
    <script>
            document.addEventListener("DOMContentLoaded", function () {
            let today = new Date().toISOString().split('T')[0]; // Get today's date in YYYY-MM-DD format
            document.getElementById("datePicker").value = today; // Set default value
        });
 
        let scheduleIndex = 0;

        // Add a new schedule row directly to the main form
        document.getElementById('add-schedule').addEventListener('click', function () {
            const container = document.getElementById('schedules-container');
            const newRow = document.createElement('div');
            newRow.className = 'schedule-row border p-3 mb-3';
            newRow.innerHTML = `
                <div class="form-group">
                    <label>Shift Schedule Start</label>
                    <input type="time" name="Schedules[${scheduleIndex}].ShiftStart" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Shift Schedule End</label>
                    <input type="time" name="Schedules[${scheduleIndex}].ShiftEnd" class="form-control" required />
                </div>
         
                <div class="form-group">
                    <label>Volunteer</label>
                                  <select class="form-control" name="Schedules[0].volunteerID" required>
              
        @foreach (var volunteer in ViewBag.Volunteers)
        {
                                    <option value="@volunteer.ID">@volunteer.FullName</option>
        }
                    </select>
                
                </div>
                <button type="button" class="btn btn-danger btn-sm remove-schedule">Remove</button>
            `;
            container.appendChild(newRow);
            scheduleIndex++;
        });

        // Remove a schedule row
        document.addEventListener('click', function (e) {
            if (e.target.classList.contains('remove-schedule')) {
                e.target.closest('.schedule-row').remove();
            }
        });

        // Submit the modal form and append data to the main form
        $('#createScheduleForm').on('submit', function (e) {
            e.preventDefault(); // Prevent the default form submission

            // Get all schedule rows from the modal
            const scheduleRows = $('#scheduleRows .schedule-row');

            // Append each schedule row to the main form's schedules container
            scheduleRows.each(function (index, row) {
                const newRow = document.createElement('div');
                newRow.className = 'schedule-row border p-3 mb-3';
                newRow.innerHTML = `
                    <input type="hidden" name="Schedules[${scheduleIndex}].ShiftStart" value="${$(row).find('[name="Schedules[0].ShiftStart"]').val()}" />
                    <input type="hidden" name="Schedules[${scheduleIndex}].ShiftEnd" value="${$(row).find('[name="Schedules[0].ShiftEnd"]').val()}" />

                      <select class="form-control" name="Schedules[0].volunteerID" required>
                      
        @foreach (var volunteer in ViewBag.Volunteers)
        {
                                <option value="@volunteer.ID">@volunteer.FullName</option>
        }
                    </select>
                `;
                $('#schedules-container').append(newRow);
                scheduleIndex++;
            });

            // Close the modal after appending the data
            $('#createScheduleModal').modal('hide');
        });
                $(document).ready(function () {
            $('select[multiple]').select2({
                placeholder: "Select Volunteers",
                allowClear: true
            });
        });
    </script>

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: '@TempData["SuccessMessage"]',
                    confirmButtonText: 'OK'
                });
            });
        </script>
    }
}

