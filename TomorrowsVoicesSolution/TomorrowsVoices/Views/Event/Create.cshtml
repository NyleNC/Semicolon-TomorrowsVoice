@using TomorrowsVoices.ViewModels
@model TomorrowsVoices.Models.Event

@{
    ViewData["Title"] = "Create Event";
}

<h1>Create Event</h1>
<hr />

<!-- Main Form -->
<form asp-action="Create" method="post" id="eventForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Address" class="control-label"></label>
                <textarea asp-for="Address" class="form-control" style="max-height: 100px"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="VolLocationID" class="control-label"></label>
                <select asp-for="VolLocationID" class="form-control" asp-items="ViewBag.VolLocationID"></select>
                <span asp-validation-for="VolLocationID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Date" class="control-label"></label>
                <input asp-for="Date" class="form-control" type="date" id="datePicker"/>
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="StartTime" class="control-label"></label>
                        <input asp-for="StartTime" class="form-control" type="time" />
                        <span asp-validation-for="StartTime" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="EndTime" class="control-label"></label>
                        <input asp-for="EndTime" class="form-control" type="time" />
                        <span asp-validation-for="EndTime" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Notes" class="control-label"></label>
                <textarea asp-for="Notes" class="form-control" style="max-height: 100px"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>
    </div>

    <h3>Schedules</h3>
    <div id="schedules-container">
        <!-- Schedule rows will be dynamically added here -->
    </div>
    <button type="button" id="add-schedule" class="btn btn-secondary">Add Schedule</button>

    <div class="form-group mt-4">
        <button type="submit" class="btn btn-primary">Create</button>
    </div>
</form>

<!-- Create Schedule Modal -->
<div class="modal fade" id="createScheduleModal" tabindex="-1" role="dialog" aria-labelledby="createScheduleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createScheduleModalLabel">Create New Schedules</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Form for Creating Multiple Schedules -->
                <form asp-action="CreateMultiple" method="post" id="createScheduleForm">
                    <div id="scheduleRows">
                        <!-- Initial Schedule Row -->
                        <div class="schedule-row border p-3 mb-3">
                            <div class="form-group">
                                <label>Shift Start</label>
                                <input type="time" class="form-control" name="Schedules[0].ShiftTime" required>
                            </div>
                            <div class="form-group">
                                <label>Shift End</label>
                                <input type="time" class="form-control" name="Schedules[0].ShiftEnd" required>
                            </div>
                            <div class="form-group">
                                <label>Shift Start</label>
                                <input type="time" class="form-control" name="Schedules[0].ActualStartime" required>
                            </div>
                            <div class="form-group">
                                <label>Shift End</label>
                                <input type="time" class="form-control" name="Schedules[0].ActualEndTime" required>
                            </div>
                    
                            <div class="form-group">
                                <label>Volunteer</label>
                                <select class="form-control" name="Schedules[0].volunteerID" required>
                                    <option value="">Select a Volunteer</option>
                                    @foreach (var volunteer in ViewBag.Volunteers)
                                    {
                                        <option value="@volunteer.ID">@volunteer.FullName</option>
                                    }
                                </select>
                            </div>
                            <button type="button" class="btn btn-danger btn-sm remove-schedule">Remove</button>
                        </div>
                    </div>
                    <button type="button" id="addSchedule" class="btn btn-secondary btn-sm">Add Another Schedule</button>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="submit" form="createScheduleForm" class="btn btn-primary">Create Schedules</button>
            </div>
        </div>
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary">Back to Events Page</a>

@section Scripts {
    <script>
            document.addEventListener("DOMContentLoaded", function () {
            let today = new Date().toISOString().split('T')[0]; // Get today's date in YYYY-MM-DD format
            document.getElementById("datePicker").value = today; // Set default value
        });
        let scheduleIndex = 0;

        // Add a new schedule row
        document.getElementById('add-schedule').addEventListener('click', function () {
            const container = document.getElementById('schedules-container');
            const newRow = document.createElement('div');
            newRow.className = 'schedule-row border p-3 mb-3';
            newRow.innerHTML = `
                <div class="form-group">
                    <label>Shift Start</label>
                    <input type="time" name="Schedules[${scheduleIndex}].StartTime" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Shift End</label>
                    <input type="time" name="Schedules[${scheduleIndex}].EndTime" class="form-control" required />
                </div>
                    <div class="form-group">
                    <label>Shift Start</label>
                    <input type="time" name="Schedules[${scheduleIndex}].ActualStartTime" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Shift End</label>
                    <input type="time" name="Schedules[${scheduleIndex}].ActualEndTime" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Volunteer</label>
                    <select name="Schedules[${scheduleIndex}].VolunteerID" class="form-control" required>
                        <option value="">Select a Volunteer</option>
        @foreach (var volunteer in ViewBag.Volunteers)
        {
                                <option value="@volunteer.ID">@volunteer.FullName</option>
        }
                    </select>
                </div>
                <button type="button" class="btn btn-danger btn-sm remove-schedule">Remove</button>
            `;
            container.appendChild(newRow);
            scheduleIndex++;
        });

        // Remove a schedule row
        document.addEventListener('click', function (e) {
            if (e.target.classList.contains('remove-schedule')) {
                e.target.closest('.schedule-row').remove();
            }
        });

        // Submit the modal form via AJAX
        $('#createScheduleForm').on('submit', function (e) {
            e.preventDefault(); // Prevent the default form submission

            $.ajax({
                url: '@Url.Action("CreateMultiple", "Event")',
                type: 'POST',
                data: $(this).serialize(),
                success: function (response) {
                    if (response.success) {
                        $('#createScheduleModal').modal('hide'); // Close the modal
                        location.reload(); // Refresh the page to show the new schedules
                    } else {
                        alert('Error: ' + response.message); // Show error message
                    }
                },
                error: function (xhr, status, error) {
                    // Log the full error response
                    console.log(xhr.responseText);
                    alert('An error occurred: ' + xhr.responseText);
                }
            });
        });
    </script>
}
