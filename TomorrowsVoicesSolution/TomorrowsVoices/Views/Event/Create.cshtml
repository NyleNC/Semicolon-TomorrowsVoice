@model TomorrowsVoices.Models.Event

@{
    ViewData["Title"] = "Create";
}

<h1>Create Event</h1>
<hr />
<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" id="eventName" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" id="eventDescription" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="VolLocationID" class="control-label"></label>
                <select asp-for="VolLocationID" class="form-control" asp-items="ViewBag.VolLocationID" id="eventLocation"></select>
            </div>
            <div class="form-group">
                <label asp-for="Date" class="control-label"></label>
                <input asp-for="Date" class="form-control" type="date" id="eventDate" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="StartTime" class="control-label"></label>
                        <input asp-for="StartTime" class="form-control" type="time" id="eventStartTime" />
                        <span asp-validation-for="StartTime" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="EndTime" class="control-label"></label>
                        <input asp-for="EndTime" class="form-control" type="time" id="eventEndTime" />
                        <span asp-validation-for="EndTime" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label asp-for="Notes" class="control-label"></label>
                <textarea asp-for="Notes" class="form-control" style="min-height: 116px; max-height: 116px;" id="eventNotes"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="container mt-5">
        <div class="schedules-header">
            <h1 class="schedule-title">Schedules</h1>
            <div style="display: flex; align-items: center;">
                <button type="button" id="import-button" class="import-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus" viewBox="0 0 16 16">
                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" />
                    </svg>
                    import
                </button>
                <div class="loading" id="loading-indicator">Loading...</div>
                <input type="file" id="file-input" accept=".xlsx, .xls, .csv" />
            </div>
        </div>

        <!-- Debug info - can be removed in production -->
        <div id="debug-info" class="d-none"></div>

        <div id="schedule-container" class="row">
            <!-- Schedule cards will be generated here -->
        </div>
    </div>

    <div id="attendance-container" style="display: none;">
        <h2 class="attendance-header">Track Attendance</h2>
        <div class="row">
            <div class="col-lg-8 col-md-10 col-sm-12 col-12">
                <div class="accordion" id="attendanceAccordion">
                    <!-- Attendance accordion items will be generated here -->
                </div>
            </div>
        </div>
    </div>

    <div class="container mt-4">
        <div class="row">
            <div class="col-md-4 d-flex gap-2">
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                        <img src="~/Images/create-icon.png" alt="Create icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
                        Create
                    </button>
                </div>
                <div>
                    <button type="button" id="fillPresetValues" class="btn btn-secondary" style="background-color: navy">
                        <img src="~/Images/create-icon.png" alt="Preset icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
                        Fill Preset Values
                    </button>
                </div>
            </div>

            <a asp-action="Index" class="btn btn-secondary"><img src="~/Images/previous-page-icon.png" alt="go to previous page icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Back to Events Page</a>
        </div>
    </div>
</form>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let today = new Date().toISOString().split('T')[0]; // Get today's date in YYYY-MM-DD format
        document.getElementById("datePicker").value = today; // Set default value
    });

    // Global variable to store the imported schedule data
    let scheduleData = [];

    // Add debug logging to track file processing
    function logDebug(message) {
        const debugContainer = document.getElementById('debug-info');
        debugContainer.style.display = 'block';
        debugContainer.innerHTML += `<p>${message}</p>`;
        console.log(message);
    }

    // Initialize event handlers when the document is loaded
    document.addEventListener('DOMContentLoaded', function () {
        // Set up the import button click handler
        document.getElementById('import-button').addEventListener('click', function (e) {
            e.preventDefault();
            try {
                document.getElementById('file-input').click();
            } catch (error) {
                logDebug(`Error triggering file input: ${error.message}`);
            }
        });

        // Set up the file input change handler
        document.getElementById('file-input').addEventListener('change', function () {
            const loadingIndicator = document.getElementById('loading-indicator');
            loadingIndicator.style.display = 'block';

            try {
                // Direct access to this element instead of relying on event.target
                const fileInput = document.getElementById('file-input');
                if (!fileInput.files || fileInput.files.length === 0) {
                    loadingIndicator.style.display = 'none';
                    logDebug("No file selected");
                    return;
                }

                const file = fileInput.files[0];
                logDebug(`File selected: ${file.name}`);
                handleFileUpload(file);

            } catch (error) {
                loadingIndicator.style.display = 'none';
                logDebug(`Error in file change handler: ${error.message}`);
            }
        });
    });

    function handleFileUpload(file) {
        try {
            logDebug("Starting file upload process");

            const reader = new FileReader();

            reader.onload = function (e) {
                try {
                    logDebug("File loaded into memory");
                    const data = new Uint8Array(e.target.result);
                    processExcel(data);
                } catch (error) {
                    logDebug(`Error in reader.onload: ${error.message}`);
                    document.getElementById('loading-indicator').style.display = 'none';
                }
            };

            reader.onerror = function (e) {
                logDebug(`FileReader error: ${reader.error}`);
                document.getElementById('loading-indicator').style.display = 'none';
            };

            reader.readAsArrayBuffer(file);
            logDebug("Called readAsArrayBuffer");

        } catch (error) {
            logDebug(`Error in handleFileUpload: ${error.message}`);
            document.getElementById('loading-indicator').style.display = 'none';
        }
    }

    function processExcel(data) {
        try {
            logDebug("Processing Excel data");

            // Check if XLSX is available
            if (typeof XLSX === 'undefined') {
                logDebug("XLSX library not loaded");
                document.getElementById('loading-indicator').style.display = 'none';
                return;
            }

            const workbook = XLSX.read(data, { type: 'array' });
            logDebug(`Workbook loaded. Sheet names: ${workbook.SheetNames.join(', ')}`);

            const firstSheetName = workbook.SheetNames[0];
            const worksheet = workbook.Sheets[firstSheetName];

            // Convert to JSON with header mapping
            const jsonData = XLSX.utils.sheet_to_json(worksheet, { raw: false });
            logDebug(`Data converted to JSON. Row count: ${jsonData.length}`);

            if (jsonData.length === 0) {
                logDebug("No data found in spreadsheet");
                document.getElementById('loading-indicator').style.display = 'none';
                return;
            }

            // Log column names from first row to help with debugging
            logDebug(`Available columns: ${Object.keys(jsonData[0]).join(', ')}`);

            // Group volunteers by start and end times
            const scheduleGroups = groupVolunteersBySchedule(jsonData);
            logDebug(`Groups created: ${scheduleGroups.length}`);

            // Store the schedule data globally
            scheduleData = scheduleGroups;

            // Display the grouped schedules
            displaySchedules(scheduleGroups);

            // Generate attendance tracking section
            generateAttendanceSection(scheduleGroups);

            // Show the attendance container
            document.getElementById('attendance-container').style.display = 'block';

        } catch (error) {
            logDebug(`Error in processExcel: ${error.message}`);
        } finally {
            document.getElementById('loading-indicator').style.display = 'none';
        }
    }

    function groupVolunteersBySchedule(volunteers) {
        try {
            logDebug("Grouping volunteers by schedule");
            const scheduleGroups = {};

            // Determine column names (handle different possible column names)
            const sampleVolunteer = volunteers[0];
            const firstNameKey = determineColumnName(sampleVolunteer, ['FirstName', 'First Name', 'firstname', 'first_name', 'Firstname']);
            const lastNameKey = determineColumnName(sampleVolunteer, ['LastName', 'Last Name', 'lastname', 'last_name', 'Lastname']);
            const startTimeKey = determineColumnName(sampleVolunteer, ['ScheduledStartTime', 'Start Time', 'starttime', 'start_time', 'Start']);
            const endTimeKey = determineColumnName(sampleVolunteer, ['ScheduledEndTime', 'End Time', 'endtime', 'end_time', 'End', 'Scheduled End Time']);

            logDebug(`Using column names: ${firstNameKey}, ${lastNameKey}, ${startTimeKey}, ${endTimeKey}`);

            if (!firstNameKey || !lastNameKey || !startTimeKey || !endTimeKey) {
                logDebug("Could not find required columns in the data");
                return [];
            }

            volunteers.forEach((volunteer, index) => {
                // Skip rows without necessary data
                if (!volunteer[firstNameKey] || !volunteer[lastNameKey] ||
                    !volunteer[startTimeKey] || !volunteer[endTimeKey]) {
                    logDebug(`Skipping row ${index} due to missing data`);
                    return;
                }

                const key = `${volunteer[startTimeKey]}-${volunteer[endTimeKey]}`;

                if (!scheduleGroups[key]) {
                    scheduleGroups[key] = {
                        startTime: volunteer[startTimeKey],
                        endTime: volunteer[endTimeKey],
                        volunteers: []
                    };
                }

                scheduleGroups[key].volunteers.push({
                    firstName: volunteer[firstNameKey],
                    lastName: volunteer[lastNameKey],
                    // Initialize attendance data
                    isPresent: true,
                    actualStartTime: volunteer[startTimeKey],
                    actualEndTime: volunteer[endTimeKey]
                });
            });

            return Object.values(scheduleGroups);
        } catch (error) {
            logDebug(`Error in groupVolunteersBySchedule: ${error.message}`);
            return [];
        }
    }

    // Helper function to find column names regardless of exact format
    function determineColumnName(obj, possibleNames) {
        for (const name of possibleNames) {
            if (obj.hasOwnProperty(name)) {
                return name;
            }
        }
        return null;
    }

    function displaySchedules(scheduleGroups) {
        try {
            logDebug("Displaying schedules");
            const container = document.getElementById('schedule-container');
            container.innerHTML = '';

            if (scheduleGroups.length === 0) {
                container.innerHTML = '<div class="col-12"><p>No schedule data found or could not process the file.</p></div>';
                return;
            }

            scheduleGroups.forEach(group => {
                // Format the time for display
                const formattedStartTime = formatTime(group.startTime);
                const formattedEndTime = formatTime(group.endTime);

                const cardHtml = `
                            <div class="col-lg-4 col-md-6 col-12 mb-4">
                                <div class="schedule-card">
                                    <div class="card-body">
                                        <div class="schedule-card-header">
                                            ${formattedStartTime} - ${formattedEndTime}
                                        </div>
                                        <ul class="schedule-list">
                                            ${group.volunteers.map(vol => `
                                                <li>${vol.firstName} ${vol.lastName}</li>
                                            `).join('')}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        `;

                container.innerHTML += cardHtml;
            });

            logDebug("Schedule display completed");
        } catch (error) {
            logDebug(`Error in displaySchedules: ${error.message}`);
        }
    }

    function formatTime(timeStr) {
        try {
            // Handle potential formatting issues
            if (!timeStr) return "Unknown time";

            // Try to standardize common time formats
            // Convert "9:00 AM" or "9:00AM" to "9:00am" format
            let formatted = timeStr.toString().trim().toLowerCase();

            // Add some formatting if needed (e.g., if it's just "9:00")
            if (!/am|pm/.test(formatted)) {
                // Try to determine if it's AM or PM based on 24-hour format
                const hourMatch = formatted.match(/^(\d+):/);
                if (hourMatch) {
                    const hour = parseInt(hourMatch[1]);
                    if (hour >= 12) {
                        formatted = formatted + " pm";
                    } else {
                        formatted = formatted + " am";
                    }
                }
            }

            return formatted;
        } catch (error) {
            logDebug(`Error in formatTime: ${error.message}`);
            return timeStr || "Unknown time";
        }
    }

    // Function to generate attendance tracking section
    function generateAttendanceSection(scheduleGroups) {
        try {
            logDebug("Generating attendance section");
            const attendanceAccordion = document.getElementById('attendanceAccordion');
            attendanceAccordion.innerHTML = '';

            if (scheduleGroups.length === 0) {
                attendanceAccordion.innerHTML = '<div class="p-3">No schedule data available.</div>';
                return;
            }

            scheduleGroups.forEach((group, groupIndex) => {
                const formattedStartTime = formatTime(group.startTime);
                const formattedEndTime = formatTime(group.endTime);
                const timeSlotId = `timeSlot-${groupIndex}`;

                const accordionItem = document.createElement('div');
                accordionItem.className = 'accordion-item';

                // Create accordion header
                const accordionHeader = document.createElement('h2');
                accordionHeader.className = 'accordion-header';
                accordionHeader.id = `heading-${timeSlotId}`;

                const isFirstItem = groupIndex === 0;

                accordionHeader.innerHTML = `
                            <button class="accordion-button ${isFirstItem ? '' : 'collapsed'}"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapse-${timeSlotId}"
                                    aria-expanded="${isFirstItem ? 'true' : 'false'}"
                                    aria-controls="collapse-${timeSlotId}">
                                ${formattedStartTime} - ${formattedEndTime}
                            </button>
                        `;

                // Create accordion body
                const accordionCollapse = document.createElement('div');
                accordionCollapse.id = `collapse-${timeSlotId}`;
                accordionCollapse.className = `accordion-collapse collapse ${isFirstItem ? 'show' : ''}`;
                accordionCollapse.setAttribute('aria-labelledby', `heading-${timeSlotId}`);
                accordionCollapse.setAttribute('data-bs-parent', '#attendanceAccordion');

                const accordionBody = document.createElement('div');
                accordionBody.className = 'accordion-body p-0';

                // Create attendance list
                const attendanceList = document.createElement('ul');
                attendanceList.className = 'attendance-list';
                attendanceList.id = `attendance-list-${timeSlotId}`;

                group.volunteers.forEach((volunteer, volIndex) => {
                    const volunteerAttendanceItem = createVolunteerAttendanceItem(volunteer, groupIndex, volIndex, formattedStartTime, formattedEndTime);
                    attendanceList.appendChild(volunteerAttendanceItem);
                });

                accordionBody.appendChild(attendanceList);
                accordionCollapse.appendChild(accordionBody);

                accordionItem.appendChild(accordionHeader);
                accordionItem.appendChild(accordionCollapse);
                attendanceAccordion.appendChild(accordionItem);
            });

            logDebug("Attendance section generated");
        } catch (error) {
            logDebug(`Error in generateAttendanceSection: ${error.message}`);
        }
    }

    // Function to create a volunteer attendance list item
    function createVolunteerAttendanceItem(volunteer, groupIndex, volIndex, formattedStartTime, formattedEndTime) {
        const li = document.createElement('li');
        li.id = `volunteer-${groupIndex}-${volIndex}`;
        li.className = volunteer.isPresent ? 'present-volunteer' : 'absent-volunteer';

        // Calculate hours worked if present
        let hoursWorked = "";
        if (volunteer.isPresent && volunteer.actualStartTime && volunteer.actualEndTime) {
            // This is a simplified calculation - in a real app, you'd parse the times properly
            const hours = 4; // Example fixed hours for display
            hoursWorked = `${hours}hrs`;
        }

        li.innerHTML = `
                    <div class="volunteer-info">
                        <span class="attendance-toggle" onclick="toggleAttendance(${groupIndex}, ${volIndex})">
                            ${volunteer.isPresent ?
                '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check-circle-fill check-icon" viewBox="0 0 16 16"><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/></svg>' :
                '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-circle-fill x-icon" viewBox="0 0 16 16"><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293 5.354 4.646z"/></svg>'
            }
                        </span>
                        <span>${volunteer.firstName} ${volunteer.lastName}</span>
                    </div>
                    <div class="time-info">
                        ${volunteer.isPresent ?
                `<span>${formattedStartTime} - ${formattedEndTime}</span>` :
                '<span>Marked as Absent</span>'
            }
                    </div>
                `;

        return li;
    }

    // Function to toggle volunteer attendance status
    function toggleAttendance(groupIndex, volIndex) {
        try {
            // Update the data
            if (scheduleData[groupIndex] && scheduleData[groupIndex].volunteers[volIndex]) {
                const volunteer = scheduleData[groupIndex].volunteers[volIndex];
                volunteer.isPresent = !volunteer.isPresent;

                // Update the UI
                const li = document.getElementById(`volunteer-${groupIndex}-${volIndex}`);
                if (li) {
                    // Toggle the class
                    li.className = volunteer.isPresent ? 'present-volunteer' : 'absent-volunteer';

                    // Update the content
                    const formattedStartTime = formatTime(scheduleData[groupIndex].startTime);
                    const formattedEndTime = formatTime(scheduleData[groupIndex].endTime);

                    // Calculate hours worked if present
                    let hoursWorked = "";
                    if (volunteer.isPresent && volunteer.actualStartTime && volunteer.actualEndTime) {
                        // This is a simplified calculation - in a real app, you'd parse the times properly
                        const hours = 4; // Example fixed hours for display
                        hoursWorked = `${hours}hrs`;
                    }

                    li.innerHTML = `
                                <div class="volunteer-info">
                                    <span class="attendance-toggle" onclick="toggleAttendance(${groupIndex}, ${volIndex})">
                                        ${volunteer.isPresent ?
                            '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check-circle-fill check-icon" viewBox="0 0 16 16"><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/></svg>' :
                            '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-circle-fill x-icon" viewBox="0 0 16 16"><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293 5.354 4.646z"/></svg>'
                        }
                                    </span>
                                    <span>${volunteer.firstName} ${volunteer.lastName}</span>
                                </div>
                                <div class="time-info">
                                    ${volunteer.isPresent ?
                            `<span>${formattedStartTime} - ${formattedEndTime}</span>` :
                            '<span>Marked as Absent</span>'
                        }
                                </div>
                            `;
                }
            }
        } catch (error) {
            logDebug(`Error in toggleAttendance: ${error.message}`);
        }
    }
</script>


