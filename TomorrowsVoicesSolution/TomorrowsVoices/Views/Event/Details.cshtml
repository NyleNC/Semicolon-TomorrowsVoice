@model TomorrowsVoices.Models.Event

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<dl>
    <h4>Event</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Notes)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Notes)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Date)
        </dt>
        <dd class = "col-sm-10">
			@Html.DisplayFor(model => model.Date)
        </dd>
       
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.StartTime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.StartTime)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EndTime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EndTime)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.VolLocation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.VolLocation.City)
        </dd>
    </dl>
    <div class="mt-4">
        <div class="text-black mb-2" style="border-bottom: 3px solid gray">
            <dt style="font-size: 18px">Schedules</dt>
        </div>
        <div class="container">
            <div class="row">
                @if (Model.VolAttendance.Any())
                    {
                        var groupedSchedules = Model.VolAttendance
                        .Where(a => a.ScheduledStartTime != null && a.ScheduledEndTime != null)
                        .GroupBy(a => new { a.ScheduledStartTime, a.ScheduledEndTime });

                        @foreach (var schedule in groupedSchedules)
                        {
                            if (schedule.All(a => a.ScheduledStartTime == schedule.Key.ScheduledStartTime &&
                            a.ScheduledEndTime == schedule.Key.ScheduledEndTime))
                            {
                                <div class="col-lg-3 col-md-4 col-sm-6 p-2">
                                <div class="card" style="background-color: #e1ccfc">

                                        <div class="card-body ">

                                        <div class="card-title" style="font-size: 17px; font-weight: 700; ">
                                                @schedule.Key.ScheduledStartTime.ToString("hh:mm tt") - @schedule.Key.ScheduledEndTime.ToString("hh:mm tt")
                                            </div>
                                        <ul class="card-text list-unstyled" style="min-height: 130px; max-height: 130px; overflow-y: auto;">
                                         
                                                @foreach (var attendance in schedule)
                                                {
                                                    <li>@attendance.Volunteer.FirstName @attendance.Volunteer.LastName</li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <p>No schedules available.</p>
                    }
                </div>
            </div>
        </div>
    <div class="text-black mb-4 mt-4" style="border-bottom: 3px solid gray">
        <dt style="font-size: 18px">Track Attendances</dt>
    </div>
    <dl class="row mt-4">
        <dt class = "col-sm-2">
			@Html.DisplayNameFor(model => model.Notes)
		</dt>
		<dd class = "col-sm-10">
			@Html.DisplayFor(model => model.Notes)
		</dd>
     
    </dl>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.ID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>

</div>


<style>
    .card-text::-webkit-scrollbar {
        width: 6px;
    }

    .card-text::-webkit-scrollbar-thumb {
        background: rgb(100, 79, 128); /* Light gray thumb */
        border-radius: 6px;
    }

    .card-text::-webkit-scrollbar-track {
        background: transparent; /* Hide the track */
    }

    /* For Firefox */
    .card-text {
        scrollbar-width: thin;
        scrollbar-color: rgb(100, 79, 128) transparent;
    }
</style>