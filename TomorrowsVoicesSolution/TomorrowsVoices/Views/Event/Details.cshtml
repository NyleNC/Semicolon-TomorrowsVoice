@model TomorrowsVoices.Models.Event

@{
    ViewData["Title"] = "Details";
}

<h1>Event Details</h1>

<dl>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>   
        <div class="col-sm-2">
            <strong>Time</strong> 
        </div>
        <div class="col-sm-10">
            @Html.DisplayFor(model => model.Start) - @Html.DisplayFor(model => model.End)
        </div>
        <dt class = "detail-item">
            @Html.DisplayNameFor(model => model.VolLocation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.VolLocation.City)
        </dd>
    </dl>
    <div class="mt-4">
        <div class="text-black mb-2" style="border-bottom: 3px solid gray">
            <dt style="font-size: 18px">Schedules</dt>
        </div>
        <div class="container">
            <div class="row">
                @if (Model.VolSchedules.Any())
                {
                    var groupedSchedules = Model.VolSchedules
                    .Where(a => a.ScheduledStart != null && a.ScheduledEnd != null)
                        .GroupBy(a => new { a.ScheduledStart, a.ScheduledEnd });

                    @foreach (var schedule in groupedSchedules)
                    {
                        if (schedule.All(a => a.ScheduledStart == schedule.Key.ScheduledStart &&
                        a.ScheduledEnd == schedule.Key.ScheduledEnd))
                        {
                            <div class="col-lg-3 col-md-4 col-sm-6 p-2">
                                <div class="card" style="background-color: #e1ccfc">

                                    <div class="card-body ">

                                        <div class="card-title" style="font-size: 17px; font-weight: 700; ">
                                            @schedule.Key.ScheduledStart.ToString() - @schedule.Key.ScheduledEnd.ToString()
                                        </div>
                                        <ul class="card-text list-unstyled" style="min-height: 130px; max-height: 130px; overflow-y: auto;">

                                            @foreach (var attendance in schedule)
                                            {
                                                @foreach (var volAttendance in attendance.VolAttendances)
                                                {
                                                    @if (volAttendance.Status == true)
                                                    {
                                                        <li>@volAttendance.Volunteer.FirstName @volAttendance.Volunteer.LastName</li>
                                                    }
                                                  
                                                }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <p>No schedules available.</p>
            }
        </div>
    </div>
</div>

