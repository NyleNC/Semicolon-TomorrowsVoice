@model TomorrowsVoices.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<!-- Required CSS Libraries -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/event-styles.css">

<h1 class="mt-4">Event Details</h1>
<hr style="margin-bottom: 35px" />

<div class="row">
    <!-- Event Information Column -->
    <div class="col-md-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h3 class="mb-0">
                    <i class="bi bi-info-circle"></i> Event Information
                </h3>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Name)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Name)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Location)
                    </dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrEmpty(Model.Location) ? "Not specified" : Model.Location)
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Address)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Address)
                    </dd>
                    <dt class="col-sm-4">
                        Chapter
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.VolLocation.City)
                        @if (!string.IsNullOrEmpty(Model.VolLocation?.Venue))
                        {
                            <span> - @Model.VolLocation.Venue</span>
                        }
                    </dd>
                    <dt class="col-sm-4">
                        Date
                    </dt>
                    <dd class="col-sm-8">
                        @Model.Date.ToShortDateString()
                    </dd>
                    <dt class="col-sm-4">
                        Time
                    </dt>
                    <dd class="col-sm-8">
                        @Model.Start.ToString("h:mm tt") - @Model.End.ToString("h:mm tt")
                    </dd>
                </dl>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h3 class="mb-0">
                        <i class="bi bi-journal-text"></i> Notes
                    </h3>
                </div>
                <div class="card-body">
                    <p style="white-space: pre-wrap;">@Model.Notes</p>
                </div>
            </div>
        }
    </div>

    <!-- Event Schedules Column -->
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h3 class="mb-0">
                    <i class="bi bi-calendar-event"></i> Schedules
                </h3>
                <span class="badge badge-primary bg-primary">
                    @Model.VolSchedules.Count Shifts
                </span>
            </div>
            <div class="card-body">
                @if (!Model.VolSchedules.Any())
                {
                    <div class="text-center py-4">
                        <i class="bi bi-calendar-x" style="font-size: 2rem;"></i>
                        <p class="mt-3 text-muted">No schedules have been set up for this event.</p>
                    </div>
                }
                else
                {
                    var groupedByDate = Model.VolSchedules
                    .GroupBy(s => s.ShiftDate.Date)
                    .OrderBy(g => g.Key);

                    @foreach (var dateGroup in groupedByDate)
                    {
                        <div class="mb-4">
                            <h5 class="border-bottom pb-2">
                                <i class="bi bi-calendar-date"></i>
                                @dateGroup.Key.ToString("dddd, MMMM d, yyyy")
                            </h5>

                            <div class="row">
                                @foreach (var shift in dateGroup.OrderBy(s => s.ScheduledStart))
                                {
                                    <div class="col-lg-6 col-md-12 mb-3">
                                        <div class="card border" style="background-color: #e1ccfc">
                                            <div class="card-header py-2">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <h6 class="mb-0">
                                                        <i class="bi bi-clock"></i>
                                                        @shift.ScheduledStart.ToString("h:mm tt") - @shift.ScheduledEnd.ToString("h:mm tt")
                                                    </h6>
                                                    <span class="badge badge-light bg-light text-dark">
                                                        Capacity: @shift.Capacity
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="card-body py-2">
                                                <h6 class="card-subtitle mb-2 text-muted">
                                                    <i class="bi bi-people-fill"></i>
                                                    Volunteers (@(shift.VolAttendances.Count(a => a.Status))/@shift.Capacity)
                                                </h6>
                                                <ul class="list-group list-group-flush">
                                                    @if (shift.VolAttendances.Any(a => a.Status))
                                                    {
                                                        foreach (var attendance in shift.VolAttendances.Where(a => a.Status))
                                                        {
                                                            <li class="list-group-item py-1 px-2 bg-transparent border-0">
                                                                <i class="bi bi-person"></i>
                                                                @attendance.Volunteer.FirstName @attendance.Volunteer.LastName
                                                            </li>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <li class="list-group-item py-1 px-2 bg-transparent border-0 text-muted">
                                                            <i class="bi bi-person-x"></i> No volunteers assigned
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-primary">
        <i class="bi bi-pencil"></i> Edit Event
    </a>
    <a asp-action="Index" class="btn btn-secondary ml-2">
        <img src="~/Images/previous-page-icon.png" alt="go to previous page icon"
             style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
        Back to Events Page
    </a>
</div>
