@using TomorrowsVoices.ViewModels
@model ScheduleVM

<div class="schedule-form">
    <div class="form-group">
        <label>Shift Start Time <span class="text-danger">*</span></label>
        <input type="time" class="form-control" name="NewSchedule.ScheduledStart"
               value="@Model?.ScheduledStart.ToString("HH:mm")" required />
    </div>
    <div class="form-group">
        <label>Shift End Time <span class="text-danger">*</span></label>
        <input type="time" class="form-control" name="NewSchedule.ScheduledEnd"
               value="@Model?.ScheduledEnd.ToString("HH:mm")" required />
    </div>
    <div class="form-group">
        <label>Capacity <span class="text-danger">*</span></label>
        <input type="number" class="form-control" name="NewSchedule.Capacity"
               value="@(Model?.Capacity ?? 1)" min="1" max="100" required />
        <small class="text-muted">Maximum number of volunteers for this shift</small>
    </div>
    <button type="button" id="addScheduleBtn" class="btn btn-primary">Add Shift</button>
</div>


<style>
    .error-message {
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .volunteer-selection label span.text-danger {
        font-weight: normal;
    }
</style>
