@model IEnumerable<TomorrowsVoices.Models.Volunteer>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

@{
    ViewData["Title"] = "Index";
    bool isArchived = ViewData["IsArchived"] as bool? ?? false;
}

<h1>Volunteers</h1>



@* Archived tabs *@
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(ViewData["ActiveTab"]?.ToString() == "active" ? "active" : "")"
           asp-action="Index" asp-route-archived="false">Active</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(ViewData["ActiveTab"]?.ToString() == "archived" ? "active" : "")"
           asp-action="Index" asp-route-archived="true">
            Archived
            @if (ViewData["numberofArchive"] is int numberOfArchive && numberOfArchive == 0)
            {
                <span>(0)</span>
            }
            else
            {
                <span>(@ViewData["numberofArchive"])</span>
            }
        </a>
    </li>
</ul>
<div class="d-flex justify-content-between align-items-start mb-1">
    

    <!-- Import Excel Button - Pop Up Modal Button -->
    <p>
        <button type="button" class="btn btn-primary btn-import-excel" data-bs-toggle="modal" data-bs-target="#importVolunteersExcelModal">
            Import from Excel
        </button>
    </p>
    <p>
        <a asp-action="ExportVolunteersToExcel" class="btn btn-success">
            <img src="~/Images/export-csv.png" alt="export-csv-icon" style="height: 24px; width: auto; margin-right: 10px" />
            Export to Excel
        </a>
        @* <a href="@Url.Action("ExportVolunteersToExcel", "Session")" class="btn btn-success"><img src="~/Images/export-csv.png" alt="export-csv-icon" style="height: 24px; width: auto; margin-right: 10px" />Export to Excel</a> *@
    </p>
</div>

<!-- Modal -->
<!-- Import Volunteers Excel Modal -->
<div class="modal fade" id="importVolunteersExcelModal" tabindex="-1" aria-labelledby="importVolunteersExcelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered import-excel-modal">
        <!-- Added custom class `import-excel-modal` -->
        <div class="modal-content import-excel-modal-content">
            <!-- Added custom class `import-excel-modal-content` -->
            <div class="modal-header bg-primary text-white imprt-excl-modal-header">
                <h5 class="modal-title" id="importVolunteersExcelModalLabel">Import Volunteers Excel File</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body h-100 import-excel-modal-body">
                <!-- Added custom class `import-excel-modal-body` -->
                <div class="row h-100">
                    <!-- Left Partition: Upload and Text Information -->
                    <div class="col-md-6 d-flex flex-column justify-content-between">
                        <div id="importVolunteersAlert" class="alert @(TempData["Feedback"] != null ? "alert-success" : "d-none") import-excel-alert">
                            <!-- Added custom class `import-excel-alert` -->
                            @Html.Raw(TempData["Feedback"])
                        </div>

                        <!-- Add the prompt above the drag-and-drop area -->
                        <div class="mb-3">
                            <p>
                                Make sure you're using the correct sample file. Don't have one?
                                <a href="@Url.Action("DownloadSampleExcel", "Volunteer")" download class="import-excel-download-link">Download</a> a sample Excel file.
                            </p>
                        </div>

                        <form asp-action="InsertVolunteersFromExcel" asp-controller="Volunteer" method="post" enctype="multipart/form-data" class="h-100 d-flex flex-column justify-content-between">
                            <div class="mb-3 flex-grow-1 d-flex flex-column justify-content-center">
                                <div id="dropArea" class="drop-area import-excel-drop-area flex-grow-1 d-flex align-items-center justify-content-center">
                                    <!-- Added custom class `import-excel-drop-area` -->
                                    <span class="drop-text import-excel-drop-text">
                                        <!-- Added custom class `import-excel-drop-text` -->
                                        <a href="#" id="browseLink" class="import-excel-browse-link">Browse your files</a>, or drag and drop here. Must be a CSV, XLS, or XLSX file.
                                    </span>
                                    <input type="file" class="form-control visually-hidden" name="theExcel" id="theExcel" accept=".csv, .xls, .xlsx" required>
                                </div>
                                <div class="invalid-feedback import-excel-invalid-feedback">Please select a valid Excel file.</div>
                                <!-- Added custom class `import-excel-invalid-feedback` -->
                            </div>
                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary import-excel-submit-btn">Upload Data</button>
                                <!-- Added custom class `import-excel-submit-btn` -->
                            </div>
                        </form>
                    </div>

                    <!-- Right Partition: Picture -->
                    <div class="col-md-6 d-flex align-items-center justify-content-center">
                        <div class="image-placeholder import-excel-image-placeholder h-100 w-100">
                            <!-- Added custom class `import-excel-image-placeholder` -->
                            <img src="~/Images/modalBackDrop1.png" alt="Placeholder Image" class="img-fluid h-100 w-100" style="object-fit: contain;">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ViewData["ActiveTab"]?.ToString() != "archived")
{
    <p class="mb-2">
        <a asp-action="Create" class="btn btn-primary"><img src="~/Images/add-user.png" alt="add-volunteer-icon" style="height: 24px; width: auto; margin-right: 10px" />Add Volunteer</a>
    </p>
}
<form asp-action="Index" method="get">
    <input type="hidden" name="sortDirection" value="@ViewData["sortDirection"]" />
    <input type="hidden" name="sortField" value="@ViewData["sortField"]" />
    <input type="hidden" name="archived" value="@(ViewData["ActiveTab"]?.ToString() == "archived" ? "true" : "false")" />
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @Html.Raw(TempData["Success"])
        </div>
    }
    <div class="row">
        <div class="col-10">
            <button class="btn mb-3 @ViewData["Filtering"]" type="button" data-bs-toggle="collapse" id="filterToggle"
                    data-bs-target="#collapseFilter" aria-expanded="false" aria-controls="collapseFilter" style="background-color: #6423e7; color: white">
                <img src="~/Images/filter-search.png" alt="filter-search-icon" style="height: 24px; width: auto; margin-right: 10px" />
                Filter/Search (@ViewData["numberFilters"])
            </button>

            @if (ViewData["numberFilters"] is int numberOfFilters && numberOfFilters > 0)
            {
                <a asp-action="Index" class="mb-3 btn btn-danger text-white">
                    <img src="~/Images/clear-icon.png" alt="Clear filters icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
                    Clear
                </a>
            }
        </div>
    </div>
    <div class="collapse mb-3 @ViewData["ShowFilter"]" id="collapseFilter">
        <div class="card card-body" style="background-color:lightgray">
            <div class="row">
                <div class="form-group col-md-3">
                    <label class="control-label">Search by Volunteer Name:</label>
                    @Html.TextBox("SearchString", null, new { @class = "form-control" })
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="control-label">Filter by City:</label>
                        @Html.DropDownList("SearchCity", ViewData["Cities"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>(), new { @class = "form-control" })
                    </div>
                </div>
                <div class="form-group col-md-3">
                    <label class="control-label">Search by Email:</label>
                    @Html.TextBox("SearchEmail", null, new { @class = "form-control" })
                </div>
            </div>
            <div class="form-group col-md-2 align-self-start">
                <input type="submit" name="actionButton" value="Filter"
                       class="btn text-white" style="background-color: #6423e7" />
            </div>
        </div>
    </div>
    <div class="table-responsive" style="margin: 0; padding: 0">
        <table class="table table-striped table-hover table-custom">
            <thead class="table-dark ">
                <tr>
                    <th>
                        <button style="font-weight: 700" type="button" class="btn btn-toolbar text-white d-inline" onclick="handleSort(event, 'FullName')">
                            Full Name
                            @if (ViewData["sortField"]?.ToString() == "FullName")
                            {
                                if (ViewData["sortDirection"]?.ToString() == "asc")
                                {
                                    <div style="position: relative; display: inline-block;">
                                        <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #737373;"></i>
                                        <i class="fa-solid fa-sort-up fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                    </div>
                                }
                                else
                                {
                                    <div style="position: relative; display: inline-block;">
                                        <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #737373;"></i>
                                        <i class="fa-solid fa-sort-down fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                    </div>
                                }
                            }
                            else
                            {
                                <i class="fas fa-sort fa-sm d-inline" style="color: #fff; margin-left: 2.7px"></i>
                            }
                        </button>
                    </th>

                    <th>
                        <button style="font-weight: 700" type="submit" name="actionButton" value="Email" class="btn btn-toolbar text-white d-inline" onclick="handleSort('Email')">
                            Email
                            @if (ViewData["sortField"]?.ToString() == "Email")
                            {
                                if (ViewData["sortDirection"]?.ToString() == "asc")
                                {
                                    <div style="position: relative; display: inline-block;">
                                        <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #737373;"></i>
                                        <i class="fa-solid fa-sort-up fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                    </div>
                                }
                                else
                                {
                                    <div style="position: relative; display: inline-block;">
                                        <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #737373;"></i>
                                        <i class="fa-solid fa-sort-down fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                    </div>
                                }
                            }
                            else
                            {
                                <i class="fas fa-sort fa-sm d-inline" style="color: #fff; margin-left: 2.7px"></i>
                            }
                        </button>
                    </th>
                    <th>
                        <button style="font-weight: 700" type="submit" name="actionButton" value="City" class="btn btn-toolbar text-white d-inline" onclick="handleSort(event, 'City')">
                            City
                            @if (ViewData["sortField"]?.ToString() == "City")
                            {
                                if (ViewData["sortDirection"]?.ToString() == "asc")
                                {
                                    <div style="position: relative; display: inline-block;">
                                        <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #737373;"></i>
                                        <i class="fa-solid fa-sort-up fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                    </div>
                                }
                                else
                                {
                                    <div style="position: relative; display: inline-block;">
                                        <i class="fas fa-sort fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px; top: -6px; color: #737373;"></i>
                                        <i class="fa-solid fa-sort-down fa-sm d-inline" style="margin: 0;position: absolute; left: 2.7px;top: -6px; color: #fff;"></i>
                                    </div>
                                }
                            }
                            else
                            {
                                <i class="fas fa-sort fa-sm d-inline" style="color: #fff; margin-left: 2.7px"></i>
                            }
                        </button>
                    </th>
                    <th>
                        <button style="font-weight: 700" type="button" name="actionButton" value="Actions" class="btn btn-toolbar text-white">Actions</button>
                    </th>
                </tr>
            </thead>
</form>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.FullName)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.Email)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.VolLocation.City)
                        </td>
                        <td>
                            <!-- Desktop View (Buttons) -->
                            <div class="d-none d-lg-inline">
                                <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning">
                                    <img src="~/Images/edit-value.png" alt="edit-icon" style="height: 24px; width: auto; margin-right: 10px" />Edit
                                </a> |
                                <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info">
                                    <img src="~/Images/details.png" alt="details-icon" style="height: 24px; width: auto; margin-right: 10px" />Details
                                </a> |
                                <div class="btn-group">
                                    @if (!item.IsArchived)
                                    {
                                        <form asp-action="Archive" method="post" onsubmit="return confirm('Are you sure you want to archive this item?');" class="d-inline">
                                            <input type="hidden" name="id" value="@item.ID" />
                                            <button type="submit" class="btn btn-sm btn-danger" style="color:black; background-color:#fb606f;">
                                                <img src="~/Images/Archive.png" alt="Archive-icon" style="height: 24px; width: auto; margin-right: 10px;" />
                                                Archive
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Unarchive" method="post" onsubmit="return confirm('Are you sure you want to restore this item?');" class="d-inline">
                                            <input type="hidden" name="id" value="@item.ID" />
                                            <button type="submit" class="btn btn-sm btn-danger" style="color:black; background-color:#4CAF50 ;">
                                                <img src="~/Images/unarchive.png" alt="Archive-icon" style="height: 24px; width: auto; margin-right: 10px;" />
                                                Restore
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>

                            <!-- Mobile View (Dropdown) -->
                            <div class="d-lg-none">
                                <div class="btn-group">
                                    <button class="btn btn-sm dropdown-toggle" style="background-color: #6423e7; color: white" data-bs-toggle="dropdown">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.ID">
                                                <img src="~/Images/edit-value.png" alt="edit-icon" style="height: 18px; width: auto; margin-right: 5px" /> Edit
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-action="Details" asp-route-id="@item.ID">
                                                <img src="~/Images/details.png" alt="details-icon" style="height: 18px; width: auto; margin-right: 5px" /> Details
                                            </a>
                                        </li>
                                        <li>
                                            @if (!item.IsArchived)
                                            {
                                                <form asp-action="Archive" method="post" onsubmit="return confirm('Are you sure you want to archive this item?');">
                                                    <input type="hidden" name="id" value="@item.ID" />
                                                    <button type="submit" class="dropdown-item">
                                                        <img src="~/Images/Archive.png" alt="Archive-icon" style="height: 18px; width: auto; margin-right: 5px" /> Archive
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Unarchive" method="post" onsubmit="return confirm('Are you sure you want to restore this item?');">
                                                    <input type="hidden" name="id" value="@item.ID" />
                                                    <button type="submit" class="dropdown-item">
                                                        <img src="~/Images/Archive.png" alt="Archive-icon" style="height: 18px; width: auto; margin-right: 5px" /> Restore
                                                    </button>
                                                </form>
                                            }
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

<partial name="_PagingNavBar" />

@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: '@TempData["SuccessMessage"]',
                confirmButtonText: 'OK'
            });
        });
    </script>
}

<!-- Sorting and JS Script -->
<script>
    function handleSort(event, field) {
        event.preventDefault();
        const form = event.target.closest('form');
        const sortField = form.querySelector('input[name="sortField"]');
        const sortDirection = form.querySelector('input[name="sortDirection"]');

        if (sortField.value === field) {
            // Toggle sort direction
            sortDirection.value = sortDirection.value === "asc" ? "desc" : "asc";
        } else {
            // Set new field and default to ascending order
            sortField.value = field;
            sortDirection.value = "asc";
        }

        // Submit the form
        form.submit();
    }
</script>

<!-- POP UP MODAL SCRIPT -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const dropArea = document.getElementById('dropArea'); // No change needed
        const fileInput = document.getElementById('theExcel'); // No change needed
        const browseLink = document.getElementById('browseLink'); // No change needed

        // Make the entire drop area clickable
        dropArea.addEventListener('click', () => {
            fileInput.click();
        });

        // Drag and drop functionality
        dropArea.addEventListener('dragover', (event) => {
            event.preventDefault();
            dropArea.classList.add('dragover');
        });

        dropArea.addEventListener('dragleave', () => {
            dropArea.classList.remove('dragover');
        });

        dropArea.addEventListener('drop', (event) => {
            event.preventDefault();
            dropArea.classList.remove('dragover');
            fileInput.files = event.dataTransfer.files;
            updateDropText();
        });

        // Update drop area text when a file is selected
        fileInput.addEventListener('change', () => {
            updateDropText();
        });

        function updateDropText() {
            if (fileInput.files.length > 0) {
                dropArea.querySelector('.import-excel-drop-text').textContent = fileInput.files[0].name; // Updated class
            }
        }

        // Handle form submission
        const form = document.querySelector('form'); // Select the form element
        form.addEventListener('submit', function (e) {
            e.preventDefault(); // Prevent the default form submission

            var alertDiv = document.getElementById('importVolunteersAlert'); // Updated ID

            if (fileInput.files.length === 0) {
                fileInput.classList.add("is-invalid");
                alertDiv.classList.remove("d-none", "alert-success");
                alertDiv.classList.add("alert-danger");
                alertDiv.innerHTML = "Please select a valid Excel file.";
                return;
            } else {
                fileInput.classList.remove("is-invalid");
            }

            var formData = new FormData(form);

            $.ajax({
                url: form.action,  // Use the form's action URL
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.success) {
                        // Show success alert in a separate pop-up window
                        alert("Upload process completed successfully!");
                        // Close the modal after successful upload
                        $('#importVolunteersExcelModal').modal('hide'); // Updated modal ID
                        // Optionally, reload the page or update the UI as needed
                        setTimeout(() => location.reload(), 2000); // Reload page after success
                    } else {
                        // Keep the modal open and display the error message
                        alertDiv.classList.remove("d-none", "alert-success");
                        alertDiv.classList.add("alert-danger");
                        alertDiv.innerHTML = response.message;
                    }
                },
                error: function (xhr, status, error) {
                    // Keep the modal open and display the error message
                    alertDiv.classList.remove("d-none", "alert-success");
                    alertDiv.classList.add("alert-danger");
                    alertDiv.innerHTML = "An error occurred while uploading the file: " + error;
                }
            });
        });
    });
</script>