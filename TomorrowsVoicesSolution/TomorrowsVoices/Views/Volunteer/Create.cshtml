@model TomorrowsVoices.Models.Volunteer

@{
    ViewData["Title"] = "Create";
}

<h1>Add Volunteer</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <p class="mb-4" style="font-weight: 700">Fields marked <span style="color: red">*</span> are required.</p>
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="FirstName" class="control-label" style=" font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="FirstName" class="form-control" id="FirstName" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName" class="control-label" style=" font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="LastName" class="form-control" id="LastName" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="control-label" style=" font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="Email" class="form-control" id="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Phone" class="control-label" style=" font-weight: 700"></label><span style="color: red">*</span>
                <input asp-for="Phone" class="form-control" id="Phone" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="VolLocationID" class="control-label" style=" font-weight: 700">Location</label><span style="color: red">*</span>
                <select asp-for="VolLocationID" class="form-control" asp-items="ViewBag.VolLocationID" id="VolLocationID"></select>
            </div>

            <div class="form-group">
                <button type="submit" id="btnSubmit" class="btn btn-primary">
                    <img src="~/Images/create-icon.png" alt="Create icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
                    Create
                </button>
                <button type="button" id="btnPreset" class="btn btn-secondary" onclick="fillPresetValues()" style="background-color: navy;">
                    <img src="~/Images/create-icon.png" alt="Preset icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />
                    Preset Fill Value
                </button>
            </div>

            <div class="form-group">
                <a asp-action="Index" class="btn btn-secondary" style="margin-bottom: 100px"><img src="~/Images/previous-page-icon.png" alt="go to previous page icon" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Back to Volunteers Page</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function fillPresetValues() {
            document.getElementById('FirstName').value = 'Radin';
            document.getElementById('LastName').value = 'Shahravan';
            document.getElementById('Email').value = 'rshahravan@example.com';
            document.getElementById('Phone').value = '1234567890';
            document.getElementById('VolLocationID').value = '1'; // Set to the appropriate default location ID
        }
    </script>
}