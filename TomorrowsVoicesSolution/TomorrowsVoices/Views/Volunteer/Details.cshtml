@model TomorrowsVoices.Models.Volunteer

@{
    ViewData["Title"] = "Volunteer Details";
}

<h1 class="pt-5">Volunteer Details</h1>
<hr />
<div>
    <h2>@Model.FullName</h2>
    <p class="compact-paragraph"><strong>Email:</strong> @Model.Email</p>
    <p class="compact-paragraph"><strong>Phone:</strong> @Model.FormattedPhone</p>
    <p class="compact-paragraph"><strong>City:</strong> @Model.VolLocation?.City</p>
  
</div>
<br />


<p>
    <div class="mb-3">
        @if (!Model.IsArchived)
        {
            <a asp-action="Edit" asp-route-id="@Model?.ID" class="btn btn-warning" style="width: 188px;" title="Edit this volunteer">
                <img src="~/Images/icons8-edit-48 (1).png" alt="Edit Values" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Edit
            </a>
        }
        else
        {
            <button class="btn btn-warning" disabled title="Archived Directors cannot be edited." style="width: auto;">
                <img src="~/Images/edit-value.png" alt="Edit Values" style="height: 20px; width: auto; margin-bottom: 3px; margin-left: -4px; margin-right: 6px" />Edit
            </button>
        }
    </div>
    <a asp-action="Index" class="btn btn-secondary" style="margin-bottom: 100px; width: auto;" title="Go back to Volunteers Index Page">
        <i class="bi bi-arrow-left"></i> Back to Volunteers
    </a>
</p>



